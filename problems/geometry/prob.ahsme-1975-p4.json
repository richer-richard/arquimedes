  "solutions": [
    {
      "id": "sol.ahsme-1975-p4.live",
      "kind": "proof-sketch",
      "text": "Let the first square have side \\(s.\\) The second has diagonal \\(s,\\) so its side is \\(\\frac{s}{\\sqrt2}\\) and its area is \\(\\frac{s^2}{2}.\\) The ratio is \\(\\frac{s^2}{\\frac{s^2}{2}}=2.\\)\n\nTherefore, the correct answer is A.",
      "hints": [
        "If the first side is \\(s,\\) then the second square has diagonal \\(s\\)",
        "A square with diagonal \\(s\\) has area \\(\\frac{s^2}{2}\\)"
      ],
      "images": []
    }
  ],
