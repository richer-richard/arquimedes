  "solutions": [
    {
      "id": "sol.ahsme-1984-p15.live",
      "kind": "proof-sketch",
      "text": "The equation is equivalent to \\[ \\begin{aligned} &\\cos2x\\cos3x\\\\ &\\quad-\\sin2x\\sin3x\\\\ &=\\cos5x=0. \\end{aligned} \\] Therefore \\(5x=90^\\circ+180^\\circ k.\\) Taking \\(k=0\\) gives \\(x=18^\\circ,\\) the listed value.\n\nTherefore, the correct answer is A.",
      "hints": [
        "Move all terms to one side and recognize a cosine addition identity",
        "Use \\(\\cos2x\\cos3x-\\sin2x\\sin3x\\) \\(=\\cos5x\\)"
      ],
