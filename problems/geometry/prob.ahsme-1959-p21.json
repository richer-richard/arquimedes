  "estimatedMinutes": 1,
  "statement": "If \\(p\\) is the perimeter of an equilateral triangle inscribed in a circle, the area of the circle is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{\\pi p^2}{3}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{\\pi p^2}{9}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{\\pi p^2}{27}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{\\pi p^2}{81}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{\\pi p^2\\sqrt3}{27}\\)"
    }
  ],
  "answer": {
    "letter": "c",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1959-p21.live",
      "kind": "proof-sketch",
      "text": "The side length is \\(\\frac{p}{3},\\) so the circumradius is \\[ R=\\frac{\\frac{p}{3}}{\\sqrt3}=\\frac{p}{3\\sqrt3}. \\] Therefore the circle’s area is \\[ \\pi R^2=\\frac{\\pi p^2}{27}. \\]\n\nThus, the correct answer is C.",
      "hints": [
        "The triangle side length is \\(\\frac{p}{3}\\)",
        "An equilateral triangle with side \\(s\\) has circumradius \\(\\frac{s}{\\sqrt3}\\)"
      ],
      "images": []
    }
  ],
