  "solutions": [
    {
      "id": "sol.ahsme-1957-p23.live",
      "kind": "proof-sketch",
      "text": "At an intersection, \\[ 10-x^2=10-x, \\] so \\(x=0\\) or \\(x=1.\\) The points are \\((0,10)\\) and \\((1,9).\\) Their distance is \\[ \\sqrt{(1-0)^2+(9-10)^2}=\\sqrt2. \\]\n\nTherefore, the correct answer is C.",
      "hints": [
        "Set the two expressions for \\(y\\) equal",
        "The resulting equation is \\(x^2=x\\)"
      ],
