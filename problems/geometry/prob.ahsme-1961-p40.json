  "solutions": [
    {
      "id": "sol.ahsme-1961-p40.live",
      "kind": "proof-sketch",
      "text": "By Cauchy-Schwarz, \\[ \\begin{aligned} 60&=5x+12y\\\\ &\\le\\sqrt{5^2+12^2}\\\\ &\\qquad\\cdot\\sqrt{x^2+y^2}\\\\ &=13\\sqrt{x^2+y^2}. \\end{aligned} \\] Thus the distance is at least \\(\\frac{60}{13}.\\) Equality occurs when \\((x,y)\\) is proportional to \\((5,12),\\) so the minimum is \\(\\frac{60}{13}.\\)\n\nTherefore, the correct answer is A.",
      "hints": [
        "Interpret \\(\\sqrt{x^2+y^2}\\) as distance from the origin",
        "Apply Cauchy-Schwarz to \\(5x+12y\\)"
      ],
      "images": []
    }
  ],
