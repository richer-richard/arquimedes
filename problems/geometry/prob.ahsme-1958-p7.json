  "solutions": [
    {
      "id": "sol.ahsme-1958-p7.live",
      "kind": "proof-sketch",
      "text": "The slope is \\[ \\frac{9-1}{3-(-1)}=2. \\] Using \\((-1,1),\\) the line is \\(y=2x+3.\\) Setting \\(y=0\\) gives \\[ x=-\\frac32. \\]\n\nThus, the correct answer is A.",
      "hints": [
        "First find the slope through the two given points",
        "Use one point to write the line equation, then set \\(y=0\\)"
      ],
