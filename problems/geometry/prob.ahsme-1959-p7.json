    {
      "label": "A",
      "text": "\\(1{:}3\\)"
    },
    {
      "label": "B",
      "text": "\\(1{:}4\\)"
    },
    {
      "label": "C",
      "text": "\\(2{:}1\\)"
    },
    {
      "label": "D",
      "text": "\\(3{:}1\\)"
    },
    {
      "label": "E",
      "text": "\\(3{:}4\\)"
    }
  ],
