  "solutions": [
    {
      "id": "sol.ahsme-1959-p7.live",
      "kind": "proof-sketch",
      "text": "The Pythagorean theorem gives \\[ a^2+(a+d)^2=(a+2d)^2. \\] Simplifying, \\[ \\begin{aligned} a^2-2ad-3d^2 &=0,\\\\ (a-3d)(a+d) &=0. \\end{aligned} \\] Positivity excludes \\(a=-d,\\) so \\(a=3d.\\)\n\nThus the ratio is \\(3:1,\\) and the correct answer is D.",
      "hints": [
        "The longest side \\(a+2d\\) must be the hypotenuse",
        "Apply the Pythagorean theorem and factor the resulting quadratic in \\(\\frac{a}{d}\\)"
      ],
      "images": []
    }
  ],
