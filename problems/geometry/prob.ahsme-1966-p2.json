  "estimatedMinutes": 1,
  "statement": "When the base of a triangle is increased \\(10\\%\\) and the altitude to this base is decreased \\(10\\%,\\) the change in area is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(1\\%\\) increase"
    },
    {
