  "estimatedMinutes": 2,
  "statement": "If \\[\\sum_{n=0}^{\\infty} \\cos^{2n} \\theta = 5,\\] what is the value of \\(\\cos 2\\theta?\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{1}{5}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{2}{5}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{\\sqrt{5}}{5}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{3}{5}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{4}{5}\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": "3/5"
  },
  "solutions": [
    {
      "id": "sol.amc-12a-2004-p21.live",
      "kind": "proof-sketch",
      "text": "The series is geometric with first term \\(1\\) and ratio \\(\\cos^2 \\theta,\\) so its sum is \\(\\dfrac{1}{1 - \\cos^2 \\theta} = \\dfrac{1}{\\sin^2 \\theta} = 5.\\)\n\nThus \\(\\sin^2 \\theta = \\tfrac15,\\) and \\[ \\begin{aligned} \\cos 2\\theta &= 1 - 2\\sin^2 \\theta \\\\ &= 1 - \\tfrac25 = \\tfrac35. \\end{aligned} \\]\n\nThus, the correct answer is D.",
      "hints": [
        "The series is geometric with ratio \\(\\cos^2 \\theta\\)",
        "Sum to get \\(\\dfrac{1}{\\sin^2 \\theta} = 5,\\) then use \\(\\cos 2\\theta = 1 - 2\\sin^2 \\theta\\)"
      ],
      "images": []
    }
  ],
