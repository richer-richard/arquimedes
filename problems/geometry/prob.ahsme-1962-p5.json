  "solutions": [
    {
      "id": "sol.ahsme-1962-p5.live",
      "kind": "proof-sketch",
      "text": "For every circle, regardless of its radius, the circumference divided by the diameter is \\[ \\frac{2\\pi R}{2R}=\\pi. \\]\n\nThus, the correct answer is C.",
      "hints": [
        "Call the new radius \\(R\\)",
        "Divide the circumference \\(2\\pi R\\) by the diameter \\(2R\\)"
      ],
