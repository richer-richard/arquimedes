  "statement": "If the radius of a circle is increased by \\(1\\) unit, the ratio of the new circumference to the new diameter is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\pi+2\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{2\\pi+1}{2}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\pi\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{2\\pi-1}{2}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\pi-2\\)"
    }
  ],
  "answer": {
