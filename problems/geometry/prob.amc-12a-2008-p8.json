    {
      "id": "sol.amc-12a-2008-p8.live",
      "kind": "proof-sketch",
      "text": "The cube with volume \\(1\\) has side \\(1\\) and surface area \\(6.\\) The larger cube has surface area \\(12,\\) so if its side is \\(s,\\) then \\(6s^2 = 12,\\) giving \\(s = \\sqrt{2}.\\)\n\nIts volume is \\[ (\\sqrt{2})^3 = 2\\sqrt{2}. \\]\n\nThus, C is the correct answer.",
      "hints": [
        "A cube with volume \\(1\\) has surface area \\(6\\)",
        "If the larger cube has side \\(s,\\) then \\(6s^2 = 12\\)"
      ],
      "images": []
    }
