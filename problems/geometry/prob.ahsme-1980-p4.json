  "solutions": [
    {
      "id": "sol.ahsme-1980-p4.live",
      "kind": "proof-sketch",
      "text": "At \\(D,\\) the two square angles are \\(90^\\circ\\) each and the equilateral-triangle angle is \\(60^\\circ.\\) Hence \\[ \\begin{aligned} \\angle GDA &=360^\\circ-90^\\circ\\\\ &\\quad-60^\\circ-90^\\circ\\\\ &=120^\\circ. \\end{aligned} \\]\n\nTherefore, the correct answer is C.",
      "hints": [
        "Identify the three known angles at \\(D\\)",
        "Use the full \\(360^\\circ\\) angle around point \\(D\\)"
      ],
