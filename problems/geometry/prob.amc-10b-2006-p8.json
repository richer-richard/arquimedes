  "estimatedMinutes": 1,
  "statement": "A square of area \\(40\\) is inscribed in a semicircle as shown. What is the area of the semicircle?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(20\\pi\\)"
    },
    {
      "label": "B",
      "text": "\\(25\\pi\\)"
    },
    {
      "label": "C",
      "text": "\\(30\\pi\\)"
    },
    {
      "label": "D",
      "text": "\\(40\\pi\\)"
    },
    {
      "label": "E",
      "text": "\\(50\\pi\\)"
    }
  ],
  "answer": {
    "letter": "b",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.amc-10b-2006-p8.live",
      "kind": "proof-sketch",
      "text": "Let the square have side \\(s,\\) so \\(s^2=40.\\) Its base lies centered on the diameter, and a top corner at \\(\\left(\\tfrac{s}{2},s\\right)\\) lies on the circle.\n\nThen \\(r^2=\\left(\\tfrac{s}{2}\\right)^2+s^2=\\tfrac{40}{4}+40=50.\\) The semicircle area is \\(\\tfrac12\\pi r^2=\\tfrac12\\pi(50)=25\\pi.\\)\n\nThus, the correct answer is B.",
      "hints": [
        "Let the square have side \\(s\\) with \\(s^2=40,\\) base centered on the diameter",
        "The radius satisfies \\(r^2=\\left(\\tfrac{s}{2}\\right)^2+s^2\\)"
      ],
      "images": []
    }
