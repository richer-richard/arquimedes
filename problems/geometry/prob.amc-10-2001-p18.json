  "solutions": [
    {
      "id": "sol.amc-10-2001-p18.live",
      "kind": "proof-sketch",
      "text": "Consider a repeating \\(3\\times3\\) block of nine small squares. Four of these nine squares are not part of the pentagons, so the pentagons cover \\(1-\\dfrac49=\\dfrac59\\approx55.6\\%\\) of the area.\n\nThis is closest to \\(56.\\) Thus, the correct answer is D.",
      "hints": [
        "Work within a repeating \\(3\\times3\\) block of small squares",
        "Of the \\(9\\) small squares, \\(4\\) lie outside the pentagons"
      ],
