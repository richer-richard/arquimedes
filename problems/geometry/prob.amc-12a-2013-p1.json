  "estimatedMinutes": 1,
  "statement": "Square \\(ABCD\\) has side length \\(10.\\) Point \\(E\\) is on \\(\\overline{BC},\\) and the area of \\(\\triangle ABE\\) is \\(40.\\) What is \\(BE?\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(4\\)"
    },
    {
      "label": "B",
      "text": "\\(5\\)"
    },
    {
      "label": "C",
      "text": "\\(6\\)"
    },
    {
      "label": "D",
      "text": "\\(7\\)"
    },
    {
      "label": "E",
      "text": "\\(8\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": "8"
