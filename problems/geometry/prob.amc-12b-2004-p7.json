  "estimatedMinutes": 1,
  "statement": "A square has sides of length \\(10,\\) and a circle centered at one of its vertices has radius \\(10.\\) What is the area of the union of the regions enclosed by the square and the circle?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(200 + 25\\pi\\)"
    },
    {
      "label": "B",
      "text": "\\(100 + 75\\pi\\)"
    },
    {
      "label": "C",
      "text": "\\(75 + 100\\pi\\)"
    },
    {
      "label": "D",
      "text": "\\(100 + 100\\pi\\)"
    },
    {
      "label": "E",
      "text": "\\(100 + 125\\pi\\)"
    }
  ],
  "answer": {
    "letter": "b",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.amc-12b-2004-p7.live",
      "kind": "proof-sketch",
      "text": "The square has area \\(100\\) and the circle has area \\(100\\pi.\\) Their overlap is the quarter of the circle lying inside the square, with area \\(25\\pi.\\) The union is \\(100 + 100\\pi - 25\\pi = 100 + 75\\pi.\\)\n\nThus, the correct answer is B.",
      "hints": [
        "The overlap of the square and circle is a quarter of the circle",
        "Union \\(= [\\text{square}]\\) \\(+ [\\text{circle}]\\) \\(- [\\text{quarter circle}]\\)"
      ],
      "images": []
    }
  ],
