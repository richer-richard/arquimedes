  "solutions": [
    {
      "id": "sol.ahsme-1979-p3.live",
      "kind": "proof-sketch",
      "text": "The square and equilateral triangle give \\(DA=AB=AE.\\) Also \\[ \\begin{aligned} \\angle DAE &=\\angle DAB+\\angle BAE\\\\ &=90^\\circ+60^\\circ\\\\ &=150^\\circ. \\end{aligned} \\] Thus \\(\\triangle DAE\\) is isosceles, and each base angle is \\(\\frac{180^\\circ-150^\\circ}{2}=15^\\circ.\\)\n\nTherefore, the correct answer is C.",
      "hints": [
        "Compare \\(DA,\\) \\(AB,\\) and \\(AE\\)",
        "Find \\(\\angle DAE\\), then use the base angles of isosceles \\(\\triangle DAE\\)"
      ],
      "images": []
    }
