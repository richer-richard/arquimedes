  "solutions": [
    {
      "id": "sol.ahsme-1981-p2.live",
      "kind": "proof-sketch",
      "text": "Let the square’s side length be \\(s.\\) In right triangle \\(EBC,\\) \\[ s^2+1^2=2^2. \\] Hence \\(s^2=3,\\) which is exactly the area of the square.\n\nTherefore, the correct answer is C.",
      "hints": [
        "Triangle \\(EBC\\) is a right triangle",
        "The unknown leg \\(BC\\) is also the side length of the square"
      ],
