  "solutions": [
    {
      "id": "sol.ahsme-1958-p27.live",
      "kind": "proof-sketch",
      "text": "The slope through the first two points is \\[ \\frac{3-(-3)}{4-2}=3. \\] Thus \\[ \\frac{\\frac{k}{2}-3}{5-4}=3, \\] which gives \\(\\frac{k}{2}=6\\) and \\(k=12.\\)\n\nTherefore, the correct answer is A.",
      "hints": [
        "Compute the slope through the first two points",
        "Equate that slope to the slope from \\((4,3)\\) to \\((5,\\frac{k}{2})\\)"
      ],
