  "solutions": [
    {
      "id": "sol.amc-10a-2003-p7.live",
      "kind": "proof-sketch",
      "text": "The longest side cannot exceed \\(3,\\) since otherwise the other two sides could not reach it.\n\nThe only possibilities are side lengths \\(1,\\) \\(3,\\) \\(3\\) and \\(2,\\) \\(2,\\) \\(3,\\) giving \\(2\\) triangles.\n\nThus, the correct answer is B.",
      "hints": [
        "The three sides are positive integers summing to \\(7\\)",
        "The longest side must be less than \\(3.5,\\) so it is at most \\(3\\)"
      ],
