  "estimatedMinutes": 1,
  "statement": "A square with side length \\(8\\) is cut in half, creating two congruent rectangles. What are the dimensions of one of these rectangles?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(2 \\text{ by } 4\\)"
    },
    {
      "label": "B",
      "text": "\\(2 \\text{ by } 6\\)"
    },
    {
      "label": "C",
      "text": "\\(2 \\text{ by } 8\\)"
    },
    {
      "label": "D",
      "text": "\\(4 \\text{ by } 4\\)"
    },
    {
      "label": "E",
      "text": "\\(4 \\text{ by } 8\\)"
    }
  ],
  "answer": {
