  "solutions": [
    {
      "id": "sol.ahsme-1979-p8.live",
      "kind": "proof-sketch",
      "text": "The two rays meet the circle at angles \\(45^\\circ\\) and \\(135^\\circ,\\) so the smallest bounded region is a \\(90^\\circ\\) sector of the radius-\\(2\\) circle. Its area is \\[ \\frac{90^\\circ}{360^\\circ}\\pi(2)^2=\\pi. \\]\n\nTherefore, the correct answer is C.",
      "hints": [
        "The two rays of \\(y=|x|\\) meet at the center of the circle",
        "Find the smaller central angle between the rays \\(y=x\\) and \\(y=-x\\)"
      ],
