  "estimatedMinutes": 1,
  "statement": "A square and a circle have equal perimeters. The ratio of the area of the circle to the area of the square is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\frac{4}{\\pi}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\frac{\\pi}{\\sqrt2}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\frac{4}{1}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\frac{\\sqrt2}{\\pi}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\frac{\\pi}{4}\\)"
    }
  ],
  "answer": {
    "letter": "a",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1970-p2.live",
      "kind": "proof-sketch",
      "text": "If the common perimeter is \\(p,\\) then the circle has radius \\(\\frac{p}{2\\pi}\\) and the square has side \\(\\frac{p}{4}.\\) Therefore \\[ \\frac{\\pi\\left(\\frac{p}{2\\pi}\\right)^2}{\\left(\\frac p4\\right)^2} =\\frac{\\frac{p^2}{4\\pi}}{\\frac{p^2}{16}}=\\frac4\\pi. \\]\n\nTherefore, the correct answer is A.",
      "hints": [
        "Let the common perimeter be \\(p\\)",
        "Express the circle radius and square side in terms of \\(p\\), then divide their areas"
      ],
      "images": []
    }
  ],
