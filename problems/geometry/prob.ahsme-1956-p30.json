  "estimatedMinutes": 1,
  "statement": "If the altitude of an equilateral triangle is \\(\\sqrt6,\\) then the area is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(2\\sqrt2\\)"
    },
    {
