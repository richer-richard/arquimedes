  "solutions": [
    {
      "id": "sol.ahsme-1961-p10.live",
      "kind": "proof-sketch",
      "text": "In the equilateral triangle, \\(BD=6\\) and \\(AD=6\\sqrt3.\\) Hence \\(DE=3\\sqrt3,\\) and right triangle \\(BDE\\) gives \\[ \\begin{aligned} BE^2&=6^2+(3\\sqrt3)^2\\\\ &=36+27=63. \\end{aligned} \\] Therefore \\(BE=\\sqrt{63}.\\)\n\nThus, the correct answer is D.",
      "hints": [
        "In the equilateral triangle, find \\(BD\\) and \\(AD\\)",
        "Use right triangle \\(BDE\\) after halving \\(AD\\)"
      ],
      "images": []
    }
  ],
