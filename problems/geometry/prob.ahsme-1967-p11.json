  "solutions": [
    {
      "id": "sol.ahsme-1967-p11.live",
      "kind": "proof-sketch",
      "text": "Let adjacent sides be \\(x\\) and \\(10-x.\\) Then \\[ \\begin{aligned} AC^2&=x^2+(10-x)^2\\\\ &=2(x-5)^2+50. \\end{aligned} \\] This is minimized at \\(x=5,\\) giving \\(AC=\\sqrt{50}.\\)\n\nTherefore, the correct answer is B.",
      "hints": [
        "If adjacent sides are \\(x\\) and \\(10-x,\\) square the diagonal",
        "Complete the square in \\(x^2+(10-x)^2\\)"
      ],
