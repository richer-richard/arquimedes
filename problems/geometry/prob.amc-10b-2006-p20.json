  "solutions": [
    {
      "id": "sol.amc-10b-2006-p20.live",
      "kind": "proof-sketch",
      "text": "The slope of \\(\\overline{AB}\\) is \\(\\tfrac{178-(-22)}{2006-6}=\\tfrac{200}{2000}=\\tfrac1{10}.\\) Since \\(\\overline{AD}\\perp\\overline{AB},\\) its slope is \\(-10,\\) so \\(\\tfrac{y+22}{8-6}=-10\\) gives \\(y=-42.\\)\n\nThen \\(AB=\\sqrt{2000^2+200^2}\\) \\(=200\\sqrt{101}\\) and \\(AD=\\sqrt{2^2+20^2}=2\\sqrt{101}.\\)\n\nThe area is \\(200\\sqrt{101}\\cdot2\\sqrt{101}\\) \\(=400\\cdot101\\) \\(=40{,}400.\\)\n\nThus, the correct answer is E.",
      "hints": [
        "\\(\\overline{AB}\\perp\\overline{AD},\\) so their slopes multiply to \\(-1\\)",
        "The area is \\(AB\\cdot AD\\)"
      ],
      "images": []
    }
  ],
