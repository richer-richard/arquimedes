  "estimatedMinutes": 1,
  "statement": "Four identical squares and one rectangle are placed together to form one large square as shown. The length of the rectangle is how many times as large as its width?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{5}{4}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{4}{3}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{3}{2}\\)"
    },
    {
      "label": "D",
      "text": "\\(2\\)"
    },
    {
      "label": "E",
      "text": "\\(3\\)"
    }
  ],
  "answer": {
    "letter": "b",
    "value": "4/3"
  },
  "solutions": [
    {
      "id": "sol.amc-10a-2010-p2.live",
      "kind": "proof-sketch",
      "text": "WLOG, let the side lengths of the squares be \\(1.\\)\n\nThis means that the length of the rectangle is \\(4.\\) We also have that the width must be \\(4 - 1 = 3.\\)\n\nThe desired ratio is then \\(\\dfrac{4}{3}.\\)\n\nThus, B is the correct answer.",
      "hints": [
        "Let each small square have side length \\(s\\)",
        "The rectangle is \\(4s\\) long and one small square shorter than the large square"
      ],
