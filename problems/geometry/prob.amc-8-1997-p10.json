  "solutions": [
    {
      "id": "sol.amc-8-1997-p10.live",
      "kind": "proof-sketch",
      "text": "We can split the square into \\(6^2 = 36\\) unit squares. The number of shaded small squares is \\[ 3 + 7 + 11 = 21. \\]\n\nThe fraction of the square that is shaded is \\[ \\dfrac{21}{36} = \\dfrac{7}{12}. \\]\n\nThus, C is the correct answer.",
      "hints": [
        "Count shaded small squares out of the total",
        "Divide the square into equal small squares matching the stripe widths"
      ],
