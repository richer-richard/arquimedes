  "estimatedMinutes": 1,
  "statement": "If \\(b\\gt1,\\) \\(\\sin x\\gt0,\\) \\(\\cos x\\gt0\\) and \\(\\log_b\\sin x=a,\\) then \\(\\log_b\\cos x\\) equals",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(2\\log_b(1-b^{\\frac{a}{2}})\\)"
    },
    {
      "label": "B",
      "text": "\\(\\sqrt{1-a^2}\\)"
    },
    {
      "label": "C",
      "text": "\\(b^{a^2}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\frac12\\log_b(1-b^{2a})\\)"
    },
    {
      "label": "E",
      "text": "none of these"
    }
  ],
  "answer": {
    "letter": "d",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1980-p18.live",
      "kind": "proof-sketch",
      "text": "We have \\(\\sin x=b^a,\\) so \\[ \\cos x=\\sqrt{1-b^{2a}}. \\] Therefore \\[ \\log_b\\cos x =\\frac12\\log_b(1-b^{2a}). \\]\n\nTherefore, the correct answer is D.",
      "hints": [
        "Convert \\(\\log_b\\sin x=a\\) into an exponential equation",
        "Use \\(\\cos x=\\sqrt{1-\\sin^2x}\\) and the positivity of \\(\\cos x\\)"
      ],
