  "solutions": [
    {
      "id": "sol.ahsme-1963-p4.live",
      "kind": "proof-sketch",
      "text": "Intersections satisfy \\(x^2-3x-k=0.\\) Two identical solutions require \\[(-3)^2-4(1)(-k)=9+4k=0,\\] giving \\(k=-\\frac{9}{4}.\\)\n\nTherefore, the correct answer is D.",
      "hints": [
        "Set the two expressions for \\(y\\) equal",
        "A repeated intersection makes the resulting quadratic’s discriminant zero"
      ],
