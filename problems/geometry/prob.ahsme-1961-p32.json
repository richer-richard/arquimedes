  "estimatedMinutes": 1,
  "statement": "A regular polygon of \\(n\\) sides is inscribed in a circle of radius \\(R.\\) The area of the polygon is \\(3R^2.\\) Then \\(n\\) equals:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(8\\)"
    },
    {
      "label": "B",
      "text": "\\(10\\)"
    },
    {
      "label": "C",
      "text": "\\(12\\)"
    },
    {
      "label": "D",
      "text": "\\(15\\)"
    },
    {
      "label": "E",
      "text": "\\(18\\)"
    }
  ],
  "answer": {
    "letter": "c",
    "value": "12"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1961-p32.live",
      "kind": "proof-sketch",
      "text": "The polygon’s area is \\[ \\frac n2R^2\\sin\\frac{360^\\circ}{n}. \\] For \\(n=12,\\) this becomes \\[ 6R^2\\sin30^\\circ=3R^2, \\] as required.\n\nTherefore, the correct answer is C.",
      "hints": [
        "Divide the polygon into \\(n\\) congruent triangles with vertex at the center",
        "Use area \\(\\frac12nR^2\\sin(\\frac{360^\\circ}{n})\\) and test the choices"
      ],
      "images": []
    }
  ],
