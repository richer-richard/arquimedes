  "estimatedMinutes": 2,
  "statement": "In a general triangle \\(ADE\\) (as shown), lines \\(EB\\) and \\(EC\\) are drawn. Which of the following angle relations is true?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(x+z=a+b\\)"
    },
    {
      "label": "B",
      "text": "\\(y+z=a+b\\)"
    },
    {
      "label": "C",
      "text": "\\(m+x=w+n\\)"
    },
    {
      "label": "D",
      "text": "\\(x+z+n=w+c+m\\)"
    },
    {
      "label": "E",
      "text": "\\(x+y+n=a+b+m\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1958-p29.live",
      "kind": "proof-sketch",
      "text": "Triangle \\(AEC\\) gives \\[ x+y+w+n=180^\\circ. \\] Triangle \\(BED\\) gives \\[ m+a+b+w=180^\\circ. \\] Equating the left sides and cancelling \\(w\\) yields \\[ x+y+n=a+b+m. \\]\n\nThus, the correct answer is E.",
      "hints": [
        "Write the angle sum in triangle \\(AEC\\)",
        "Write the angle sum in triangle \\(BED\\), then compare the two equations"
      ],
