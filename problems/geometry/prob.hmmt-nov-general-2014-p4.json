    "letter": null,
    "value": null
  },
  "solutions": [
    {
      "id": "sol.hmmt-nov-general-2014-p4.hmmt",
      "kind": "proof-sketch",
      "text": "\\(\\frac{1}{2}+\\frac{1}{2014}\\) OR \\(\\frac{504}{1007}\\) Notice that \\([A M X]+[B Y M]=\\frac{1}{2}[A B C D]=\\frac{1}{2}\\). Thus,\n\n\\[[A X Y B]=[A M X]+[B Y M]+[M X Y]=\\frac{1}{2}+\\frac{1}{2014}=\\frac{504}{1007}\\]",
