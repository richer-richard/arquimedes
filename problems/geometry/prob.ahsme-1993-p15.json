  "solutions": [
    {
      "id": "sol.ahsme-1993-p15.live",
      "kind": "proof-sketch",
      "text": "The interior angle is \\(180^\\circ-\\frac{360^\\circ}{n},\\) which is integral exactly when \\(360\\) is divisible by \\(n.\\) Since \\(360=2^3\\cdot3^2\\cdot5,\\) it has \\[ (3+1)(2+1)(1+1)=24 \\] positive divisors. Excluding \\(n=1\\) and \\(n=2\\) leaves \\(22\\) allowable values. Thus the correct answer is D.",
      "hints": [
        "An interior angle is \\(180^\\circ-\\frac{360^\\circ}{n}\\)",
        "Count divisors \\(n\\) of \\(360\\) and exclude values below \\(3\\)"
      ],
      "images": []
    }
  ],
