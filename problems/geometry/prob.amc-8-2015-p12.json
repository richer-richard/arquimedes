  "answer": {
    "letter": "c",
    "value": "18"
  },
  "solutions": [
    {
      "id": "sol.amc-8-2015-p12.live",
      "kind": "proof-sketch",
      "text": "A cube has \\(12\\) edges. For any edge, there are \\(3\\) other edges parallel to it.\n\nThis counts each pair twice, once from each edge in the pair, so the number of pairs of parallel edges is \\(\\dfrac{12\\cdot3}{2}=18.\\)\n\nThus, C is the correct answer.",
      "hints": [
        "Group cube edges by direction.",
        "Each edge is parallel to three other edges, but pair-counting double counts."
      ],
