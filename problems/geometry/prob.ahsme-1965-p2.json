  "estimatedMinutes": 1,
  "statement": "A regular hexagon is inscribed in a circle. The ratio of the length of a side of the hexagon to the length of the shorter of the arcs intercepted by the side is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(1:1\\)"
    },
    {
      "label": "B",
      "text": "\\(1:6\\)"
    },
    {
      "label": "C",
      "text": "\\(1:\\pi\\)"
    },
    {
      "label": "D",
      "text": "\\(3:\\pi\\)"
    },
    {
      "label": "E",
      "text": "\\(6:\\pi\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1965-p2.live",
      "kind": "proof-sketch",
      "text": "If the radius is \\(r,\\) the hexagon side is \\(r.\\) Its intercepted minor arc has length \\(\\frac{2\\pi r}{6}=\\frac{\\pi r}{3}.\\) The ratio is \\(r:(\\frac{\\pi r}{3})=3:\\pi.\\)\n\nTherefore, the correct answer is D.",
      "hints": [
        "Each side of an inscribed regular hexagon equals the circle’s radius",
        "The shorter arc is one sixth of the circumference"
      ],
      "images": []
    }
  ],
