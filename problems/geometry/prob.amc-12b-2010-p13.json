  "estimatedMinutes": 2,
  "statement": "In \\(\\triangle ABC,\\) \\(\\cos(2A-B)+\\sin(A+B)=2\\) and \\(AB=4.\\) What is \\(BC?\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\sqrt{2}\\)"
    },
