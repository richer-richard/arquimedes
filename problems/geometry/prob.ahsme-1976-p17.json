  "estimatedMinutes": 1,
  "statement": "If \\(\\theta\\) is an acute angle and \\(\\sin2\\theta=a,\\) then \\(\\sin\\theta+\\cos\\theta\\) equals",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\sqrt{a+1}\\)"
    },
    {
      "label": "B",
      "text": "\\((\\sqrt2-1)a+1\\)"
    },
    {
      "label": "C",
      "text": "\\(\\sqrt{a+1}-\\sqrt{a^2-a}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\sqrt{a+1}+\\sqrt{a^2-a}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\sqrt{a+1}+a^2-a\\)"
    }
  ],
  "answer": {
    "letter": "a",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1976-p17.live",
      "kind": "proof-sketch",
      "text": "We have \\[ \\begin{aligned} (\\sin\\theta+\\cos\\theta)^2 &=\\sin^2\\theta+\\cos^2\\theta\\\\ &\\quad+2\\sin\\theta\\cos\\theta\\\\ &=1+a. \\end{aligned} \\] Both sine and cosine are positive for acute \\(\\theta,\\) so the sum is \\(\\sqrt{a+1}.\\)\n\nTherefore, the correct answer is A.",
      "hints": [
        "Square the expression \\(\\sin\\theta+\\cos\\theta\\)",
        "Use \\(2\\sin\\theta\\cos\\theta=\\sin2\\theta\\) and the fact that the desired sum is positive"
      ],
      "images": []
    }
  ],
