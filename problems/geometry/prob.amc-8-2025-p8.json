  "solutions": [
    {
      "id": "sol.amc-8-2025-p8.live",
      "kind": "proof-sketch",
      "text": "There are \\(6\\) squares, so each has area \\(18 \\div 6 = 3.\\) Then the side length of the cube is \\(\\sqrt{3}.\\) The volume is \\(\\sqrt{3} \\times \\sqrt{3} \\times \\sqrt{3} = 3\\sqrt{3},\\) which is choice A.",
      "hints": [
        "A cube net has \\(6\\) congruent square faces",
        "Divide the net area by \\(6\\) to get one face area"
      ],
