  "estimatedMinutes": 1,
  "statement": "Isaiah cuts open a cardboard cube along some of its edges to form the flat shape shown, which has an area of \\(18\\) square centimeters. What was the volume of the cube in cubic centimeters?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(3\\sqrt{3}\\)"
    },
    {
      "label": "B",
      "text": "\\(6\\)"
    },
    {
      "label": "C",
      "text": "\\(9\\)"
    },
    {
      "label": "D",
      "text": "\\(6\\sqrt{3}\\)"
    },
    {
      "label": "E",
      "text": "\\(9\\sqrt{3}\\)"
    }
  ],
  "answer": {
    "letter": "a",
