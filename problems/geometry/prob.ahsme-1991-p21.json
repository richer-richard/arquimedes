    },
    {
      "label": "C",
      "text": "\\(\\tan^2\\theta\\)"
    },
    {
      "label": "D",
      "text": "\\(\\cot^2\\theta\\)"
    },
    {
      "label": "E",
      "text": "\\(\\csc^2\\theta\\)"
    }
  ],
