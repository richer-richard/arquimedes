  "solutions": [
    {
      "id": "sol.amc-10b-2003-p11.live",
      "kind": "proof-sketch",
      "text": "The lines are \\(y-15=3(x-10)\\) and \\(y-15=5(x-10).\\)\n\nSetting \\(y=0\\) gives \\(x\\)-intercepts \\(x=5\\) and \\(x=7.\\) The distance between \\((5,0)\\) and \\((7,0)\\) is \\(2.\\)\n\nThus, the correct answer is A.",
      "hints": [
        "Write each line in point-slope form through \\((10, 15)\\)",
        "Set \\(y=0\\) in each equation to find where they cross the \\(x\\)-axis"
      ],
