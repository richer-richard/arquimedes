  "estimatedMinutes": 2,
  "statement": "All lines with equation \\(ax+by=c\\) such that \\(a,\\) \\(b,\\) \\(c\\) form an arithmetic progression pass through a common point. What are the coordinates of that point?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\( (-1,2) \\)"
    },
    {
      "label": "B",
      "text": "\\( (0,1) \\)"
    },
    {
      "label": "C",
      "text": "\\( (1,-2) \\)"
    },
    {
      "label": "D",
      "text": "\\( (1,0) \\)"
    },
    {
      "label": "E",
      "text": "\\( (1,2) \\)"
    }
  ],
