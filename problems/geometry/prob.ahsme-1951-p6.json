  "estimatedMinutes": 1,
  "statement": "The bottom, side, and front areas of a rectangular box are known. The product of these areas is equal to:",
  "answerChoices": [
    {
      "label": "A",
      "text": "The volume of the box"
    },
    {
      "label": "B",
      "text": "The square root of the volume"
    },
    {
      "label": "C",
      "text": "Twice the volume"
    },
    {
      "label": "D",
      "text": "The square of the volume"
    },
    {
      "label": "E",
      "text": "The cube of the volume"
    }
  ],
  "answer": {
    "letter": "d",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1951-p6.live",
      "kind": "proof-sketch",
      "text": "If the edge lengths are \\(l,w,h,\\) the three face areas are \\(lw,\\) \\(wh,\\) and \\(hl.\\) Their product is \\[ (lw)(wh)(hl)=l^2w^2h^2=(lwh)^2, \\] the square of the volume.\n\nThus, the correct answer is D.",
      "hints": [
        "Call the three edge lengths \\(l,w,h\\)",
        "Multiply the three face areas \\(lw,\\) \\(wh,\\) and \\(hl\\)"
      ],
