  "estimatedMinutes": 2,
  "statement": "A \\(1 \\times 2\\) rectangle is inscribed in a semicircle with the longer side on the diameter. What is the area of the semicircle?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{\\pi}{2}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{2\\pi}{3}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\pi\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{4\\pi}{3}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{5\\pi}{3}\\)"
    }
  ],
  "answer": {
    "letter": "c",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.amc-8-2013-p20.live",
      "kind": "proof-sketch",
      "text": "Using the Pythagorean theorem, we get that the radius of the semicircle is \\(\\sqrt{2}.\\) This means that the area of the semicircle is \\[\\dfrac{1}{2} \\cdot \\pi \\cdot \\sqrt{2}^2 = \\pi.\\] Thus, C is the correct answer.",
      "hints": [
        "The radius goes from the midpoint of the diameter to a top corner of the rectangle.",
        "That radius is the hypotenuse of a \\(1\\) by \\(1\\) right triangle."
      ],
