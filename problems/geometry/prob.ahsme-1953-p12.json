  "estimatedMinutes": 1,
  "statement": "The diameters of two circles are \\(8\\) inches and \\(12\\) inches respectively. The ratio of the area of the smaller to the area of the larger circle is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac23\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac49\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac94\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac12\\)"
    },
    {
      "label": "E",
      "text": "none of these"
    }
  ],
  "answer": {
    "letter": "b",
    "value": "4/9"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1953-p12.live",
      "kind": "proof-sketch",
      "text": "The area ratio is the square of the diameter ratio: \\[ \\left(\\frac8{12}\\right)^2=\\left(\\frac23\\right)^2=\\frac49. \\]\n\nThus, the correct answer is B.",
      "hints": [
        "Circle areas scale as the squares of their diameters",
        "Square the diameter ratio \\(\\frac{8}{12}\\)"
      ],
