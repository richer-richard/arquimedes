  "estimatedMinutes": 1,
  "statement": "A square and a circle have the same area. What is the ratio of the side length of the square to the radius of the circle?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\( \\ \\dfrac{\\sqrt{\\pi}}{2} \\)"
    },
    {
      "label": "B",
      "text": "\\( \\ \\sqrt{\\pi} \\)"
    },
    {
      "label": "C",
      "text": "\\( \\ \\pi \\)"
    },
    {
      "label": "D",
      "text": "\\( \\ 2\\pi \\)"
    },
    {
      "label": "E",
      "text": "\\( \\ \\pi^{2} \\)"
    }
  ],
  "answer": {
    "letter": "b",
    "value": null
