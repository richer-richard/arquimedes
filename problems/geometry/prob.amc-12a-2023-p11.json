  "solutions": [
    {
      "id": "sol.amc-12a-2023-p11.live",
      "kind": "proof-sketch",
      "text": "The tangent of the angle between the lines is \\[ \\left|\\dfrac{2-\\tfrac13}{1+2\\cdot\\tfrac13}\\right| =\\left|\\dfrac{\\tfrac53}{\\tfrac53}\\right|=1. \\]\n\nThe acute angle with tangent \\(1\\) is \\(45^\\circ.\\)\n\nThus, the correct answer is C.",
      "hints": [
        "Use \\(\\tan\\theta=\\left|\\dfrac{m_1-m_2}{1+m_1m_2}\\right|\\)",
        "Both the numerator and denominator work out to \\(\\tfrac53\\)"
      ],
      "images": []
    }
  ],
