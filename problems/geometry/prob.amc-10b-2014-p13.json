  "estimatedMinutes": 2,
  "statement": "Six regular hexagons surround a regular hexagon of side length \\(1\\) as shown. What is the area of \\(\\triangle{ABC}?\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\( 2\\sqrt{3} \\)"
