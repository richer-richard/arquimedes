  "estimatedMinutes": 2,
  "statement": "Three circles with radius \\(2\\) are mutually tangent. What is the total area of the circles and the region bounded by them, as shown in the figure?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\( 10\\pi+4\\sqrt{3} \\)"
    },
    {
      "label": "B",
      "text": "\\( 13\\pi-\\sqrt{3} \\)"
    },
    {
      "label": "C",
      "text": "\\( 12\\pi+\\sqrt{3} \\)"
    },
    {
      "label": "D",
      "text": "\\( 10\\pi+9 \\)"
    },
    {
      "label": "E",
      "text": "\\( 13\\pi\\)"
    }
  ],
