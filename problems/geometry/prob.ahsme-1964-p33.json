  "solutions": [
    {
      "id": "sol.ahsme-1964-p33.live",
      "kind": "proof-sketch",
      "text": "For any point in a rectangle, the British flag theorem gives \\[PA^2+PC^2=PB^2+PD^2.\\] Thus \\(9+25=PB^2+16,\\) so \\(PB^2=18\\) and \\(PB=3\\sqrt2.\\)\n\nTherefore, the correct answer is B.",
      "hints": [
        "Use the rectangle identity \\(PA^2+PC^2=PB^2+PD^2\\)",
        "Substitute the three known distances and solve for \\(PB^2\\)"
      ],
