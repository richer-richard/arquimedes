  "estimatedMinutes": 1,
  "statement": "A triangle has angles of \\(30^\\circ\\) and \\(45^\\circ.\\) If the side opposite the \\(45^\\circ\\) angle has length \\(8,\\) then the side opposite the \\(30^\\circ\\) angle has length:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(4\\)"
    },
    {
      "label": "B",
      "text": "\\(4\\sqrt2\\)"
    },
    {
      "label": "C",
      "text": "\\(4\\sqrt3\\)"
    },
    {
      "label": "D",
      "text": "\\(4\\sqrt6\\)"
    },
    {
      "label": "E",
      "text": "\\(6\\)"
    }
  ],
  "answer": {
    "letter": "b",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1972-p14.live",
      "kind": "proof-sketch",
      "text": "If \\(s\\) is the side opposite \\(30^\\circ,\\) the Law of Sines gives \\[ \\frac{s}{\\sin30^\\circ}=\\frac8{\\sin45^\\circ}. \\] Therefore \\[ s=8\\frac{\\frac{1}{2}}{\\frac{\\sqrt2}{2}}=4\\sqrt2. \\]\n\nTherefore, the correct answer is B.",
      "hints": [
        "Relate the two sides with the Law of Sines",
        "Use \\(\\sin30^\\circ=\\frac{1}{2}\\) and \\(\\sin45^\\circ=\\frac{\\sqrt2}{2}\\)"
      ],
      "images": []
    }
  ],
