  "estimatedMinutes": 1,
  "statement": "For how many integers \\(x\\) is the point \\((x, -x)\\) inside or on the circle of radius \\(10\\) centered at \\((5, 5)?\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\( 11 \\)"
    },
    {
      "label": "B",
      "text": "\\( 12 \\)"
    },
