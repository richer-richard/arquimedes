  "estimatedMinutes": 1,
  "statement": "If the base of a rectangle is increased by \\(10\\%\\) and the area is unchanged, then the altitude is decreased by:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(9\\%\\)"
    },
    {
      "label": "B",
      "text": "\\(10\\%\\)"
    },
    {
      "label": "C",
      "text": "\\(11\\%\\)"
    },
    {
      "label": "D",
      "text": "\\(11\\dfrac19\\%\\)"
    },
    {
      "label": "E",
      "text": "\\(9\\dfrac1{11}\\%\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": "100/11"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1952-p16.live",
      "kind": "proof-sketch",
      "text": "To keep the area fixed, the altitude is multiplied by \\(\\frac{10}{11}.\\) Its fractional decrease is \\[ 1-\\frac{10}{11}=\\frac1{11}, \\] which is \\(\\frac{100}{11}\\%=9\\dfrac1{11}\\%.\\)\n\nThus, the correct answer is E.",
      "hints": [
        "The new altitude must be divided by the same factor by which the base was multiplied",
        "A \\(10\\%\\) base increase multiplies the base by \\(\\frac{11}{10}\\)"
      ],
      "images": []
    }
  ],
