  "solutions": [
    {
      "id": "sol.ahsme-1986-p3.live",
      "kind": "proof-sketch",
      "text": "Since \\(\\angle C=90^\\circ\\) and \\(\\angle A=20^\\circ,\\) we have \\(\\angle ABC=70^\\circ.\\) The bisector gives \\(\\angle DBC=35^\\circ.\\) Therefore, in right triangle \\(BDC,\\) \\[ \\angle BDC=90^\\circ-35^\\circ=55^\\circ. \\]\n\nThus the correct answer is D.",
      "hints": [
        "First find \\(\\angle ABC\\) from the angle sum of \\(\\triangle ABC\\)",
        "Use the bisector and then the angle sum of right triangle \\(BDC\\)"
      ],
