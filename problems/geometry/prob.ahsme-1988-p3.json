  "estimatedMinutes": 1,
  "statement": "Four rectangular paper strips of length \\(10\\) and width \\(1\\) are put flat on a table and overlap perpendicularly as shown. How much area of the table is covered?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(36\\)"
    },
    {
      "label": "B",
      "text": "\\(40\\)"
    },
    {
      "label": "C",
      "text": "\\(44\\)"
    },
    {
      "label": "D",
      "text": "\\(98\\)"
    },
    {
      "label": "E",
      "text": "\\(100\\)"
    }
  ],
  "answer": {
    "letter": "a",
    "value": "36"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1988-p3.live",
      "kind": "proof-sketch",
      "text": "The strips have total area \\(4(10)=40.\\) There are four \\(1\\)-by-\\(1\\) overlaps, each counted twice, so the covered area is \\(40-4=36.\\)\n\nThus the correct answer is A.",
      "hints": [
        "First add the areas of the four strips",
        "Each perpendicular crossing is a unit square counted twice"
      ],
