  "estimatedMinutes": 1,
  "statement": "Let \\(P\\) units be the increase in the circumference of a circle resulting from an increase of \\(\\pi\\) units in the diameter. Then \\(P\\) equals:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac1\\pi\\)"
    },
    {
      "label": "B",
      "text": "\\(\\pi\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{\\pi^2}{2}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\pi^2\\)"
    },
    {
      "label": "E",
      "text": "\\(2\\pi\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1968-p1.live",
      "kind": "proof-sketch",
      "text": "The original circumference is \\(\\pi d.\\) After the diameter increases by \\(\\pi,\\) it is \\(\\pi(d+\\pi).\\) The increase is therefore \\(\\pi(d+\\pi)-\\pi d=\\pi^2.\\)\n\nTherefore, the correct answer is D.",
      "hints": [
        "Write circumference as \\(\\pi d\\)",
        "Replace \\(d\\) by \\(d+\\pi\\) and subtract"
      ],
      "images": []
    }
  ],
