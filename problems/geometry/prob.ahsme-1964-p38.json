    {
      "label": "A",
      "text": "\\(6\\)"
    },
    {
      "label": "B",
      "text": "\\(7\\)"
    },
    {
      "label": "C",
      "text": "\\(8\\)"
    },
    {
      "label": "D",
      "text": "\\(9\\)"
    },
    {
      "label": "E",
      "text": "\\(10\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": "9"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1964-p38.live",
      "kind": "proof-sketch",
      "text": "Apollonius’s theorem gives \\[ \\begin{aligned} QR^2 &=2(4^2+7^2)-4\\left(\\frac72\\right)^2\\\\ &=81. \\end{aligned} \\] Therefore \\(QR=9.\\)\n\nThus, the correct answer is D.",
      "hints": [
        "Use Apollonius’s theorem for the median to \\(QR\\)",
        "Substitute \\(PQ=4,\\ PR=7,\\ PM=\\frac{7}{2}\\)"
      ],
