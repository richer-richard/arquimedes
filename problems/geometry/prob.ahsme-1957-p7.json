  "estimatedMinutes": 1,
  "statement": "The area of a circle inscribed in an equilateral triangle is \\(48\\pi.\\) The perimeter of this triangle is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(72\\sqrt3\\)"
    },
    {
      "label": "B",
      "text": "\\(48\\sqrt3\\)"
    },
    {
      "label": "C",
      "text": "\\(36\\)"
    },
    {
      "label": "D",
      "text": "\\(24\\)"
    },
    {
      "label": "E",
      "text": "\\(72\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": "72"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1957-p7.live",
      "kind": "proof-sketch",
      "text": "The inradius satisfies \\(r^2=48,\\) so \\(r=4\\sqrt3.\\) If \\(s\\) is the side length, then \\[ r=\\frac{s\\sqrt3}{6}, \\] which gives \\(s=24.\\) The perimeter is \\(3s=72.\\)\n\nThus, the correct answer is E.",
      "hints": [
        "Use \\(\\pi r^2=48\\pi\\) to find the inradius",
        "For an equilateral triangle of side \\(s,\\) the inradius is \\(\\frac{s\\sqrt3}{6}\\)"
      ],
      "images": []
    }
  ],
