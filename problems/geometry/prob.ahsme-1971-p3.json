  "estimatedMinutes": 1,
  "statement": "If the point \\((x,-4)\\) lies on the straight line joining the points \\((0,8)\\) and \\((-4,0)\\) in the \\(xy\\)-plane, then \\(x\\) is equal to:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(-2\\)"
    },
    {
      "label": "B",
      "text": "\\(2\\)"
    },
    {
      "label": "C",
      "text": "\\(-8\\)"
    },
    {
      "label": "D",
      "text": "\\(6\\)"
    },
    {
      "label": "E",
      "text": "\\(-6\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": "-6"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1971-p3.live",
      "kind": "proof-sketch",
      "text": "The slope through \\((0,8)\\) and \\((-4,0)\\) is \\(2,\\) so the line is \\(y=2x+8.\\) Substituting \\(y=-4\\) gives \\(-4=2x+8,\\) hence \\(x=-6.\\)\n\nTherefore, the correct answer is E.",
      "hints": [
        "Find the slope through the two given fixed points",
        "The line has equation \\(y=2x+8\\)"
      ],
