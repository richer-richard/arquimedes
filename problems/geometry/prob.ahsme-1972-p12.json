  "estimatedMinutes": 2,
  "statement": "The number of cubic feet in the volume of a cube is the same as the number of square inches in its surface area. The length of the edge expressed as a number of feet is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(6\\)"
    },
    {
      "label": "B",
      "text": "\\(864\\)"
    },
    {
      "label": "C",
      "text": "\\(1728\\)"
    },
    {
      "label": "D",
      "text": "\\(6\\times1728\\)"
    },
    {
      "label": "E",
      "text": "\\(2304\\)"
    }
  ],
  "answer": {
    "letter": "b",
    "value": "864"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1972-p12.live",
      "kind": "proof-sketch",
      "text": "Let the edge length be \\(f\\) feet, or \\(12f\\) inches. The stated numerical equality is \\[ f^3=6(12f)^2. \\] Since \\(f\\gt0,\\) division by \\(f^2\\) gives \\[ f=6\\cdot144=864. \\]\n\nTherefore, the correct answer is B.",
      "hints": [
        "If the edge is \\(f\\) feet, its length in inches is \\(12f\\)",
        "Equate the numerical values \\(f^3\\) and \\(6(12f)^2\\)"
      ],
      "images": []
    }
  ],
