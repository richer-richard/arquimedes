  "solutions": [
    {
      "id": "sol.ahsme-1978-p7.live",
      "kind": "proof-sketch",
      "text": "The distance between opposite sides is twice the apothem, hence \\(s\\sqrt3.\\) Therefore \\(s\\sqrt3=12,\\) so \\(s=\\frac{12}{\\sqrt3}=4\\sqrt3.\\)\n\nTherefore, the correct answer is E.",
      "hints": [
        "The distance between opposite sides is twice the apothem",
        "A regular hexagon of side \\(s\\) has apothem \\(\\frac{\\sqrt3}{2}s\\)"
      ],
