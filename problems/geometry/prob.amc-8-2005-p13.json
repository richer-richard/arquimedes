  "solutions": [
    {
      "id": "sol.amc-8-2005-p13.live",
      "kind": "proof-sketch",
      "text": "Complete the shape to rectangle \\(ABCG\\), which has area \\(8\\cdot9=72\\).\n\nThe missing rectangle \\(FEDG\\) has area \\(72-52=20\\). Its height is \\(DE=BC-FA=9-5=4\\).\n\nTherefore \\(EF=20\\div4=5\\), so \\(DE+EF=4+5=9\\).\n\nThus, C is the correct answer.",
      "hints": [
        "Complete the figure to a rectangle.",
        "Subtract the polygon area from the rectangle area to get the missing rectangle."
      ],
