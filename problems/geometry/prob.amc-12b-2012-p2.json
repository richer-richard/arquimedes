  "estimatedMinutes": 1,
  "statement": "A circle of radius \\(5\\) is inscribed in a rectangle as shown. The ratio of the length of the rectangle to its width is \\(2:1.\\) What is the area of the rectangle?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(50\\)"
    },
    {
      "label": "B",
      "text": "\\(100\\)"
    },
    {
      "label": "C",
      "text": "\\(125\\)"
    },
    {
      "label": "D",
      "text": "\\(150\\)"
    },
    {
      "label": "E",
      "text": "\\(200\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": "200"
  },
  "solutions": [
    {
      "id": "sol.amc-12b-2012-p2.live",
      "kind": "proof-sketch",
      "text": "The circle is inscribed, so the width of the rectangle equals the diameter, \\(2\\cdot5=10.\\)\n\nThe length is then \\(2\\cdot10=20,\\) so the area is \\(10\\cdot20=200.\\)\n\nThus, the correct answer is E.",
      "hints": [
        "The width of the rectangle equals the diameter of the circle",
        "The length is twice the width"
      ],
