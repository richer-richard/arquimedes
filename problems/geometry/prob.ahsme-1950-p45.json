  "solutions": [
    {
      "id": "sol.ahsme-1950-p45.live",
      "kind": "proof-sketch",
      "text": "There are \\(\\binom{100}{2}\\) segments joining pairs of vertices. Exactly \\(100\\) of these are sides, so the number of diagonals is \\[ \\begin{aligned} \\binom{100}{2}-100 &=4950-100\\\\ &=4850. \\end{aligned} \\]\n\nThus, the correct answer is A.",
      "hints": [
        "Every pair of vertices determines a segment",
        "Subtract the \\(100\\) sides from the \\(\\binom{100}{2}\\) vertex pairs"
      ],
