  "estimatedMinutes": 1,
  "statement": "Given the line \\(y=\\dfrac34x+6\\) and a line \\(L\\) parallel to the given line and \\(4\\) units from it. A possible equation for \\(L\\) is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(y=\\dfrac34x+1\\)"
    },
    {
      "label": "B",
      "text": "\\(y=\\dfrac34x\\)"
    },
    {
      "label": "C",
      "text": "\\(y=\\dfrac34x-\\dfrac23\\)"
    },
    {
      "label": "D",
      "text": "\\(y=\\dfrac34x-1\\)"
    },
    {
      "label": "E",
      "text": "\\(y=\\dfrac34x+2\\)"
    }
  ],
