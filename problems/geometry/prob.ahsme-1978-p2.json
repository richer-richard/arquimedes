  "estimatedMinutes": 1,
  "statement": "If four times the reciprocal of the circumference of a circle equals the diameter of the circle, then the area of the circle is",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\frac1{\\pi^2}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\frac1\\pi\\)"
    },
    {
      "label": "C",
      "text": "\\(1\\)"
    },
    {
      "label": "D",
      "text": "\\(\\pi\\)"
    },
    {
      "label": "E",
      "text": "\\(\\pi^2\\)"
    }
  ],
