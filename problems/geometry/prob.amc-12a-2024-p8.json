  "estimatedMinutes": 2,
  "statement": "How many angles \\(\\theta\\) with \\(0\\le\\theta\\le2\\pi\\) satisfy \\(\\log(\\sin(3\\theta))+\\log(\\cos(2\\theta))=0?\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(0\\)"
    },
