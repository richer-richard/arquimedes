  "solutions": [
    {
      "id": "sol.amc-12a-2003-p7.live",
      "kind": "proof-sketch",
      "text": "Let the sides be \\(a\\le b\\le c\\) with \\(a+b+c=7.\\) The triangle inequality requires \\(c\\lt a+b,\\) so \\(c\\lt3.5,\\) forcing \\(c=3.\\)\n\nThen \\(a+b=4\\) with \\(a\\le b\\le3,\\) giving the triangles \\(1\\text{-}3\\text{-}3\\) and \\(2\\text{-}2\\text{-}3.\\)\n\nThus, the correct answer is B.",
      "hints": [
        "The longest side must be less than half the perimeter",
        "The longest side is at most \\(3\\)"
      ],
      "images": []
    }
  ],
