  "solutions": [
    {
      "id": "sol.ahsme-1990-p3.live",
      "kind": "proof-sketch",
      "text": "The four angles sum to \\(360^\\circ,\\) so \\[ \\begin{aligned} &75+(75+d)\\\\ &\\quad +(75+2d)\\\\ &\\quad +(75+3d)=360. \\end{aligned} \\] Thus \\(d=10,\\) and the largest angle is \\(75+3(10)=105^\\circ.\\)\n\nThus the correct answer is C.",
      "hints": [
        "Write the four angles as \\(75,75+d,75+2d,75+3d\\)",
        "Use the angle sum of a quadrilateral"
      ],
