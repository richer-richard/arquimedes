      "text": "\\(45\\)"
    },
    {
      "label": "D",
      "text": "\\(46\\)"
    },
    {
      "label": "E",
      "text": "\\(47\\)"
    }
  ],
  "answer": {
    "letter": "a",
    "value": "43"
  },
  "solutions": [
    {
      "id": "sol.amc-10b-2006-p10.live",
      "kind": "proof-sketch",
      "text": "Let the sides be \\(x,\\) \\(3x,\\) and \\(15.\\) The triangle inequality \\(x+15 \\gt 3x\\) gives \\(x \\lt 7.5.\\)\n\nThe largest integer is \\(x=7,\\) giving sides \\(7,\\) \\(21,\\) \\(15\\) and perimeter \\(7+21+15=43.\\)\n\nThus, the correct answer is A.",
      "hints": [
        "Let the sides be \\(x,\\) \\(3x,\\) and \\(15\\)",
        "The binding triangle inequality is \\(x+15 \\gt 3x\\)"
      ],
