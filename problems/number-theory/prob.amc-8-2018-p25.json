  "solutions": [
    {
      "id": "sol.amc-8-2018-p25.live",
      "kind": "proof-sketch",
      "text": "Because \\(6^3=216<257\\) and \\(257<343=7^3\\), the smallest cube in the interval is \\(7^3\\). Also, \\(64^3=2^{18}<2^{18}+1<65^3\\), so the largest cube is \\(64^3\\).\n\nThe integer cube roots are therefore \\(7,8,\\ldots,64\\), a total of \\(64-7+1=58\\).\n\nThus, E is the correct answer.",
      "hints": [
        "A perfect cube in the interval has the form \\(n^3\\).",
        "Compare the bounds to \\(6^3,7^3,64^3,\\) and \\(65^3\\)."
      ],
      "images": []
    }
  ],
