  "solutions": [
    {
      "id": "sol.amc-12a-2003-p8.live",
      "kind": "proof-sketch",
      "text": "The number \\(60\\) has \\(12\\) positive factors: \\(1,2,3,4,5,6,\\) \\(10,12,15,20,30,60.\\)\n\nSix of them are less than \\(7,\\) namely \\(1,2,3,4,5,6,\\) so the probability is \\(\\dfrac{6}{12}=\\dfrac12.\\)\n\nThus, the correct answer is E.",
      "hints": [
        "\\(60=2^2\\cdot3\\cdot5\\) has \\((2{+}1)(1{+}1)(1{+}1)=12\\) factors",
        "Count the factors from \\(1\\) through \\(6\\)"
      ],
