  "estimatedMinutes": 1,
  "statement": "The number \\(121_b,\\) written in the integral base \\(b,\\) is the square of an integer, for:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(b=10,\\) only"
    },
    {
      "label": "B",
      "text": "\\(b=10\\) and \\(b=5,\\) only"
    },
    {
      "label": "C",
      "text": "\\(2\\le b\\le10\\)"
    },
    {
      "label": "D",
      "text": "\\(b\\gt2\\)"
    },
    {
      "label": "E",
      "text": "no value of \\(b\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1962-p22.live",
      "kind": "proof-sketch",
      "text": "In ordinary notation, \\[ 121_b=b^2+2b+1=(b+1)^2. \\] This is a square for every allowable base. Since digit \\(2\\) occurs, precisely the integral bases \\(b\\gt2\\) are allowable.\n\nThus, the correct answer is D.",
      "hints": [
        "Convert \\(121_b\\) to an expression in \\(b\\)",
        "Remember that the digit \\(2\\) requires \\(b\\gt2\\)"
      ],
      "images": []
    }
  ],
