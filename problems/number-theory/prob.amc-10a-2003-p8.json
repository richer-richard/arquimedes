  "estimatedMinutes": 1,
  "statement": "What is the probability that a randomly drawn positive factor of \\(60\\) is less than \\(7?\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{1}{10}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{1}{6}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{1}{4}\\)"
    },
