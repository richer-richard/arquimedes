  "solutions": [
    {
      "id": "sol.ahsme-1982-p26.live",
      "kind": "proof-sketch",
      "text": "The last two octal digits \\(3c_8\\) represent \\(24+c\\pmod{64}.\\) Squares modulo \\(64\\) in the range \\(24,\\ldots,31\\) include only \\(25.\\) Thus \\(24+c=25,\\) so \\(c=1.\\)\n\nTherefore, the correct answer is B.",
      "hints": [
        "Only the last two base-\\(8\\) digits matter modulo \\(64\\)",
        "List the quadratic residues modulo \\(64\\) that lie between \\(30_8\\) and \\(37_8\\)"
      ],
