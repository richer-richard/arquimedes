  "solutions": [
    {
      "id": "sol.ahsme-1984-p3.live",
      "kind": "proof-sketch",
      "text": "Every prime factor of \\(n\\) is at least \\(11.\\) The smallest composite with that property is \\(11\\cdot11=121,\\) which lies in \\(120\\lt n\\le130.\\)\n\nTherefore, the correct answer is C.",
      "hints": [
        "The smallest permitted prime factor is \\(11\\)",
        "To make the smallest composite, use the two smallest permitted prime factors"
