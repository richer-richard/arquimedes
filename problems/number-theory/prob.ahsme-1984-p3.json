  "statement": "Let \\(n\\) be the smallest nonprime integer greater than \\(1\\) with no prime factor less than \\(10.\\) Then",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(100\\lt n\\le110\\)"
    },
