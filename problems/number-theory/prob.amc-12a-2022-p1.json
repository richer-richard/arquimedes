  "solutions": [
    {
      "id": "sol.amc-12a-2022-p1.live",
      "kind": "proof-sketch",
      "text": "Simplify from the bottom. The innermost fraction is \\(3+\\dfrac13=\\dfrac{10}{3}.\\)\n\nThe next layer is \\(3+\\dfrac{1}{\\frac{10}{3}}=3+\\dfrac{3}{10}=\\dfrac{33}{10}.\\)\n\nFinally, \\(3+\\dfrac{1}{\\frac{33}{10}}=3+\\dfrac{10}{33}=\\dfrac{109}{33}.\\)\n\nThus, the correct answer is D.",
      "hints": [
        "Work from the innermost fraction outward",
        "\\(3+\\dfrac13=\\dfrac{10}{3},\\) so the next layer up is \\(3+\\dfrac{3}{10}\\)"
      ],
      "images": []
    }
