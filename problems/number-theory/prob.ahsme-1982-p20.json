  "solutions": [
    {
      "id": "sol.ahsme-1982-p20.live",
      "kind": "proof-sketch",
      "text": "For every positive integer \\(k,\\) take \\(x=k^2+1\\) and \\(y=k(k^2+1)=kx.\\) Then \\(y^2=k^2x^2=x^2(x-1),\\) so \\(x^2+y^2=x^3.\\) This supplies infinitely many positive-integer pairs.\n\nTherefore, the correct answer is D.",
      "hints": [
        "Rearrange as \\(y^2=x^2(x-1)\\)",
        "Choose \\(x-1\\) to be a perfect square"
      ],
      "images": []
    }
  ],
