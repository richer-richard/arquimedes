  "solutions": [
    {
      "id": "sol.ahsme-1968-p19.live",
      "kind": "proof-sketch",
      "text": "The equation \\(10d+25q=1000\\) reduces to \\(2d+5q=200.\\) Thus \\(q\\) must be even; write \\(q=2k,\\) giving \\(d=100-5k.\\) Positivity requires \\(k=1,\\) \\(2,\\) \\(\\ldots,\\) \\(19,\\) so there are \\(19\\) ways.\n\nTherefore, the correct answer is E.",
      "hints": [
        "In cents, solve \\(10d+25q=1000\\)",
        "Use parity to write \\(q=2k\\), then enforce positive coin counts"
      ],
