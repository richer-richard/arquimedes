  "solutions": [
    {
      "id": "sol.amc-10a-2003-p15.live",
      "kind": "proof-sketch",
      "text": "Of the \\(100\\) integers, \\(50\\) are divisible by \\(2.\\)\n\nAmong those, the ones also divisible by \\(3\\) are the multiples of \\(6,\\) of which there are \\(16.\\)\n\nSo \\(50 - 16 = 34\\) qualify, giving probability \\(\\dfrac{34}{100} = \\dfrac{17}{50}.\\)\n\nThus, the correct answer is C.",
      "hints": [
        "Count the multiples of \\(2,\\) then remove those also divisible by \\(3\\)",
        "There are \\(50\\) even numbers and \\(16\\) multiples of \\(6\\)"
      ],
      "images": []
    }
  ],
