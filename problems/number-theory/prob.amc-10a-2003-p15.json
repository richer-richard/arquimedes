  "estimatedMinutes": 1,
  "statement": "What is the probability that an integer in the set \\(\\{1, 2, 3, \\ldots, 100\\}\\) is divisible by \\(2\\) and not divisible by \\(3?\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{1}{6}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{33}{100}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{17}{50}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{1}{2}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{18}{25}\\)"
    }
  ],
  "answer": {
