  "estimatedMinutes": 2,
  "statement": "The product \\((8)(888\\ldots8),\\) where the second factor has \\(k\\) digits, is an integer whose digits have a sum of \\(1000.\\) What is \\(k?\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(901\\)"
    },
    {
