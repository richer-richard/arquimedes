      "label": "C",
      "text": "\\(919\\)"
    },
    {
      "label": "D",
      "text": "\\(991\\)"
    },
    {
      "label": "E",
      "text": "\\(999\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": "991"
