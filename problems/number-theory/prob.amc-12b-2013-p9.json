  "solutions": [
    {
      "id": "sol.amc-12b-2013-p9.live",
      "kind": "proof-sketch",
      "text": "Since \\(12! = 2^{10}\\cdot 3^5\\cdot 5^2\\cdot 7\\cdot 11,\\) the largest perfect square dividing it is \\(2^{10}\\cdot 3^4\\cdot 5^2,\\) whose square root is \\(2^5\\cdot 3^2\\cdot 5.\\) The exponents sum to \\(5 + 2 + 1 = 8.\\) Thus, the correct answer is C.",
      "hints": [
        "Factor \\(12! = 2^{10}\\cdot 3^5\\cdot 5^2\\cdot 7\\cdot 11\\)",
        "The largest square divisor keeps only even exponents; halving them gives the square root"
      ],
