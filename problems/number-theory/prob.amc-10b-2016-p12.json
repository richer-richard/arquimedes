  "answer": {
    "letter": "d",
    "value": "0.7"
  },
  "solutions": [
    {
      "id": "sol.amc-10b-2016-p12.live",
      "kind": "proof-sketch",
      "text": "The product is odd if and only if both numbers are odd. There are \\(\\binom 32=3\\) ways to do this out of a possible \\(\\binom 52=10 \\) ways. This makes the probability of it being odd equal to \\(\\frac 3{10} = 0.3.\\) This means the probability it is even is \\(1-0.3=0.7.\\)\n\nThus, the correct answer is D .",
      "hints": [
        "Count the odd-product pairs instead",
        "There are \\(\\binom32\\) odd pairs out of \\(\\binom52\\) pairs"
      ],
      "images": []
    }
  ],
