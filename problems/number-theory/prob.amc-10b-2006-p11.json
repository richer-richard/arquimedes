  "solutions": [
    {
      "id": "sol.amc-10b-2006-p11.live",
      "kind": "proof-sketch",
      "text": "For \\(n\\ge 10,\\) \\(n!\\) is divisible by \\(100,\\) so it does not affect the last two digits.\n\nThe tens digit comes from \\(7!+8!+9!\\) \\(=5040+40320+362880\\) \\(=408240,\\) whose tens digit is \\(4.\\)\n\nThus, the correct answer is C.",
      "hints": [
        "For \\(n\\ge 10,\\) \\(n!\\) ends in at least two zeros",
        "Only \\(7!+8!+9!\\) affects the last two digits"
      ],
