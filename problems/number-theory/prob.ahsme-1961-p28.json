  "solutions": [
    {
      "id": "sol.ahsme-1961-p28.live",
      "kind": "proof-sketch",
      "text": "Powers of \\(7\\) have units digits \\(7,\\) \\(9,\\) \\(3,\\) \\(1\\) in a cycle of length \\(4.\\) Since \\(753\\equiv1\\pmod4,\\) the units digit of \\(2137^{753}\\) is \\(7.\\)\n\nTherefore, the correct answer is D.",
      "hints": [
        "Only the units digit of the base matters",
        "List the four-term cycle of powers of \\(7\\) modulo \\(10\\)"
      ],
