  "estimatedMinutes": 1,
  "statement": "How many integers greater than ten and less than one hundred, written in base ten notation, are increased by nine when their digits are reversed?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(0\\)"
    },
    {
      "label": "B",
      "text": "\\(1\\)"
    },
    {
      "label": "C",
      "text": "\\(8\\)"
    },
    {
      "label": "D",
      "text": "\\(9\\)"
    },
    {
      "label": "E",
      "text": "\\(10\\)"
    }
  ],
  "answer": {
    "letter": "c",
    "value": "8"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1976-p5.live",
      "kind": "proof-sketch",
      "text": "The condition is \\(9(u-t)=9,\\) so \\(u=t+1.\\) The possibilities are \\(12,\\) \\(23,\\) \\(34,\\) \\(45,\\) \\(56,\\) \\(67,\\) \\(78,\\) and \\(89,\\) giving \\(8\\) integers.\n\nTherefore, the correct answer is C.",
      "hints": [
        "Represent the tens and units digits by \\(t\\) and \\(u\\)",
        "The increase is \\(10u+t-(10t+u)=9(u-t)\\)"
      ],
      "images": []
    }
  ],
