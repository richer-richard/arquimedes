  "solutions": [
    {
      "id": "sol.hmmt-nov-general-2015-p5.hmmt",
      "kind": "proof-sketch",
      "text": "Answer: 672\nFrom each of the sets \\(\\{1,2,3\\},\\{4,5,6\\},\\{7,8,9\\}, \\ldots\\) at most 1 element can be in \\(S\\). This leads to an upper bound of \\(\\left\\lceil\\frac{2015}{3}\\right\\rceil=672\\) which we can obtain with the set \\(\\{1,4,7, \\ldots, 2014\\}\\).",
