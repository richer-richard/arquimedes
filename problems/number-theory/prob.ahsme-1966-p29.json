  "solutions": [
    {
      "id": "sol.ahsme-1966-p29.live",
      "kind": "proof-sketch",
      "text": "By inclusion-exclusion, the count is \\[ \\begin{aligned} &999-\\left\\lfloor\\frac{999}{5}\\right\\rfloor -\\left\\lfloor\\frac{999}{7}\\right\\rfloor\\\\ &\\quad+\\left\\lfloor\\frac{999}{35}\\right\\rfloor\\\\ &=999-199-142+28\\\\ &=686. \\end{aligned} \\]\n\nTherefore, the correct answer is B.",
      "hints": [
        "There are \\(999\\) positive integers below \\(1000\\)",
        "Subtract multiples of \\(5\\) and \\(7\\), then add back multiples of \\(35\\)"
      ],
      "images": []
    }
  ],
