  "estimatedMinutes": 1,
  "statement": "One can holds \\(12\\) ounces of soda. What is the minimum number of cans needed to provide a gallon (\\(128\\) ounces) of soda?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(7\\)"
    },
    {
      "label": "B",
      "text": "\\(8\\)"
    },
