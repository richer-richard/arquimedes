  "solutions": [
    {
      "id": "sol.amc-8-1988-p14.live",
      "kind": "proof-sketch",
      "text": "The factor pairs of \\(36\\) are \\(1 \\times 36,\\) \\(2 \\times 18,\\) \\(3 \\times 12,\\) \\(4 \\times 9,\\) and \\(6 \\times 6.\\)\n\nThe sum is largest for the most spread-out pair, \\(1 + 36 = 37.\\)\n\nThus, the correct answer is E .",
      "hints": [
        "List the factor pairs of \\(36\\)",
        "The sum is largest when the two factors are as far apart as possible"
      ],
