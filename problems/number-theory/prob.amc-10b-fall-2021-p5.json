  "solutions": [
    {
      "id": "sol.amc-10b-fall-2021-p5.live",
      "kind": "proof-sketch",
      "text": "Since \\(8=2^3,\\) we have \\[n=8^{2022}=2^{6066}=4^{3033}.\\]\n\nTherefore \\[\\frac n4=\\frac{4^{3033}}4=4^{3032}.\\]\n\nThus, the answer is E .",
      "hints": [
        "Write \\(8^{2022}\\) as a power of \\(4\\)",
        "\\(8^{2022}=4^{3033}\\)"
      ],
