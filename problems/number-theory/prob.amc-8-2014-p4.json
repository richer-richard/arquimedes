  "solutions": [
    {
      "id": "sol.amc-8-2014-p4.live",
      "kind": "proof-sketch",
      "text": "The sum of two odd primes is even. Since \\(85\\) is odd, one of the primes must be the only even prime, \\(2\\).\n\nThe other prime is \\(85-2=83\\), so the product is \\(2\\cdot83=166\\).\n\nThus, E is the correct answer.",
      "hints": [
        "An odd sum of two primes must include the only even prime.",
        "Subtract that even prime from \\(85\\)."
      ],
