  "estimatedMinutes": 1,
  "statement": "If the digit \\(1\\) is placed after a two digit number whose tens’ digit is \\(t,\\) and units’ digit is \\(u,\\) the new number is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(10t+u+1\\)"
    },
    {
      "label": "B",
      "text": "\\(100t+10u+1\\)"
    },
    {
      "label": "C",
      "text": "\\(1000t+10u+1\\)"
    },
    {
      "label": "D",
      "text": "\\(t+u+1\\)"
    },
    {
      "label": "E",
      "text": "None of these answers"
    }
  ],
  "answer": {
    "letter": "b",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1950-p7.live",
      "kind": "proof-sketch",
      "text": "The two digit number is \\(10t+u.\\) Placing \\(1\\) after it produces \\[ \\begin{aligned} &10(10t+u)+1\\\\ &=100t+10u+1. \\end{aligned} \\]\n\nThus, the correct answer is B.",
      "hints": [
        "The original two digit number is \\(10t+u\\)",
        "Appending a digit multiplies the original number by \\(10\\) before adding that digit"
      ],
