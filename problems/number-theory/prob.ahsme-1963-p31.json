  "solutions": [
    {
      "id": "sol.ahsme-1963-p31.live",
      "kind": "proof-sketch",
      "text": "We need \\(y\\) odd so that \\(763-3y\\) is even, and positivity gives \\(1\\leq y\\leq253.\\) The odd values \\(1,\\) \\(3,\\) \\(\\ldots,\\) and \\(253\\) number \\(\\frac{253+1}{2}=127.\\)\n\nTherefore, the correct answer is D.",
      "hints": [
        "Solve for \\(x=\\frac{763-3y}{2}\\)",
        "Positive integral \\(x\\) requires \\(y\\) to be an odd positive integer below \\(\\frac{763}{3}\\)"
      ],
      "images": []
    }
  ],
