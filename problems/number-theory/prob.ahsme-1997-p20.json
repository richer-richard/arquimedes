  "solutions": [
    {
      "id": "sol.ahsme-1997-p20.live",
      "kind": "proof-sketch",
      "text": "The sum is \\(100a+(1+\\cdots+100)\\) \\(=100a+5050,\\) so it ends in \\(50.\\) Only \\(1,627,384,950\\) has that property, and it gives the positive integer \\(a=\\frac{1,627,384,950-5050}{100}.\\) Thus A is correct.",
      "hints": [
        "Write the terms as \\(a+1,a+2,\\ldots,a+100\\)",
        "Their sum must be congruent to \\(50\\) modulo \\(100\\)"
      ],
      "images": []
    }
  ],
