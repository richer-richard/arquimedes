  "solutions": [
    {
      "id": "sol.amc-10-2001-p19.live",
      "kind": "proof-sketch",
      "text": "The number of selections is the number of nonnegative integer solutions of \\(g+c+p=4.\\) By stars and bars, this is \\(\\dbinom{4+2}{2}=\\dbinom62=15.\\)\n\nThus, the correct answer is D.",
      "hints": [
        "Count nonnegative integer solutions of \\(g+c+p=4\\)",
        "Use stars and bars: \\(\\dbinom{4+2}{2}\\)"
      ],
