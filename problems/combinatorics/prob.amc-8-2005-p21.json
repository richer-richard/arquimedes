  "solutions": [
    {
      "id": "sol.amc-8-2005-p21.live",
      "kind": "proof-sketch",
      "text": "Notice that choosing any of these \\(3\\) dots forms a triangle, except for the \\(2\\) triples that form a straight line.\n\nThere are \\(\\binom{6}{3} = 20\\) ways to choose the points, and then we subtract \\(2\\) to get \\(20 - 2 = 18.\\)\n\nThus, C is the correct answer.",
      "hints": [
        "There are \\(6\\) dots total.",
        "Subtract the choices of three collinear dots from all \\(3\\)-dot choices."
      ],
