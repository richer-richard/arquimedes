  "solutions": [
    {
      "id": "sol.ahsme-1953-p6.live",
      "kind": "proof-sketch",
      "text": "The difference is \\[ (5q+1)-(q+5)=4q-4 \\] quarters. Multiplying by \\(\\frac{5}{2}\\) dimes per quarter gives \\[ \\frac52(4q-4)=10(q-1). \\]\n\nThus, the correct answer is A.",
      "hints": [
        "First subtract the two numbers of quarters",
        "One quarter is \\(\\frac{5}{2}\\) dimes"
      ],
      "images": []
    }
  ],
