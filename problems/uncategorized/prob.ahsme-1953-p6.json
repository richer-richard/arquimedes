  "estimatedMinutes": 1,
  "statement": "Charles has \\(5q+1\\) quarters and Richard has \\(q+5\\) quarters. The difference in their money in dimes is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(10(q-1)\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac25(4q-4)\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac25(q-1)\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac52(q-1)\\)"
    },
    {
      "label": "E",
      "text": "none of these"
    }
  ],
