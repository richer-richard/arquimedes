  "solutions": [
    {
      "id": "sol.hmmt-feb-general-2-2006-p2.hmmt",
      "kind": "proof-sketch",
      "text": "\\[\\prod_{k=2}^{2006} \\frac{k^{2}}{k^{2}-1}=\\prod_{k=2}^{2006} \\frac{k^{2}}{(k-1)(k+1)}=\\prod_{k=2}^{2006} \\frac{k}{k-1} \\prod_{k=2}^{2006} \\frac{k}{k+1}=\\frac{2006}{1} \\cdot \\frac{2}{2007}=\\frac{4012}{2007}\\]",
