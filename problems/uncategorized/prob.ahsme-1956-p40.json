      "text": "\\(\\dfrac{2S}{V-V_0}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{2S}{V_0-V}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{2S}{V}\\)"
    },
    {
      "label": "E",
      "text": "\\(2S-V\\)"
    }
