  "estimatedMinutes": 1,
  "statement": "If \\(V=gt+V_0\\) and \\(S=\\dfrac12gt^2+V_0t,\\) then \\(t\\) equals:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{2S}{V+V_0}\\)"
