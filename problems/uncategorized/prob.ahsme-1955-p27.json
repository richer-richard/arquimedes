  "solutions": [
    {
      "id": "sol.ahsme-1955-p27.live",
      "kind": "proof-sketch",
      "text": "By Vieta’s formulas, \\(r+s=p\\) and \\(rs=q.\\) Therefore \\[ \\begin{aligned} r^2+s^2 &=(r+s)^2-2rs\\\\ &=p^2-2q. \\end{aligned} \\]\n\nThus, the correct answer is B.",
      "hints": [
        "Use \\(r+s=p\\) and \\(rs=q\\)",
        "Expand \\((r+s)^2\\) and isolate \\(r^2+s^2\\)"
      ],
