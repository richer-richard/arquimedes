  "solutions": [
    {
      "id": "sol.ahsme-1956-p20.live",
      "kind": "proof-sketch",
      "text": "Taking common logarithms gives \\[ x\\log(0.2)=\\log2. \\] Since \\(\\log(0.2)=\\log2-1=-0.6990,\\) \\[ x=\\frac{0.3010}{-0.6990}\\approx-0.4306. \\] To the nearest tenth, this is \\(-0.4.\\)\n\nThus, the correct answer is C.",
      "hints": [
        "Take common logarithms of both sides",
        "Use \\(\\log(0.2)=\\log2-1=-0.6990\\)"
      ],
