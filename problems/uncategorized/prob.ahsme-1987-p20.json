  "solutions": [
    {
      "id": "sol.ahsme-1987-p20.live",
      "kind": "proof-sketch",
      "text": "For each \\(k=1,\\ldots,44,\\) \\[ \\tan k^\\circ\\tan(90^\\circ-k^\\circ)=1. \\] Thus each paired sum of logarithms is \\(\\log_{10}1=0.\\) The remaining middle term is \\(\\log_{10}(\\tan45^\\circ)=0.\\) Hence the whole sum is \\(0.\\)\n\nThus the correct answer is A.",
      "hints": [
        "Pair the term at angle \\(k^\\circ\\) with the term at angle \\((90-k)^\\circ\\)",
        "Use \\(\\tan(90^\\circ-\\theta)=\\cot\\theta\\) before combining logarithms"
      ],
      "images": []
    }
