  "solutions": [
    {
      "id": "sol.hmmt-feb-guts-2004-p1.hmmt",
      "kind": "proof-sketch",
      "text": "This sum is the binomial expansion of \\((1+2)^{6}\\), except that it is missing the first term, \\(\\binom{6}{0} 2^{0}=1\\). So we get \\(3^{6}-1=728\\).",
