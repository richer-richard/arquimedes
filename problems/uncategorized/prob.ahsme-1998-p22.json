    {
      "label": "A",
      "text": "\\(0.01\\)"
    },
    {
      "label": "B",
      "text": "\\(0.1\\)"
    },
    {
      "label": "C",
      "text": "\\(1\\)"
    },
    {
      "label": "D",
      "text": "\\(2\\)"
    },
    {
      "label": "E",
      "text": "\\(10\\)"
    }
  ],
  "answer": {
