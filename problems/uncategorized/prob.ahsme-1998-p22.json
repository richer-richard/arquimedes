  "solutions": [
    {
      "id": "sol.ahsme-1998-p22.live",
      "kind": "proof-sketch",
      "text": "Each term equals \\(\\log_{100!}b.\\) Therefore the sum is \\[ \\begin{aligned} &\\log_{100!}(2\\cdot3\\cdots100)\\\\ &\\qquad=\\log_{100!}(100!)=1. \\end{aligned} \\] Thus C is correct.",
      "hints": [
        "Use the reciprocal identity \\(\\frac{1}{\\log_bx}=\\log_xb\\)",
        "Combine the resulting logarithms of \\(2,3,\\ldots,100\\)"
      ],
