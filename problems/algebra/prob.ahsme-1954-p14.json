  "estimatedMinutes": 2,
  "statement": "When simplified \\(\\sqrt{1+\\left(\\dfrac{x^4-1}{2x^2}\\right)^2}\\) equals:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{x^4+2x^2-1}{2x^2}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{x^4-1}{2x^2}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{\\sqrt{x^2+1}}2\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{x^2}{\\sqrt2}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{x^2}{2}+\\dfrac1{2x^2}\\)"
    }
  ],
