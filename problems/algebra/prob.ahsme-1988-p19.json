  "solutions": [
    {
      "id": "sol.ahsme-1988-p19.live",
      "kind": "proof-sketch",
      "text": "Regrouping the numerator gives \\[ \\begin{aligned} &(bx+ay)(a^2x^2+b^2y^2)\\\\ &\\quad+2abxy(ay+bx)\\\\ &=(bx+ay)(ax+by)^2. \\end{aligned} \\] Dividing by \\(bx+ay\\) yields \\((ax+by)^2.\\)\n\nThus the correct answer is B.",
      "hints": [
        "Separate the \\(2a^2y^2\\) and \\(2b^2x^2\\) terms",
        "Try to factor the numerator first by \\(bx+ay\\)"
      ],
