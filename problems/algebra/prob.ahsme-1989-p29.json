  "estimatedMinutes": 3,
  "statement": "Find \\[ \\sum_{k=0}^{49}(-1)^k\\binom{99}{2k}, \\] where \\[ \\binom{n}{j}=\\frac{n!}{j!(n-j)!}. \\]",
