  "solutions": [
    {
      "id": "sol.ahsme-1989-p29.live",
      "kind": "proof-sketch",
      "text": "The sum is the real part of \\[ (1+i)^{99}=2^{\\frac{99}{2}}e^{\\frac{99\\pi i}{4}}. \\] Since \\(99\\equiv3\\pmod8,\\) its real part is \\[ \\begin{aligned} 2^{\\frac{99}{2}}\\cos\\frac{3\\pi}{4} &=2^{\\frac{99}{2}}\\left(-\\frac{\\sqrt2}{2}\\right)\\\\ &=-2^{49}. \\end{aligned} \\]\n\nThus the correct answer is B.",
      "hints": [
        "Recognize \\((-1)^k\\) as \\(i^{2k}\\)",
        "Take the real part of the binomial expansion of \\((1+i)^{99}\\)"
      ],
      "images": []
    }
  ],
