  "estimatedMinutes": 2,
  "statement": "Let \\(a,\\) \\(b,\\) \\(c,\\) and \\(d\\) be real numbers with \\(|a - b| = 2,\\) \\(|b - c| = 3,\\) and \\(|c - d| = 4.\\) What is the sum of all possible values of \\(|a - d|?\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(9\\)"
    },
    {
      "label": "B",
      "text": "\\(12\\)"
    },
    {
      "label": "C",
      "text": "\\(15\\)"
    },
    {
      "label": "D",
      "text": "\\(18\\)"
    },
    {
      "label": "E",
      "text": "\\(24\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": "18"
  },
  "solutions": [
    {
      "id": "sol.amc-10a-2009-p16.live",
      "kind": "proof-sketch",
      "text": "Since \\(a - d\\) \\(= (a-b) + (b-c) + (c-d)\\) \\(= \\pm 2 \\pm 3 \\pm 4,\\) the possible absolute values are \\[ \\begin{aligned} 2+3+4 &= 9, \\\\ 2+3-4 &= 1, \\\\ 2-3+4 &= 3, \\\\ -2+3+4 &= 5. \\end{aligned} \\]\n\nTheir sum is \\(9 + 1 + 3 + 5 = 18.\\)\n\nThus, the correct answer is D.",
      "hints": [
        "Write \\(a - d\\) \\(= (a - b) + (b - c) + (c - d)\\) \\(= \\pm 2 \\pm 3 \\pm 4\\)",
        "List the distinct values of \\(|\\pm 2 \\pm 3 \\pm 4|\\)"
      ],
      "images": []
    }
  ],
