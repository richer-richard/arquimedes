      "text": "\\(x\\lt1\\)"
    },
    {
      "label": "C",
      "text": "\\(|x|\\gt1\\)"
    },
    {
      "label": "D",
      "text": "\\(x\\lt-1\\)"
    },
    {
      "label": "E",
      "text": "\\(x\\lt-1\\) or \\(-1\\lt x\\lt1\\)"
    }
  ],
