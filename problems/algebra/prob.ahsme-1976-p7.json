  "estimatedMinutes": 2,
  "statement": "If \\(x\\) is a real number, then the quantity \\((1-|x|)(1+x)\\) is positive if and only if",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(|x|\\lt1\\)"
    },
