    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1976-p7.live",
      "kind": "proof-sketch",
      "text": "Both factors are positive exactly when \\(|x|\\lt1,\\) giving \\(-1\\lt x\\lt1.\\) Both are negative when \\(|x|\\gt1\\) and \\(x\\lt-1,\\) which reduces to \\(x\\lt-1.\\) The endpoints make the product zero.\n\nTherefore, the correct answer is E.",
      "hints": [
        "A product is positive when its two factors have the same sign",
        "Analyze the intervals cut by \\(-1\\) and \\(1\\)"
      ],
