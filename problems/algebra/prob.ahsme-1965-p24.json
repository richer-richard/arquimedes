  "estimatedMinutes": 1,
  "statement": "Given the sequence \\(10^{\\frac{1}{11}},\\) \\(10^{\\frac{2}{11}},\\) \\(10^{\\frac{3}{11}},\\) \\(\\ldots,\\) \\(10^{\\frac{n}{11}},\\) the smallest value of \\(n\\) such that the product of the first \\(n\\) members of this sequence exceeds \\(100{,}000\\) is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(7\\)"
    },
    {
      "label": "B",
      "text": "\\(8\\)"
    },
    {
      "label": "C",
      "text": "\\(9\\)"
    },
    {
      "label": "D",
      "text": "\\(10\\)"
    },
    {
      "label": "E",
      "text": "\\(11\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": "11"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1965-p24.live",
      "kind": "proof-sketch",
      "text": "The product is \\[ 10^{\\frac{1+2+\\cdots+n}{11}} =10^{\\frac{n(n+1)}{22}}. \\] To exceed \\(100{,}000=10^5,\\) we need \\(n(n+1)\\gt110.\\) At \\(n=10\\) equality holds, while \\(n=11\\) exceeds it.\n\nTherefore, the correct answer is E.",
      "hints": [
        "Add the exponents in the product",
        "Require \\(\\frac{n(n+1)}{22}\\gt5\\)"
      ],
      "images": []
    }
  ],
