  "estimatedMinutes": 1,
  "statement": "For all nonzero real numbers \\(x\\) and \\(y\\) such that \\(x-y=xy,\\) \\(\\frac1x-\\frac1y\\) equals",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\frac1{xy}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\frac1{x-y}\\)"
    },
    {
      "label": "C",
      "text": "\\(0\\)"
    },
    {
      "label": "D",
      "text": "\\(-1\\)"
    },
    {
      "label": "E",
      "text": "\\(y-x\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": "-1"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1979-p2.live",
      "kind": "proof-sketch",
      "text": "We have \\[ \\begin{aligned} \\frac1x-\\frac1y&=\\frac{y-x}{xy}\\\\ &=-\\frac{x-y}{xy}\\\\ &=-1, \\end{aligned} \\] because \\(x-y=xy.\\)\n\nTherefore, the correct answer is D.",
      "hints": [
        "Combine the two reciprocals over the denominator \\(xy\\)",
        "Use the given equation to replace \\(y-x\\)"
      ],
      "images": []
    }
  ],
