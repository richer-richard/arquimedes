  "solutions": [
    {
      "id": "sol.ahsme-1951-p31.live",
      "kind": "proof-sketch",
      "text": "With \\(n\\) people the number of handshakes is \\[ \\binom n2=\\frac{n(n-1)}2. \\] Thus \\(n(n-1)=56,\\) and the positive solution is \\(n=8.\\)\n\nThus, the correct answer is D.",
      "hints": [
        "With \\(n\\) people, each unordered pair shakes hands once",
        "Solve \\(\\binom n2=28\\)"
      ],
