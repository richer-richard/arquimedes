  "estimatedMinutes": 1,
  "statement": "A total of \\(28\\) handshakes was exchanged at the conclusion of a party. Assuming that each participant was equally polite toward all the others, the number of people present was:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(14\\)"
    },
    {
      "label": "B",
      "text": "\\(28\\)"
    },
