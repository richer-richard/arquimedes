  "estimatedMinutes": 1,
  "statement": "If \\(|x - 2| = p,\\) where \\(x \\lt 2,\\) then what is \\(x - p?\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(-2\\)"
    },
