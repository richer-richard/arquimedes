  "solutions": [
    {
      "id": "sol.ahsme-1957-p27.live",
      "kind": "proof-sketch",
      "text": "If the roots are \\(r,s,\\) then Vieta’s formulas give \\(r+s=-p\\) and \\(rs=q.\\) Therefore \\[ \\frac1r+\\frac1s=\\frac{r+s}{rs}=-\\frac pq. \\]\n\nThus, the correct answer is A.",
      "hints": [
        "Call the roots \\(r\\) and \\(s\\), and combine \\(\\frac{1}{r}+\\frac{1}{s}\\)",
        "Use \\(r+s=-p\\) and \\(rs=q\\)"
      ],
      "images": []
    }
  ],
