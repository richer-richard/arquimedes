  "estimatedMinutes": 1,
  "statement": "If \\(y=x^2+px+q,\\) then if the least possible value of \\(y\\) is zero, \\(q\\) is equal to:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(0\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{p^2}{4}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac p2\\)"
    },
    {
      "label": "D",
      "text": "\\(-\\dfrac p2\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{p^2}{4}-q\\)"
    }
  ],
  "answer": {
    "letter": "b",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1955-p39.live",
      "kind": "proof-sketch",
      "text": "Completing the square, \\[ y=\\left(x+\\frac p2\\right)^2+q-\\frac{p^2}{4}. \\] Its least value is \\(q-\\frac{p^2}{4}.\\) Setting this equal to zero gives \\(q=\\frac{p^2}{4}.\\)\n\nThus, the correct answer is B.",
      "hints": [
        "Complete the square in \\(x^2+px+q\\)",
        "The minimum occurs when \\(x=-\\frac{p}{2}\\)"
      ],
      "images": []
    }
  ],
