  "estimatedMinutes": 1,
  "statement": "The sum of two positive numbers is \\(5\\) times their difference. What is the ratio of the larger number to the smaller number?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{5}{4}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{3}{2}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{9}{5}\\)"
    },
    {
      "label": "D",
      "text": "\\(2\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{5}{2}\\)"
    }
  ],
  "answer": {
    "letter": "b",
    "value": "3/2"
