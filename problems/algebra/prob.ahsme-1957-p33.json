  "solutions": [
    {
      "id": "sol.ahsme-1957-p33.live",
      "kind": "proof-sketch",
      "text": "Factoring \\(9^x,\\) \\[ 81\\cdot9^x-9^x=240, \\] so \\(80\\cdot9^x=240\\) and \\(9^x=3.\\) Since \\(9^{\\frac{1}{2}}=3,\\) we have \\(x=\\frac{1}{2}=0.5.\\)\n\nTherefore, the correct answer is E.",
      "hints": [
        "Rewrite \\(9^{x+2}\\) as \\(81\\cdot9^x\\)",
        "After collecting like terms, express \\(9^x\\) as a power of \\(3\\)"
      ],
