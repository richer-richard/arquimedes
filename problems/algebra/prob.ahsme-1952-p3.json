  "estimatedMinutes": 1,
  "statement": "The expression \\(a^3-a^{-3}\\) equals:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\left(a-\\dfrac1a\\right)\\left(a^2+1+\\dfrac1{a^2}\\right)\\)"
    },
    {
      "label": "B",
      "text": "\\(\\left(\\dfrac1a-a\\right)\\left(a^2-1+\\dfrac1{a^2}\\right)\\)"
    },
    {
      "label": "C",
      "text": "\\(\\left(a-\\dfrac1a\\right)\\left(a^2-2+\\dfrac1{a^2}\\right)\\)"
    },
    {
      "label": "D",
      "text": "\\(\\left(\\dfrac1a-a\\right)\\left(\\dfrac1{a^2}+1+a^2\\right)\\)"
    },
    {
      "label": "E",
      "text": "None of these"
    }
  ],
  "answer": {
    "letter": "a",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1952-p3.live",
      "kind": "proof-sketch",
      "text": "Apply the difference-of-cubes identity with \\(u=a\\) and \\(v=\\frac{1}{a}.\\) Since \\(uv=1,\\) \\[ \\begin{aligned} a^3-\\frac1{a^3} &=\\left(a-\\frac1a\\right)\\\\ &\\quad{}\\cdot\\left(a^2+1+\\frac1{a^2}\\right). \\end{aligned} \\]\n\nThus, the correct answer is A.",
      "hints": [
        "View the expression as a difference of two cubes",
        "Use \\(u^3-v^3=(u-v)(u^2+uv+v^2)\\) with \\(v=\\frac{1}{a}\\)"
      ],
      "images": []
    }
  ],
