  "estimatedMinutes": 1,
  "statement": "What value of \\(x\\) satisfies \\[x- \\frac{3}{4} = \\frac{5}{12} - \\frac{1}{3}?\\]",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\displaystyle -\\frac{2}{3}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\displaystyle \\frac{7}{36}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\displaystyle \\frac{7}{12}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\displaystyle \\frac{2}{3}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\displaystyle \\frac{5}{6}\\)"
    }
  ],
  "answer": {
