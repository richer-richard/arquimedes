    "value": "5/6"
  },
  "solutions": [
    {
      "id": "sol.amc-10a-2020-p1.live",
      "kind": "proof-sketch",
      "text": "The right side is \\(\\dfrac{5}{12}-\\dfrac13=\\dfrac{5}{12}-\\dfrac4{12}=\\dfrac1{12}\\). Thus \\(x=\\dfrac34+\\dfrac1{12}=\\dfrac9{12}+\\dfrac1{12}=\\dfrac56\\). Thus, E is the correct answer.",
      "hints": [
        "First simplify the right side using denominator \\(12\\)",
        "After finding the right side, add \\(\\frac34\\) to both sides"
      ],
