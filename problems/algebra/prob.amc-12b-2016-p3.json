  "solutions": [
    {
      "id": "sol.amc-12b-2016-p3.live",
      "kind": "proof-sketch",
      "text": "Since \\(x=-2016,\\) \\(|x|=2016.\\) The innermost expression is \\(|x|-x=2016+2016=4032.\\) Then \\(\\big|4032\\big|-|x|=4032-2016\\) \\(=2016,\\) and the outer absolute value leaves \\(2016.\\) Finally subtracting \\(x\\) gives \\(2016-(-2016)=4032.\\)\n\nThus, the correct answer is D.",
      "hints": [
        "\\(|x|=2016,\\) and the innermost part is \\(|x|-x=2016-(-2016)\\)",
        "Simplify outward: \\(|x|-x=4032,\\) then \\(\\big|4032\\big|-|x|,\\) then the outer absolute value, and finally \\(-x\\)"
      ],
      "images": []
    }
  ],
