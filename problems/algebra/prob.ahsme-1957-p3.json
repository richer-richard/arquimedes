  "estimatedMinutes": 1,
  "statement": "The simplest form of \\(1-\\dfrac{1}{1+\\dfrac{a}{1-a}}\\) is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(a\\) if \\(a\\ne0\\)"
    },
    {
      "label": "B",
      "text": "\\(1\\)"
    },
    {
      "label": "C",
      "text": "\\(a\\) if \\(a\\ne-1\\)"
    },
    {
      "label": "D",
      "text": "\\(1-a\\) with no restriction on \\(a\\)"
    },
    {
      "label": "E",
      "text": "\\(a\\) if \\(a\\ne1\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": null
