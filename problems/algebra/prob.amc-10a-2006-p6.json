  "estimatedMinutes": 1,
  "statement": "What non-zero real value for \\(x\\) satisfies \\((7x)^{14} = (14x)^7?\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{1}{7}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{2}{7}\\)"
    },
