  "estimatedMinutes": 2,
  "statement": "If \\(a\\) and \\(b\\) are positive numbers such that \\(a^b=b^a\\) and \\(b=9a,\\) then the value of \\(a\\) is",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(9\\)"
    },
    {
      "label": "B",
      "text": "\\(\\frac19\\)"
    },
    {
      "label": "C",
      "text": "\\(\\sqrt[9]{9}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\sqrt[3]{9}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\sqrt[4]{3}\\)"
    }
  ],
