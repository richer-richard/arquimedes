  "estimatedMinutes": 1,
  "statement": "Three hexagons of increasing size are shown below. Suppose the dot pattern continues so that each successive hexagon contains one more band of dots. How many dots are in the next hexagon?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(35\\)"
    },
    {
      "label": "B",
      "text": "\\(37\\)"
    },
