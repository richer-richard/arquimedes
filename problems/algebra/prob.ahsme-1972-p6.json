  "estimatedMinutes": 1,
  "statement": "If \\(3^{2x}+9=10(3^x),\\) then the value of \\(x^2+1\\) is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(1\\) only"
    },
    {
      "label": "B",
      "text": "\\(5\\) only"
    },
    {
      "label": "C",
      "text": "\\(1\\) or \\(5\\)"
    },
    {
      "label": "D",
      "text": "\\(2\\)"
    },
    {
      "label": "E",
      "text": "\\(10\\)"
    }
  ],
  "answer": {
    "letter": "c",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1972-p6.live",
      "kind": "proof-sketch",
      "text": "Let \\(u=3^x.\\) Then \\[ \\begin{aligned} u^2-10u+9&=(u-1)(u-9)\\\\ &=0. \\end{aligned} \\] Thus \\(x=0\\) or \\(x=2,\\) so \\(x^2+1\\) is respectively \\(1\\) or \\(5.\\)\n\nTherefore, the correct answer is C.",
      "hints": [
        "Set \\(u=3^x\\)",
        "Factor \\(u^2-10u+9\\) and convert each positive root back to \\(x\\)"
      ],
      "images": []
    }
  ],
