  "estimatedMinutes": 2,
  "statement": "If \\[ \\begin{aligned} s={}&(1+2^{-\\frac{1}{32}})(1+2^{-\\frac{1}{16}})\\\\ &\\cdot(1+2^{-\\frac{1}{8}})(1+2^{-\\frac{1}{4}})\\\\ &\\cdot(1+2^{-\\frac{1}{2}}), \\end{aligned} \\] then \\(s\\) is equal to:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac12(1-2^{-\\frac{1}{32}})^{-1}\\)"
    },
    {
      "label": "B",
      "text": "\\((1-2^{-\\frac{1}{32}})^{-1}\\)"
    },
    {
      "label": "C",
      "text": "\\(1-2^{-\\frac{1}{32}}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac12(1-2^{-\\frac{1}{32}})\\)"
    },
    {
      "label": "E",
      "text": "\\(\\frac{1}{2}\\)"
    }
  ],
  "answer": {
    "letter": "a",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1971-p32.live",
      "kind": "proof-sketch",
      "text": "Let \\(x=2^{-\\frac{1}{32}}.\\) Then \\[ \\begin{aligned} (1-x)s&=1-x^{32}\\\\ &=1-\\frac12=\\frac12. \\end{aligned} \\] Therefore \\[ s=\\frac12(1-2^{-\\frac{1}{32}})^{-1}. \\]\n\nTherefore, the correct answer is A.",
      "hints": [
        "Set \\(x=2^{-\\frac{1}{32}}\\)",
        "Apply the difference-of-squares identity repeatedly through the factor \\(1+x^{16}\\)"
      ],
      "images": []
    }
  ],
