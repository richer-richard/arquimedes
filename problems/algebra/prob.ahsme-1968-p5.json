  "estimatedMinutes": 1,
  "statement": "If \\(f(n)=\\dfrac13n(n+1)(n+2),\\) then \\(f(r)-f(r-1)\\) equals:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(r(r+1)\\)"
    },
    {
      "label": "B",
      "text": "\\((r+1)(r+2)\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac13r(r+1)\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac13(r+1)(r+2)\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac13r(r+1)(r+2)\\)"
    }
  ],
  "answer": {
