    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1968-p5.live",
      "kind": "proof-sketch",
      "text": "We have \\(f(r)=\\frac13r(r+1)(r+2)\\) and \\(f(r-1)=\\frac13(r-1)r(r+1).\\) Factor their difference as \\(\\frac13r(r+1)\\) times \\((r+2)-(r-1)=3.\\) The result is \\(r(r+1).\\)\n\nTherefore, the correct answer is A.",
      "hints": [
        "Substitute \\(r\\) and \\(r-1\\) separately",
        "Factor out \\(\\frac13r(r+1)\\)"
      ],
      "images": []
    }
  ],
