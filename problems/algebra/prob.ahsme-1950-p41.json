  "estimatedMinutes": 1,
  "statement": "The least value of the function \\(ax^2+bx+c\\) with \\(a>0\\) is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(-\\dfrac ba\\)"
    },
    {
      "label": "B",
      "text": "\\(-\\dfrac{b}{2a}\\)"
    },
    {
      "label": "C",
      "text": "\\(b^2-4ac\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{4ac-b^2}{4a}\\)"
    },
    {
      "label": "E",
      "text": "None of these"
    }
  ],
  "answer": {
    "letter": "d",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1950-p41.live",
      "kind": "proof-sketch",
      "text": "Completing the square gives \\[ \\begin{aligned} ax^2+bx+c &=a\\left(x+\\frac{b}{2a}\\right)^2\\\\ &\\quad+c-\\frac{b^2}{4a}. \\end{aligned} \\] Because \\(a>0,\\) the squared term has minimum \\(0.\\) The least value is therefore \\[ c-\\frac{b^2}{4a}=\\frac{4ac-b^2}{4a}. \\]\n\nThus, the correct answer is D.",
      "hints": [
        "Complete the square in \\(ax^2+bx+c\\)",
        "Since \\(a>0,\\) the squared term is minimized when it equals zero"
      ],
      "images": []
    }
  ],
