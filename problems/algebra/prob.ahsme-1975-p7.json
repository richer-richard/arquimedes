  "estimatedMinutes": 1,
  "statement": "For which nonzero real numbers \\(x\\) is \\(\\frac{|x-|x||}{x}\\) a positive integer?",
  "answerChoices": [
    {
      "label": "A",
      "text": "for negative \\(x\\) only"
    },
    {
      "label": "B",
      "text": "for positive \\(x\\) only"
    },
    {
      "label": "C",
      "text": "only for \\(x\\) an even integer"
    },
    {
      "label": "D",
      "text": "for all nonzero real numbers \\(x\\)"
    },
    {
      "label": "E",
      "text": "for no nonzero real numbers \\(x\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1975-p7.live",
      "kind": "proof-sketch",
      "text": "If \\(x\\gt0,\\) the quotient is \\(0.\\) If \\(x\\lt0,\\) then \\(x-|x|=2x\\lt0,\\) so \\(|x-|x||=-2x\\) and the quotient is \\(-2.\\) Neither value is a positive integer.\n\nTherefore, the correct answer is E.",
      "hints": [
        "Evaluate the quotient separately for \\(x\\gt0\\) and \\(x\\lt0\\)",
        "For \\(x\\lt0,\\) replace \\(|x|\\) by \\(-x\\) before evaluating the outer absolute value"
      ],
      "images": []
    }
  ],
