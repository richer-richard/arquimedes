  "estimatedMinutes": 1,
  "statement": "The number of values of \\(x\\) satisfying the equation\n\n\\[ \\frac{2x^2-10x}{x^2-5x}=x-3 \\]\n\nis:",
  "answerChoices": [
    {
      "label": "A",
      "text": "zero"
    },
    {
      "label": "B",
      "text": "one"
    },
    {
      "label": "C",
      "text": "two"
    },
    {
      "label": "D",
      "text": "three"
    },
    {
      "label": "E",
      "text": "an integer greater than \\(3\\)"
    }
  ],
  "answer": {
    "letter": "a",
    "value": "0"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1966-p5.live",
      "kind": "proof-sketch",
      "text": "The denominator requires \\(x\\ne0\\) and \\(x\\ne5.\\) On that domain, \\[ \\frac{2x(x-5)}{x(x-5)}=2. \\] The remaining equation \\(2=x-3\\) gives \\(x=5,\\) which is excluded. Thus there are no solutions.\n\nTherefore, the correct answer is A.",
      "hints": [
        "Factor numerator and denominator before solving",
        "Do not admit values that make the original denominator zero"
      ],
