  "estimatedMinutes": 1,
  "statement": "If \\(P=\\dfrac{s}{(1+k)^n},\\) then \\(n\\) equals:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{\\log(\\frac{s}{P})}{\\log(1+k)}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\log\\dfrac{s}{P(1+k)}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\log\\dfrac{s-P}{1+k}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\log\\dfrac{s}{P}+\\log(1+k)\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{\\log s}{\\log(P(1+k))}\\)"
    }
  ],
  "answer": {
    "letter": "a",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1958-p12.live",
      "kind": "proof-sketch",
      "text": "Taking logarithms, \\[ \\log P=\\log s-n\\log(1+k). \\] Therefore \\[ n=\\frac{\\log s-\\log P}{\\log(1+k)} =\\frac{\\log(\\frac{s}{P})}{\\log(1+k)}. \\]\n\nThus, the correct answer is A.",
      "hints": [
        "Take logarithms of both sides of the equation",
        "Use \\(\\log P=\\log s-n\\log(1+k)\\) and isolate \\(n\\)"
      ],
      "images": []
    }
  ],
