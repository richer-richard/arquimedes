  "estimatedMinutes": 1,
  "statement": "If \\(b\\) men take \\(c\\) days to lay \\(f\\) bricks, then the number of days it will take \\(c\\) men working at the same rate to lay \\(b\\) bricks is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(fb^2\\)"
    },
    {
      "label": "B",
      "text": "\\(\\frac{b}{f^2}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\frac{f^2}{b}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\frac{b^2}{f}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\frac{f}{b^2}\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1971-p2.live",
      "kind": "proof-sketch",
      "text": "The rate is \\(\\frac{f}{bc}\\) bricks per man-day. Thus \\(c\\) men lay \\(\\frac{f}{b}\\) bricks per day, so laying \\(b\\) bricks takes \\[ \\frac{b}{\\frac{f}{b}}=\\frac{b^2}{f} \\] days.\n\nTherefore, the correct answer is D.",
      "hints": [
        "Find the number of bricks laid by one man in one day",
        "The rate is \\(\\frac{f}{bc}\\) bricks per man-day"
      ],
