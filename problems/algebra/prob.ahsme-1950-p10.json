  "estimatedMinutes": 1,
  "statement": "After rationalizing the numerator of \\(\\dfrac{\\sqrt3-\\sqrt2}{\\sqrt3},\\) the denominator in simplest form is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\sqrt3(\\sqrt3+\\sqrt2)\\)"
    },
    {
      "label": "B",
      "text": "\\(\\sqrt3(\\sqrt3-\\sqrt2)\\)"
    },
    {
      "label": "C",
      "text": "\\(3-\\sqrt3\\sqrt2\\)"
    },
    {
      "label": "D",
      "text": "\\(3+\\sqrt6\\)"
    },
    {
      "label": "E",
      "text": "None of these answers"
    }
  ],
  "answer": {
    "letter": "d",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1950-p10.live",
      "kind": "proof-sketch",
      "text": "Multiplying by the conjugate of the numerator gives \\[ \\begin{aligned} &\\frac{\\sqrt3-\\sqrt2}{\\sqrt3} \\cdot\\frac{\\sqrt3+\\sqrt2}{\\sqrt3+\\sqrt2}\\\\ &=\\frac{1}{\\sqrt3(\\sqrt3+\\sqrt2)}\\\\ &=\\frac{1}{3+\\sqrt6}. \\end{aligned} \\]\n\nThus, the correct answer is D.",
      "hints": [
        "Multiply the numerator and denominator by the conjugate of the numerator",
        "The numerator becomes \\((\\sqrt3-\\sqrt2)(\\sqrt3+\\sqrt2)=1\\)"
      ],
      "images": []
    }
  ],
