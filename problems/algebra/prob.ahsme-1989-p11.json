  "solutions": [
    {
      "id": "sol.ahsme-1989-p11.live",
      "kind": "proof-sketch",
      "text": "The largest possible values are \\(d=99,\\ c=395,\\ b=1184,\\) and finally \\(a=2367.\\) Each value satisfies its strict inequality, so this maximum is attainable.\n\nThus the correct answer is A.",
      "hints": [
        "Maximize the integers from \\(d\\) backward to \\(a\\)",
        "Each strict inequality lowers the greatest allowable integer by \\(1\\)"
