  "solutions": [
    {
      "id": "sol.ahsme-1965-p34.live",
      "kind": "proof-sketch",
      "text": "Let \\(t=x+1\\geq1.\\) Since \\(4x^2+8x+13=4t^2+9,\\) the expression is \\[\\frac23t+\\frac{3}{2t}.\\] By AM-GM this is at least \\(2\\sqrt{(\\frac{2}{3})(\\frac{3}{2})}=2,\\) with equality at \\(t=\\frac{3}{2},\\) which is allowed.\n\nTherefore, the correct answer is B.",
      "hints": [
        "Set \\(t=x+1\\geq1\\)",
        "Rewrite the expression as \\(\\frac23t+\\frac{3}{2t}\\)"
      ],
      "images": []
    }
