  "estimatedMinutes": 1,
  "statement": "Of the following expressions, the one equal to \\(\\dfrac{a^{-1}b^{-1}}{a^{-3}-b^{-3}}\\) is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{a^2b^2}{b^2-a^2}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{a^2b^2}{b^3-a^3}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{ab}{b^3-a^3}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{a^3-b^3}{ab}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{a^2b^2}{a-b}\\)"
    }
  ],
  "answer": {
    "letter": "b",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1958-p3.live",
      "kind": "proof-sketch",
      "text": "We have \\[ a^{-3}-b^{-3} =\\frac{b^3-a^3}{a^3b^3}. \\] Hence \\[ \\frac{\\frac{1}{ab}}{\\frac{b^3-a^3}{a^3b^3}} =\\frac{a^2b^2}{b^3-a^3}. \\]\n\nThus, the correct answer is B.",
      "hints": [
        "Rewrite every negative power as a reciprocal",
        "Express \\(a^{-3}-b^{-3}\\) over the common denominator \\(a^3b^3\\)"
      ],
      "images": []
    }
  ],
