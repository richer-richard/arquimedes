  "solutions": [
    {
      "id": "sol.ahsme-1959-p12.live",
      "kind": "proof-sketch",
      "text": "The geometric-progression condition is \\[ (50+c)^2=(20+c)(100+c). \\] Expanding and cancelling \\(c^2\\) gives \\(500=20c,\\) so \\(c=25.\\) The common ratio is \\[ \\frac{50+25}{20+25}=\\frac{75}{45}=\\frac53. \\]\n\nThus, the correct answer is A.",
      "hints": [
        "Let \\(c\\) be the added constant",
        "For three consecutive geometric terms, the square of the middle term equals the product of the outer terms"
      ],
      "images": []
    }
  ],
