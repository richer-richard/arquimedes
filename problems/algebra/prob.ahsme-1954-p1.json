  "estimatedMinutes": 1,
  "statement": "The square of \\(5-\\sqrt{y^2-25}\\) is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(y^2-5\\sqrt{y^2-25}\\)"
    },
    {
      "label": "B",
      "text": "\\(-y^2\\)"
    },
    {
      "label": "C",
      "text": "\\(y^2\\)"
    },
    {
      "label": "D",
      "text": "\\((5-y)^2\\)"
    },
    {
      "label": "E",
      "text": "\\(y^2-10\\sqrt{y^2-25}\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": null
