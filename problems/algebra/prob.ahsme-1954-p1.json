  "solutions": [
    {
      "id": "sol.ahsme-1954-p1.live",
      "kind": "proof-sketch",
      "text": "Expanding gives \\[ \\begin{aligned} &\\left(5-\\sqrt{y^2-25}\\right)^2\\\\ &\\quad=25-10\\sqrt{y^2-25}\\\\ &\\qquad{}+y^2-25\\\\ &\\quad=y^2-10\\sqrt{y^2-25}. \\end{aligned} \\]\n\nThus, the correct answer is E.",
      "hints": [
        "Use \\((a-b)^2=a^2-2ab+b^2\\)",
        "The constant \\(25\\) cancels with the \\(-25\\) inside the squared radical"
      ],
      "images": []
    }
  ],
