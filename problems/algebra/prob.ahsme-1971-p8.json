  "estimatedMinutes": 1,
  "statement": "The solution set of \\(6x^2+5x\\lt4\\) is the set of all values of \\(x\\) such that:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(-2\\lt x\\lt1\\)"
    },
    {
      "label": "B",
      "text": "\\(-\\dfrac43\\lt x\\lt\\dfrac12\\)"
    },
    {
      "label": "C",
      "text": "\\(-\\dfrac12\\lt x\\lt\\dfrac43\\)"
    },
    {
      "label": "D",
      "text": "\\(x\\lt\\dfrac12\\) or \\(x\\gt-\\dfrac43\\)"
    },
    {
      "label": "E",
      "text": "\\(x\\lt-\\dfrac43\\) or \\(x\\gt\\dfrac12\\)"
    }
  ],
  "answer": {
    "letter": "b",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1971-p8.live",
      "kind": "proof-sketch",
      "text": "The inequality is \\[ \\begin{aligned} 6x^2+5x-4&\\lt0,\\\\ (3x+4)(2x-1)&\\lt0. \\end{aligned} \\] The roots are \\(-\\frac{4}{3}\\) and \\(\\frac{1}{2},\\) and the upward-opening quadratic is negative between them.\n\nTherefore, the correct answer is B.",
      "hints": [
        "Move \\(4\\) to the left and factor",
        "The product \\((3x+4)(2x-1)\\) is negative between its roots"
      ],
      "images": []
    }
  ],
