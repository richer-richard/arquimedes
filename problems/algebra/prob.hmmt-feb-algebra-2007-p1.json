    {
      "id": "sol.hmmt-feb-algebra-2007-p1.hmmt",
      "kind": "proof-sketch",
      "text": "2006. We have\n\n\\[\\left\\lfloor\\frac{2007!+2004!}{2006!+2005!}\\right\\rfloor=\\left\\lfloor\\frac{\\left(2007 \\cdot 2006+\\frac{1}{2005}\\right) \\cdot 2005!}{(2006+1) \\cdot 2005!}\\right\\rfloor=\\left\\lfloor\\frac{2007 \\cdot 2006+\\frac{1}{2005}}{2007}\\right\\rfloor=\\left\\lfloor 2006+\\frac{1}{2005 \\cdot 2007}\\right\\rfloor\\]",
