  "solutions": [
    {
      "id": "sol.ahsme-1950-p25.live",
      "kind": "proof-sketch",
      "text": "Since \\(125=5^3,\\) \\(625=5^4,\\) and \\(25=5^2,\\) \\[ \\begin{aligned} &\\log_5\\frac{(125)(625)}{25}\\\\ &=\\log_5\\left(5^{3+4-2}\\right)\\\\ &=\\log_5(5^5)=5. \\end{aligned} \\]\n\nThus, the correct answer is D.",
      "hints": [
        "Write \\(125,\\) \\(625,\\) and \\(25\\) as powers of \\(5\\)",
        "The logarithm’s argument simplifies to \\(5^{3+4-2}\\)"
      ],
      "images": []
    }
  ],
