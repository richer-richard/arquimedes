  "solutions": [
    {
      "id": "sol.ahsme-1965-p23.live",
      "kind": "proof-sketch",
      "text": "For \\(1.99\\lt x\\lt2.01,\\) \\[ \\begin{gathered} |x^2-4|=|x-2||x+2|\\\\ \\lt(0.01)(4.01)=0.0401. \\end{gathered} \\] Values with \\(x\\) arbitrarily close to \\(2.01\\) make the expression arbitrarily close to \\(0.0401,\\) so no smaller bound works.\n\nTherefore, the correct answer is D.",
      "hints": [
        "Factor \\(|x^2-4|=|x-2||x+2|\\)",
        "The larger one-sided bound occurs as \\(x\\) approaches \\(2.01\\)"
      ],
      "images": []
    }
  ],
