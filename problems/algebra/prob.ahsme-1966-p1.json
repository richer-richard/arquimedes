      "label": "A",
      "text": "\\(\\dfrac18\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac87\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac73\\)"
    },
    {
