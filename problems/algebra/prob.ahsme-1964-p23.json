    "value": "48"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1964-p23.live",
      "kind": "proof-sketch",
      "text": "Let the difference be \\(k\\) and the sum be \\(7k.\\) The numbers are \\(4k\\) and \\(3k,\\) so their product is \\(12k^2.\\) But the ratio also says the product is \\(24k.\\) For distinct numbers \\(k\\ne0,\\) so \\(k=2\\) and the product is \\(48.\\)\n\nTherefore, the correct answer is D.",
      "hints": [
        "Represent the difference, sum, and product by \\(k,\\) \\(7k,\\) and \\(24k\\)",
        "The two numbers are \\(\\frac{7k+k}{2}\\) and \\(\\frac{7k-k}{2}\\)"
      ],
      "images": []
    }
  ],
