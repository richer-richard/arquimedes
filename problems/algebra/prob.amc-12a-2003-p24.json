  "estimatedMinutes": 2,
  "statement": "If \\(a \\ge b \\gt 1,\\) what is the largest possible value of \\(\\log_a(\\frac{a}{b}) + \\log_b(\\frac{b}{a})?\\)",
  "answerChoices": [
    {
      "label": "A",
