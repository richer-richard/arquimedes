  "solutions": [
    {
      "id": "sol.ahsme-1972-p7.live",
      "kind": "proof-sketch",
      "text": "The requested ratio has quotient \\[ \\frac{\\frac{x}{yz}}{\\frac{y}{zx}}=\\frac{x^2}{y^2}. \\] Also \\(yz:zx=y:x=1:2,\\) so \\(x:y=2:1.\\) Therefore \\(x^2:y^2=4:1.\\)\n\nTherefore, the correct answer is E.",
      "hints": [
        "Simplify the quotient of the two fractions in the requested ratio",
        "From \\(yz:zx=1:2\\), obtain \\(y:x=1:2\\)"
      ],
