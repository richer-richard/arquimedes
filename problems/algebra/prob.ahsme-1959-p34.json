  },
  "solutions": [
    {
      "id": "sol.ahsme-1959-p34.live",
      "kind": "proof-sketch",
      "text": "Vieta’s formulas give \\(r+s=3\\) and \\(rs=1.\\) Therefore \\[ \\begin{aligned} r^2+s^2 &=(r+s)^2-2rs\\\\ &=9-2=7, \\end{aligned} \\] which is a positive integer.\n\nThus, the correct answer is A.",
      "hints": [
        "Use \\(r+s=3\\) and \\(rs=1\\)",
        "Rewrite \\(r^2+s^2\\) as \\((r+s)^2-2rs\\)"
      ],
      "images": []
    }
  ],
