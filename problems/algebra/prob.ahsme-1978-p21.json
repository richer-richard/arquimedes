  "estimatedMinutes": 2,
  "statement": "For all positive numbers \\(x\\) distinct from \\(1,\\) \\[ \\frac1{\\log_3x}+\\frac1{\\log_4x}+\\frac1{\\log_5x} \\] equals",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\frac1{\\log_{60}x}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\frac1{\\log_x60}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\frac1{(\\log_3x)(\\log_4x)(\\log_5x)}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\frac{12}{(\\log_3x)+(\\log_4x)+(\\log_5x)}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\frac{\\log_2x}{(\\log_3x)(\\log_5x)}\\)\n\n\\({}+\\frac{\\log_3x}{(\\log_2x)(\\log_5x)}\\)\n\n\\({}+\\frac{\\log_5x}{(\\log_2x)(\\log_3x)}\\)"
    }
  ],
  "answer": {
    "letter": "a",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1978-p21.live",
      "kind": "proof-sketch",
      "text": "Let \\(S\\) denote the given sum. Changing bases and combining logarithms gives \\[ \\begin{aligned} S&=\\frac1{\\log_3x}+\\frac1{\\log_4x}\\\\ &\\quad+\\frac1{\\log_5x}\\\\ &=\\log_x(3\\cdot4\\cdot5)\\\\ &=\\log_x60\\\\ &=\\frac1{\\log_{60}x}. \\end{aligned} \\]\n\nTherefore, the correct answer is A.",
      "hints": [
        "Use the reciprocal identity \\(\\frac{1}{\\log_bx}=\\log_xb\\)",
        "Combine the resulting sum with the product rule for logarithms"
      ],
      "images": []
    }
  ],
