  "estimatedMinutes": 1,
  "statement": "If \\(\\log_{10}(x^2-3x+6)=1,\\) the value of \\(x\\) is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(10\\) or \\(2\\)"
    },
    {
      "label": "B",
      "text": "\\(4\\) or \\(-2\\)"
    },
    {
      "label": "C",
      "text": "\\(3\\) or \\(-1\\)"
    },
    {
      "label": "D",
      "text": "\\(4\\) or \\(-1\\)"
    },
    {
      "label": "E",
      "text": "none of these"
    }
  ],
