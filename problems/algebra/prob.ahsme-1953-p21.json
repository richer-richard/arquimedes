  "solutions": [
    {
      "id": "sol.ahsme-1953-p21.live",
      "kind": "proof-sketch",
      "text": "The logarithmic equation is equivalent to \\[ x^2-3x+6=10, \\] so \\[ \\begin{aligned} x^2-3x-4&=(x-4)(x+1)\\\\ &=0. \\end{aligned} \\] Thus \\(x=4\\) or \\(x=-1.\\)\n\nThe correct answer is D.",
      "hints": [
        "Convert the logarithmic equation to \\(x^2-3x+6=10\\)",
        "Factor the resulting quadratic"
      ],
