  "solutions": [
    {
      "id": "sol.amc-12a-2004-p10.live",
      "kind": "proof-sketch",
      "text": "The sum of a set of consecutive integers equals the number of terms times their mean, and for consecutive integers the mean equals the median.\n\nSo the median is \\[ \\dfrac{7^5}{49} = \\dfrac{7^5}{7^2} = 7^3 = 343. \\]\n\nThus, the correct answer is C.",
      "hints": [
        "For consecutive integers the median equals the mean",
        "The median is the sum divided by the number of terms, \\(\\dfrac{7^5}{49}\\)"
      ],
