  "estimatedMinutes": 2,
  "statement": "The sum of the first \\(n\\) terms of the sequence \\[ \\begin{gathered} 1,\\ (1+2),\\ (1+2+2^2),\\\\ \\ldots,\\ (1+2+2^2+\\cdots+2^{n-1}) \\end{gathered} \\] in terms of \\(n\\) is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(2^n\\)"
    },
    {
      "label": "B",
      "text": "\\(2^n-n\\)"
    },
    {
      "label": "C",
      "text": "\\(2^{n+1}-n\\)"
    },
    {
      "label": "D",
      "text": "\\(2^{n+1}-n-2\\)"
    },
    {
      "label": "E",
      "text": "\\(n\\cdot2^n\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1972-p19.live",
      "kind": "proof-sketch",
      "text": "The \\(k\\)-th term is the geometric sum \\(2^k-1.\\) Therefore the desired total is \\[ \\begin{aligned} \\sum_{k=1}^n(2^k-1) &=(2^{n+1}-2)-n\\\\ &=2^{n+1}-n-2. \\end{aligned} \\]\n\nTherefore, the correct answer is D.",
      "hints": [
        "The \\(k\\)-th parenthesized sum is \\(2^k-1\\)",
        "Sum \\(2^1-1,\\) \\(2^2-1,\\) \\(\\ldots,\\) and \\(2^n-1\\)"
      ],
      "images": []
    }
