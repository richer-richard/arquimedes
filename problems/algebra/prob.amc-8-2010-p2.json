  "estimatedMinutes": 1,
  "statement": "If \\(a \\ast b = \\dfrac{a\\times b}{a+b}\\) for \\(a,\\) \\(b\\) positive integers, then what is \\(5 \\ast 10?\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\( \\ \\dfrac{3}{10} \\)"
    },
    {
      "label": "B",
      "text": "\\( \\ 1 \\)"
    },
    {
      "label": "C",
      "text": "\\( \\ 2 \\)"
    },
    {
      "label": "D",
      "text": "\\( \\ \\dfrac{10}{3} \\)"
    },
    {
      "label": "E",
      "text": "\\( \\ 50 \\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": "10/3"
  },
  "solutions": [
    {
      "id": "sol.amc-8-2010-p2.live",
      "kind": "proof-sketch",
      "text": "Given our definition of \\(a\\ast b,\\) we have \\[5 \\ast 10 = \\dfrac{5 \\times 10}{5 + 10} = \\dfrac{50}{15} = \\dfrac{10}{3}.\\]\n\nThus, the answer is D .",
      "hints": [
        "Reduce \\(\\frac{50}{15}\\) after adding the denominator.",
        "Substitute the two given numbers into the definition of \\(a\\ast b\\)."
      ],
