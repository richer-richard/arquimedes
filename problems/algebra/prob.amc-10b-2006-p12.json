  "estimatedMinutes": 1,
  "statement": "The lines \\(x=\\tfrac14 y+a\\) and \\(y=\\tfrac14 x+b\\) intersect at the point \\((1,2).\\) What is \\(a+b?\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(0\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{3}{4}\\)"
    },
    {
      "label": "C",
      "text": "\\(1\\)"
    },
    {
      "label": "D",
      "text": "\\(2\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{9}{4}\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": "9/4"
  },
  "solutions": [
    {
      "id": "sol.amc-10b-2006-p12.live",
      "kind": "proof-sketch",
      "text": "Substituting \\((1,2)\\): from \\(1=\\tfrac14(2)+a\\) we get \\(a=\\tfrac12,\\) and from \\(2=\\tfrac14(1)+b\\) we get \\(b=\\tfrac74.\\)\n\nThen \\(a+b=\\tfrac12+\\tfrac74=\\tfrac94.\\)\n\nThus, the correct answer is E.",
      "hints": [
        "Substitute \\((1,2)\\) into both equations",
        "Add the two resulting equations to get \\(a+b\\) directly"
      ],
      "images": []
    }
  ],
