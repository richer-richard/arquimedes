  "estimatedMinutes": 1,
  "statement": "The cost \\(C\\) of sending a parcel post package weighing \\(P\\) pounds, \\(P\\) an integer, is \\(10\\) cents for the first pound and \\(3\\) cents for each additional pound. The formula for the cost is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(C=10+3P\\)"
    },
    {
      "label": "B",
      "text": "\\(C=10P+3\\)"
    },
    {
      "label": "C",
      "text": "\\(C=10+3(P-1)\\)"
    },
    {
      "label": "D",
      "text": "\\(C=9+3P\\)"
    },
    {
      "label": "E",
      "text": "\\(C=10P-7\\)"
    }
  ],
  "answer": {
    "letter": "c",
