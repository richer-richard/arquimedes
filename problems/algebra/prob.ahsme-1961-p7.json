  "estimatedMinutes": 1,
  "statement": "When simplified, the third term in the expansion of \\[ \\left(\\frac{a}{\\sqrt{x}}-\\frac{\\sqrt{x}}{a^2}\\right)^6 \\] is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{15}{x}\\)"
    },
    {
      "label": "B",
      "text": "\\(-\\dfrac{15}{x}\\)"
    },
    {
      "label": "C",
      "text": "\\(-\\dfrac{6x^2}{a^9}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{20}{a^3}\\)"
    },
    {
      "label": "E",
      "text": "\\(-\\dfrac{20}{a^3}\\)"
    }
  ],
  "answer": {
    "letter": "a",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1961-p7.live",
      "kind": "proof-sketch",
      "text": "The third term is \\[ \\begin{aligned} &\\binom62\\left(\\frac a{\\sqrt x}\\right)^4 \\left(-\\frac{\\sqrt x}{a^2}\\right)^2\\\\ &\\qquad=15\\cdot\\frac{a^4}{x^2}\\cdot\\frac{x}{a^4} =\\frac{15}{x}. \\end{aligned} \\]\n\nTherefore, the correct answer is A.",
      "hints": [
        "The third term uses two copies of the second binomial term",
        "Use the coefficient \\(\\binom62\\) and simplify the powers of \\(a\\) and \\(x\\)"
      ],
      "images": []
    }
  ],
