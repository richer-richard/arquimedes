  "estimatedMinutes": 1,
  "statement": "The values of \\(k\\) for which the equation \\(2x^2-kx+x+8=0\\) will have real and equal roots are:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(9\\) and \\(-7\\)"
    },
    {
      "label": "B",
      "text": "only \\(-7\\)"
    },
    {
      "label": "C",
      "text": "\\(9\\) and \\(7\\)"
    },
    {
      "label": "D",
      "text": "\\(-9\\) and \\(-7\\)"
    },
    {
      "label": "E",
      "text": "only \\(9\\)"
    }
