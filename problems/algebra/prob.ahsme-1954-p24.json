  "solutions": [
    {
      "id": "sol.ahsme-1954-p24.live",
      "kind": "proof-sketch",
      "text": "A repeated real root requires \\[ (1-k)^2-4(2)(8)=0. \\] Thus \\((1-k)^2=64,\\) so \\(1-k=\\pm8.\\) The two values are \\(k=9\\) and \\(k=-7.\\)\n\nThus, the correct answer is A.",
      "hints": [
        "Combine the linear terms to write the coefficient of \\(x\\) as \\(1-k\\)",
        "Set the discriminant \\((1-k)^2-64\\) equal to zero"
      ],
      "images": []
    }
  ],
