  "solutions": [
    {
      "id": "sol.ahsme-1951-p41.live",
      "kind": "proof-sketch",
      "text": "The \\(y\\)-values factor naturally as \\[ \\begin{gathered} 0=1\\cdot0,\\quad 2=2\\cdot1,\\quad 6=3\\cdot2,\\\\ 12=4\\cdot3,\\quad 20=5\\cdot4. \\end{gathered} \\] Thus \\(y=(x-1)(x-2)\\) and hence \\(y=x^2-3x+2.\\)\n\nThus, the correct answer is B.",
      "hints": [
        "The first differences \\(2,4,6,8\\) suggest a quadratic rule",
        "The values are \\((x-1)(x-2)\\)"
      ],
