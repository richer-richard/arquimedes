  "estimatedMinutes": 1,
  "statement": "A positive number \\(x\\) satisfies the inequality \\(\\sqrt x\\lt2x\\) if and only if",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(x\\gt\\frac14\\)"
    },
    {
      "label": "B",
      "text": "\\(x\\gt2\\)"
    },
    {
      "label": "C",
      "text": "\\(x\\gt4\\)"
    },
    {
      "label": "D",
      "text": "\\(x\\lt\\frac14\\)"
    },
    {
      "label": "E",
      "text": "\\(x\\lt4\\)"
    }
  ],
  "answer": {
    "letter": "a",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1980-p6.live",
      "kind": "proof-sketch",
      "text": "Because \\(x\\gt0,\\) division by \\(\\sqrt x\\) preserves the inequality: \\[ 1\\lt2\\sqrt x. \\] Thus \\(\\sqrt x\\gt\\frac{1}{2},\\) which is equivalent to \\(x\\gt\\frac{1}{4}.\\)\n\nTherefore, the correct answer is A.",
      "hints": [
        "Use the fact that both sides are positive",
        "Divide by \\(\\sqrt x\\) before squaring or isolating \\(x\\)"
      ],
      "images": []
    }
  ],
