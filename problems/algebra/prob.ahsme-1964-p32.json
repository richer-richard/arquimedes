  "estimatedMinutes": 1,
  "statement": "If \\(\\dfrac{a+b}{b+c}=\\dfrac{c+d}{d+a},\\) then:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(a\\) must equal \\(c\\)"
    },
    {
      "label": "B",
      "text": "\\(a+b+c+d\\) must equal zero"
    },
    {
      "label": "C",
      "text": "either \\(a=c\\) or \\(a+b+c+d=0,\\) or both"
    },
    {
      "label": "D",
      "text": "\\(a+b+c+d\\ne0\\) if \\(a=c\\)"
    },
    {
      "label": "E",
      "text": "\\(a(b+c+d)=c(a+b+d)\\)"
    }
  ],
  "answer": {
    "letter": "c",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1964-p32.live",
      "kind": "proof-sketch",
      "text": "Cross-multiplication gives \\((a+b)(a+d)=(b+c)(c+d).\\) Subtracting the right side and factoring yields \\[(a-c)(a+b+c+d)=0.\\] Hence either \\(a=c\\) or the sum is zero, and both may occur.\n\nTherefore, the correct answer is C.",
      "hints": [
        "Cross-multiply the two fractions",
        "Move all terms to one side and factor out \\(a-c\\)"
      ],
      "images": []
    }
  ],
