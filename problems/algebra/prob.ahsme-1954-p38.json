  "solutions": [
    {
      "id": "sol.ahsme-1954-p38.live",
      "kind": "proof-sketch",
      "text": "The equation reduces to \\(3^x=5,\\) so \\[ \\begin{aligned} x&=\\frac{\\log5}{\\log3}\\\\ &=\\frac{1-\\log2}{\\log3}\\\\ &=\\frac{0.6990}{0.4771}\\\\ &\\approx1.47. \\end{aligned} \\]\n\nThus, the correct answer is B.",
      "hints": [
        "Divide by \\(3^3\\) to obtain \\(3^x=5\\)",
        "Use \\(\\log5=1-\\log2\\) and divide by \\(\\log3\\)"
      ],
      "images": []
    }
  ],
