  "estimatedMinutes": 1,
  "statement": "The sum of the reciprocals of the roots of the equation \\(ax^2+bx+c=0\\) is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac1a+\\dfrac1b\\)"
    },
    {
      "label": "B",
      "text": "\\(-\\dfrac cb\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac bc\\)"
    },
    {
      "label": "D",
      "text": "\\(-\\dfrac ab\\)"
    },
    {
      "label": "E",
      "text": "\\(-\\dfrac bc\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1965-p7.live",
      "kind": "proof-sketch",
      "text": "By Vieta’s formulas, \\(r+s=-\\frac{b}{a}\\) and \\(rs=\\frac{c}{a}.\\) Therefore \\[ \\begin{aligned} \\frac1r+\\frac1s &=\\frac{r+s}{rs}\\\\ &=\\frac{-\\frac{b}{a}}{\\frac{c}{a}}=-\\frac bc. \\end{aligned} \\]\n\nThus, the correct answer is E.",
      "hints": [
        "If the roots are \\(r,s,\\) then \\(\\frac{1}{r}+\\frac{1}{s}=\\frac{r+s}{rs}\\)",
        "Use \\(r+s=-\\frac{b}{a}\\) and \\(rs=\\frac{c}{a}\\)"
      ],
      "images": []
    }
  ],
