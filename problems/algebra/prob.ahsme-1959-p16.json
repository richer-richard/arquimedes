  "estimatedMinutes": 1,
  "statement": "The expression \\[ \\frac{x^2-3x+2}{x^2-5x+6}\\div \\frac{x^2-5x+4}{x^2-7x+12}, \\] when simplified, is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{(x-1)(x-6)}{(x-3)(x-4)}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{x+3}{x-3}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{x+1}{x-1}\\)"
    },
    {
      "label": "D",
      "text": "\\(1\\)"
    },
    {
      "label": "E",
      "text": "\\(2\\)"
    }
  ],
