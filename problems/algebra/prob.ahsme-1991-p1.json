  "solutions": [
    {
      "id": "sol.ahsme-1991-p1.live",
      "kind": "proof-sketch",
      "text": "Direct substitution gives \\[ \\begin{aligned} \\boxed{1,-2,-3} &=\\frac{-3+1}{-3-(-2)}\\\\ &=\\frac{-2}{-1}=2. \\end{aligned} \\]\n\nThus the correct answer is E.",
      "hints": [
        "Substitute \\(a=1,\\) \\(b=-2,\\) and \\(c=-3\\) into the definition",
        "Be careful with the two negative signs in the denominator"
      ],
