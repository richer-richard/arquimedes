  "solutions": [
    {
      "id": "sol.ahsme-1957-p9.live",
      "kind": "proof-sketch",
      "text": "Here \\(x-y=2-(-2)=4.\\) Therefore \\[ \\begin{aligned} x-y^{x-y} &=2-(-2)^4\\\\ &=2-16=-14. \\end{aligned} \\]\n\nThus, the correct answer is B.",
      "hints": [
        "Evaluate the exponent \\(x-y\\) before the power",
        "The powered term is \\((-2)^4\\), not \\(-2^4\\)"
      ],
