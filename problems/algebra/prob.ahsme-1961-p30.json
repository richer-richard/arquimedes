  "estimatedMinutes": 1,
  "statement": "If \\(\\log_{10}2=a\\) and \\(\\log_{10}3=b,\\) then \\(\\log_5 12\\) equals:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{a+b}{a+1}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{2a+b}{a+1}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{a+2b}{1+a}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{2a+b}{1-a}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{a+2b}{1-a}\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1961-p30.live",
      "kind": "proof-sketch",
      "text": "By change of base, \\[ \\begin{aligned} \\log_5 12 &=\\frac{\\log12}{\\log5}\\\\ &=\\frac{2\\log2+\\log3} {\\log10-\\log2}\\\\ &=\\frac{2a+b}{1-a}. \\end{aligned} \\]\n\nTherefore, the correct answer is D.",
      "hints": [
        "Use the change-of-base formula with common logarithms",
        "Write \\(12=2^2\\cdot3\\) and \\(5=\\frac{10}{2}\\)"
      ],
      "images": []
    }
  ],
