  "estimatedMinutes": 1,
  "statement": "For every \\(n\\) the sum \\(S_n\\) of \\(n\\) terms of an arithmetic progression is \\(2n+3n^2.\\) The \\(r\\)th term is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(3r^2\\)"
    },
    {
      "label": "B",
      "text": "\\(3r^2+2r\\)"
    },
    {
      "label": "C",
      "text": "\\(6r-1\\)"
    },
    {
      "label": "D",
      "text": "\\(5r+5\\)"
    },
    {
      "label": "E",
      "text": "\\(6r+2\\)"
    }
  ],
