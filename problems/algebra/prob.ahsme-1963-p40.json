  "estimatedMinutes": 2,
  "statement": "If \\(x\\) is a number satisfying the equation \\(\\sqrt[3]{x+9}-\\sqrt[3]{x-9}=3,\\) then \\(x^2\\) is between:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(55\\) and \\(65\\)"
    },
    {
      "label": "B",
      "text": "\\(65\\) and \\(75\\)"
    },
    {
      "label": "C",
      "text": "\\(75\\) and \\(85\\)"
    },
    {
      "label": "D",
      "text": "\\(85\\) and \\(95\\)"
    },
    {
      "label": "E",
      "text": "\\(95\\) and \\(105\\)"
    }
  ],
