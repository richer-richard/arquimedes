  "estimatedMinutes": 2,
  "statement": "Find the number of pairs \\((m,n)\\) of integers which satisfy the equation \\[ \\begin{aligned} m^3+6m^2+5m &=27n^3+9n^2\\\\ &\\quad+9n+1. \\end{aligned} \\]",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(0\\)"
    },
    {
      "label": "B",
      "text": "\\(1\\)"
    },
    {
      "label": "C",
      "text": "\\(3\\)"
    },
    {
      "label": "D",
      "text": "\\(9\\)"
    },
    {
      "label": "E",
      "text": "infinitely many"
    }
  ],
  "answer": {
    "letter": "a",
    "value": "0"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1979-p22.live",
      "kind": "proof-sketch",
      "text": "The left side is \\[ \\begin{gathered} m(m+1)(m+5)\\\\ =m(m+1)(m+2)\\\\ \\quad+3m(m+1), \\end{gathered} \\] which is divisible by \\(3\\) for every integer \\(m.\\) The right side is \\(3(9n^3+3n^2+3n)+1,\\) which is congruent to \\(1\\pmod3.\\) Therefore no integer pair satisfies the equation.\n\nTherefore, the correct answer is A.",
      "hints": [
        "Factor the left side as \\(m(m+1)(m+5)\\)",
        "Compare the two sides modulo \\(3\\)"
      ],
      "images": []
    }
  ],
