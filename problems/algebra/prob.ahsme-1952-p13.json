  "estimatedMinutes": 1,
  "statement": "The function \\(x^2+px+q\\) with \\(p\\) and \\(q\\) greater than zero has its minimum value when:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(x=-p\\)"
    },
    {
      "label": "B",
      "text": "\\(x=\\dfrac p2\\)"
    },
    {
      "label": "C",
      "text": "\\(x=-2p\\)"
    },
    {
      "label": "D",
      "text": "\\(x=\\dfrac{p^2}{4q}\\)"
    },
    {
      "label": "E",
      "text": "\\(x=-\\dfrac p2\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1952-p13.live",
      "kind": "proof-sketch",
      "text": "Completing the square gives \\[ \\begin{aligned} x^2+px+q &=\\left(x+\\frac p2\\right)^2\\\\ &\\quad{}+q-\\frac{p^2}{4}. \\end{aligned} \\] The square is least when \\(x=-\\frac{p}{2}.\\)\n\nThus, the correct answer is E.",
      "hints": [
        "Complete the square in the terms \\(x^2+px\\)",
        "The squared term is minimized when \\(x+\\frac{p}{2}=0\\)"
      ],
      "images": []
    }
  ],
