  "solutions": [
    {
      "id": "sol.ahsme-1962-p1.live",
      "kind": "proof-sketch",
      "text": "The numerator is \\(1,\\) while \\[ 5^{-1}+3^{-1}=\\frac15+\\frac13=\\frac8{15}. \\] Therefore the expression equals \\(\\frac{1}{\\frac{8}{15}}=\\frac{15}{8}.\\)\n\nThus, the correct answer is D.",
      "hints": [
        "First simplify the power in the numerator",
        "Rewrite each negative first power as a reciprocal"
      ],
