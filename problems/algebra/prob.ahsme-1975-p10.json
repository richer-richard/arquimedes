  "estimatedMinutes": 1,
  "statement": "The sum of the digits in base ten of \\(\\left(10^{4n^2+8}+1\\right)^2,\\) where \\(n\\) is a positive integer, is",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(4\\)"
    },
    {
      "label": "B",
      "text": "\\(4n\\)"
    },
    {
      "label": "C",
      "text": "\\(2+2n\\)"
    },
    {
      "label": "D",
      "text": "\\(4n^2\\)"
    },
    {
      "label": "E",
      "text": "\\(n^2+n+2\\)"
    }
  ],
  "answer": {
    "letter": "a",
    "value": "4"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1975-p10.live",
      "kind": "proof-sketch",
      "text": "For \\(k=4n^2+8,\\) \\[ (10^k+1)^2=10^{2k}+2\\cdot10^k+1. \\] Its only nonzero digits are \\(1,2,1,\\) so their sum is \\(4.\\)\n\nTherefore, the correct answer is A.",
      "hints": [
        "Set \\(k=4n^2+8\\) and square \\(10^k+1\\)",
        "The three nonzero digits occur in distinct places, so there are no carries"
      ],
      "images": []
    }
  ],
