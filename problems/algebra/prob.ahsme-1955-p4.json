      "text": "either \\(x=1\\) or \\(x=2\\)"
    },
    {
      "label": "C",
      "text": "only \\(x=1\\)"
    },
    {
      "label": "D",
      "text": "only \\(x=2\\)"
    },
    {
      "label": "E",
      "text": "only \\(x=0\\)"
    }
