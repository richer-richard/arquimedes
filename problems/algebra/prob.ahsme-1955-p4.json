  "estimatedMinutes": 1,
  "statement": "The equality \\(\\dfrac1{x-1}=\\dfrac2{x-2}\\) is satisfied by:",
  "answerChoices": [
    {
      "label": "A",
      "text": "no real values of \\(x\\)"
    },
