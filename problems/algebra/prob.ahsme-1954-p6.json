  "solutions": [
    {
      "id": "sol.ahsme-1954-p6.live",
      "kind": "proof-sketch",
      "text": "For permissible \\(a,\\) the four terms are \\[ \\frac1{16},\\qquad 1,\\qquad \\frac18,\\qquad \\frac1{16}. \\] Therefore the expression is \\[ \\frac1{16}+1-\\frac18-\\frac1{16}=\\frac78. \\]\n\nThus, the correct answer is D.",
      "hints": [
        "Evaluate each of the four terms separately, using \\(a^0=1\\)",
        "The real fifth root of \\(-32\\) is \\(-2\\), so \\((-32)^{-\\frac{4}{5}}=\\frac{1}{16}\\)"
      ],
      "images": []
    }
  ],
