      "label": "C",
      "text": "\\(1\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac78\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac1{16}\\)"
    }
  ],
