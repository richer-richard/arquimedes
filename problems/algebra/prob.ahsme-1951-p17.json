  "estimatedMinutes": 1,
  "statement": "Indicate in which one of the following equations \\(y\\) is neither directly nor inversely proportional to \\(x\\):",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(x+y=0\\)"
    },
    {
