      "text": "\\(3xy=10\\)"
    },
    {
      "label": "C",
      "text": "\\(x=5y\\)"
    },
    {
      "label": "D",
      "text": "\\(3x+y=10\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{x}{y}=\\sqrt3\\)"
