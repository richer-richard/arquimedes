  "estimatedMinutes": 2,
  "statement": "Find the sum \\[ \\begin{aligned} &\\frac1{1\\cdot3}+\\frac1{3\\cdot5}+\\cdots\\\\ &\\quad+\\frac1{(2n-1)(2n+1)}+\\cdots\\\\ &\\quad+\\frac1{255\\cdot257}. \\end{aligned} \\]",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\frac{127}{255}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\frac{128}{255}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\frac12\\)"
    },
    {
      "label": "D",
      "text": "\\(\\frac{128}{257}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\frac{129}{257}\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": "128/257"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1977-p24.live",
      "kind": "proof-sketch",
      "text": "For \\(1\\le n\\le128,\\) \\[ \\begin{gathered} \\frac1{(2n-1)(2n+1)}\\\\ =\\frac1{2(2n-1)}-\\frac1{2(2n+1)}. \\end{gathered} \\] Hence the sum telescopes to \\[ \\frac12\\left(1-\\frac1{257}\\right)=\\frac{128}{257}. \\]\n\nTherefore, the correct answer is D.",
      "hints": [
        "Decompose \\(\\frac1{(2n-1)(2n+1)}\\) into two unit fractions",
        "The last denominator corresponds to \\(n=128\\)"
      ],
      "images": []
    }
  ],
