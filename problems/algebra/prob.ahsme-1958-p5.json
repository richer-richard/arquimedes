  "solutions": [
    {
      "id": "sol.ahsme-1958-p5.live",
      "kind": "proof-sketch",
      "text": "Rationalizing gives \\[ \\begin{aligned} \\frac1{2+\\sqrt2}&=\\frac{2-\\sqrt2}{2},\\\\ \\frac1{\\sqrt2-2}&=-\\frac{2+\\sqrt2}{2}. \\end{aligned} \\] Their sum is \\(-\\sqrt2.\\) Therefore the whole expression is \\[ 2+\\sqrt2-\\sqrt2=2. \\]\n\nThus, the correct answer is A.",
      "hints": [
        "Rationalize the two reciprocal terms before adding them",
        "The two reciprocals simplify to quantities whose sum is \\(-\\sqrt2\\)"
      ],
      "images": []
    }
  ],
