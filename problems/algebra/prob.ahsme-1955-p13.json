  "estimatedMinutes": 1,
  "statement": "The fraction \\(\\dfrac{a^{-4}-b^{-4}}{a^{-2}-b^{-2}}\\) is equal to:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(a^{-6}-b^{-6}\\)"
    },
    {
      "label": "B",
      "text": "\\(a^{-2}-b^{-2}\\)"
    },
    {
      "label": "C",
      "text": "\\(a^{-2}+b^{-2}\\)"
    },
    {
      "label": "D",
      "text": "\\(a^2+b^2\\)"
    },
    {
      "label": "E",
      "text": "\\(a^2-b^2\\)"
    }
  ],
