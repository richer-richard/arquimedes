    "letter": "c",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1955-p13.live",
      "kind": "proof-sketch",
      "text": "Factoring the numerator, \\[ \\begin{aligned} a^{-4}-b^{-4} &=(a^{-2}-b^{-2})\\\\ &\\quad\\cdot(a^{-2}+b^{-2}). \\end{aligned} \\] Where the original fraction is defined, canceling the common factor leaves \\(a^{-2}+b^{-2}.\\)\n\nThus, the correct answer is C.",
      "hints": [
        "Regard \\(a^{-4}-b^{-4}\\) as a difference of squares",
        "Factor it using \\(a^{-2}\\) and \\(b^{-2}\\)"
      ],
      "images": []
    }
