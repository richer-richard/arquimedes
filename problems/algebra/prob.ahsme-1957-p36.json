  "estimatedMinutes": 1,
  "statement": "If \\(x+y=1,\\) then the largest value of \\(xy\\) is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(1\\)"
    },
    {
      "label": "B",
      "text": "\\(0.5\\)"
    },
    {
      "label": "C",
      "text": "an irrational number about \\(0.4\\)"
    },
    {
      "label": "D",
      "text": "\\(0.25\\)"
    },
    {
      "label": "E",
      "text": "\\(0\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": "0.25"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1957-p36.live",
      "kind": "proof-sketch",
      "text": "We have \\[ \\begin{aligned} xy=x(1-x) &=\\frac14\\\\ &\\quad-\\left(x-\\frac12\\right)^2. \\end{aligned} \\] The squared term is nonnegative, so the largest possible product is \\(\\frac{1}{4}=0.25.\\)\n\nThus, the correct answer is D.",
      "hints": [
        "Substitute \\(y=1-x\\) into the product",
        "Complete the square in \\(x(1-x)\\)"
      ],
      "images": []
    }
  ],
