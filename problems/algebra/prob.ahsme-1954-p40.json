  "solutions": [
    {
      "id": "sol.ahsme-1954-p40.live",
      "kind": "proof-sketch",
      "text": "Let \\(t=a+\\frac{1}{a}.\\) The standard cubic identity gives \\[ a^3+\\frac1{a^3}=t^3-3t=t(t^2-3). \\] Since \\(t^2=3,\\) this expression is \\(0.\\)\n\nThus, the correct answer is C.",
      "hints": [
        "Set \\(t=a+\\frac{1}{a}\\), so the given condition is \\(t^2=3\\)",
        "Use \\(a^3+a^{-3}=t^3-3t\\)"
      ],
      "images": []
    }
  ],
