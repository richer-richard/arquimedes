  "estimatedMinutes": 2,
  "statement": "If \\(\\sqrt{x-1}-\\sqrt{x+1}+1=0,\\) then \\(4x\\) equals:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(5\\)"
    },
    {
      "label": "B",
      "text": "\\(4\\sqrt{-1}\\)"
    },
    {
      "label": "C",
      "text": "\\(0\\)"
    },
    {
      "label": "D",
      "text": "\\(1\\frac14\\)"
    },
    {
      "label": "E",
      "text": "no real value"
    }
  ],
  "answer": {
    "letter": "a",
    "value": "5"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1957-p22.live",
      "kind": "proof-sketch",
      "text": "Rearrange and square: \\[ \\begin{aligned} \\sqrt{x+1}&=\\sqrt{x-1}+1,\\\\ x+1&=x-1+2\\sqrt{x-1}+1. \\end{aligned} \\] Thus \\(2\\sqrt{x-1}=1,\\) so \\(x-1=\\frac{1}{4}\\) and \\(x=\\frac{5}{4}.\\) This value satisfies the original equation. Therefore \\(4x=5.\\)\n\nThus, the correct answer is A.",
      "hints": [
        "Rearrange to \\(\\sqrt{x+1}=\\sqrt{x-1}+1\\)",
        "After squaring once, isolate \\(\\sqrt{x-1}\\)"
      ],
      "images": []
    }
  ],
