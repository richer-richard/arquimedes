  "solutions": [
    {
      "id": "sol.amc-12a-2014-p9.live",
      "kind": "proof-sketch",
      "text": "The integers \\(a,a+1,a+2,a+3,a+4\\) have average \\(a+2,\\) so \\(b=a+2.\\)\n\nThe integers starting at \\(b\\) have average \\(b+2=(a+2)+2=a+4.\\)\n\nThus, the correct answer is B.",
      "hints": [
        "The average of consecutive integers is the middle one",
        "From the first set \\(b=a+2\\), and the new average is \\(b+2\\)"
      ],
