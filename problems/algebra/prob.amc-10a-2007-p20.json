  "solutions": [
    {
      "id": "sol.amc-10a-2007-p20.live",
      "kind": "proof-sketch",
      "text": "Squaring \\(a + a^{-1} = 4\\) gives \\(a^2 + 2 + a^{-2} = 16,\\) so \\(a^2 + a^{-2} = 14.\\)\n\nSquaring again gives \\(a^4 + 2 + a^{-4} = 196,\\) so \\(a^4 + a^{-4} = 194.\\)\n\nThus, the correct answer is D.",
      "hints": [
        "Squaring \\(a + a^{-1}\\) gives \\(a^2 + 2 + a^{-2}\\)",
        "Square \\(a^2 + a^{-2}\\) and subtract the middle term \\(2\\)"
      ],
