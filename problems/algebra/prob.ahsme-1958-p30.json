  "estimatedMinutes": 1,
  "statement": "If \\(xy=b\\) and \\(\\dfrac1{x^2}+\\dfrac1{y^2}=a,\\) then \\((x+y)^2\\) equals:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\((a+2b)^2\\)"
    },
    {
      "label": "B",
      "text": "\\(a^2+b^2\\)"
    },
    {
      "label": "C",
      "text": "\\(b(ab+2)\\)"
    },
    {
      "label": "D",
      "text": "\\(ab(b+2)\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac1a+2b\\)"
    }
  ],
