    "letter": "c",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1958-p30.live",
      "kind": "proof-sketch",
      "text": "Since \\(xy=b,\\) \\[ a=\\frac{x^2+y^2}{x^2y^2} =\\frac{x^2+y^2}{b^2}, \\] so \\(x^2+y^2=ab^2.\\) Therefore \\[ \\begin{aligned} (x+y)^2 &=x^2+y^2+2xy\\\\ &=ab^2+2b\\\\ &=b(ab+2). \\end{aligned} \\]\n\nTherefore, the correct answer is C.",
      "hints": [
        "Combine \\(\\frac{1}{x^2}+\\frac{1}{y^2}\\) using the common denominator \\(x^2y^2\\)",
        "Use \\(xy=b\\) to find \\(x^2+y^2\\), then add \\(2xy\\)"
      ],
      "images": []
    }
  ],
