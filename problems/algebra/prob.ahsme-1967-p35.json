  "estimatedMinutes": 1,
  "statement": "The roots of \\(64x^3-144x^2+92x-15=0\\) are in arithmetic progression. The difference between the largest and smallest roots is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(2\\)"
    },
