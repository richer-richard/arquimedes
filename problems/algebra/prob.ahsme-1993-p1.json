  "estimatedMinutes": 1,
  "statement": "For integers \\(a,\\) \\(b,\\) and \\(c,\\) define \\(\\boxed{a,b,c}\\) to mean \\(a^b-b^c+c^a.\\) Then \\(\\boxed{1,-1,2}\\) equals",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(-4\\)"
    },
    {
      "label": "B",
      "text": "\\(-2\\)"
    },
    {
      "label": "C",
      "text": "\\(0\\)"
    },
    {
      "label": "D",
      "text": "\\(2\\)"
    },
    {
      "label": "E",
      "text": "\\(4\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": "2"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1993-p1.live",
      "kind": "proof-sketch",
      "text": "By the definition, \\[ \\begin{aligned} \\boxed{1,-1,2} &=1^{-1}-(-1)^2+2^1\\\\ &=1-1+2\\\\ &=2. \\end{aligned} \\] Thus the correct answer is D.",
      "hints": [
        "Substitute the three entries in their stated order",
        "Remember that \\((-1)^2=1\\) and \\(2^1=2\\)"
      ],
