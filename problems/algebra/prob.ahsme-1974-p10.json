  "solutions": [
    {
      "id": "sol.ahsme-1974-p10.live",
      "kind": "proof-sketch",
      "text": "The equation is \\((2k-1)x^2-8x+6=0.\\) Its discriminant is \\[ 64-24(2k-1)=88-48k. \\] This is negative exactly when \\(k\\gt\\frac{11}{6},\\) so the least integer possible is \\(2.\\)\n\nTherefore, the correct answer is B.",
      "hints": [
        "First rewrite the equation in standard quadratic form",
        "No real roots means the discriminant is negative"
      ],
