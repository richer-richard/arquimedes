  "estimatedMinutes": 1,
  "statement": "When simplified and expressed with negative exponents, the expression \\((x+y)^{-1}(x^{-1}+y^{-1})\\) is equal to:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(x^{-2}+2x^{-1}y^{-1}+y^{-2}\\)"
    },
    {
      "label": "B",
      "text": "\\(x^{-2}+2^{-1}x^{-1}y^{-1}+y^{-2}\\)"
    },
    {
      "label": "C",
      "text": "\\(x^{-1}y^{-1}\\)"
    },
    {
      "label": "D",
      "text": "\\(x^{-2}+y^{-2}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{1}{x^{-1}y^{-1}}\\)"
    }
  ],
  "answer": {
    "letter": "c",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1951-p20.live",
      "kind": "proof-sketch",
      "text": "For nonzero \\(x,y\\) with \\(x+y\\ne0,\\) \\[ \\begin{aligned} &(x+y)^{-1}(x^{-1}+y^{-1})\\\\ &\\quad=\\frac{1}{x+y}\\left(\\frac{x+y}{xy}\\right)\\\\ &\\quad=\\frac1{xy}=x^{-1}y^{-1}. \\end{aligned} \\]\n\nThus, the correct answer is C.",
      "hints": [
        "Rewrite \\(x^{-1}+y^{-1}\\) as one fraction",
        "The factor \\(x+y\\) cancels after combining the reciprocals"
      ],
      "images": []
    }
  ],
