    "letter": "c",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1959-p44.live",
      "kind": "proof-sketch",
      "text": "If the roots are \\(u,v>1,\\) then \\(b=-(u+v)\\) and \\(c=uv.\\) Therefore \\[ \\begin{aligned} s&=1-u-v+uv\\\\ &=(u-1)(v-1)>0. \\end{aligned} \\]\n\nThus \\(s\\) must be greater than zero, and the correct answer is C.",
      "hints": [
        "Call the two roots \\(u\\) and \\(v\\) and express \\(b,c\\) using Vieta’s formulas",
        "Factor \\(1-(u+v)+uv\\)"
      ],
