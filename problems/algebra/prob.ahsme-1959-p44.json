  "estimatedMinutes": 1,
  "statement": "The roots of \\(x^2+bx+c=0\\) are both real and greater than \\(1.\\) Let \\(s=b+c+1.\\) Then \\(s:\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "may be less than zero"
    },
    {
      "label": "B",
      "text": "may be equal to zero"
    },
    {
      "label": "C",
      "text": "must be greater than zero"
    },
    {
      "label": "D",
      "text": "must be less than zero"
    },
    {
      "label": "E",
      "text": "must be between \\(-1\\) and \\(1\\)"
    }
  ],
