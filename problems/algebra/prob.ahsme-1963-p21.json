  "estimatedMinutes": 1,
  "statement": "The expression \\(x^2-y^2-z^2+2yz+x+y-z\\) has:",
  "answerChoices": [
    {
      "label": "A",
      "text": "no linear factor with integer coefficients and integer\nexponents"
    },
    {
      "label": "B",
      "text": "the factor \\(-x+y+z\\)"
    },
    {
      "label": "C",
      "text": "the factor \\(x-y-z+1\\)"
    },
    {
      "label": "D",
      "text": "the factor \\(x+y-z+1\\)"
    },
    {
      "label": "E",
      "text": "the factor \\(x-y+z+1\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1963-p21.live",
      "kind": "proof-sketch",
      "text": "Let \\(u=y-z.\\) The two groups factor as \\[ \\begin{gathered} x^2-u^2=(x+u)(x-u),\\\\ x+u=(x+u)\\cdot1. \\end{gathered} \\] Thus the whole expression is \\((x+u)(x-u+1),\\) and one factor is \\(x-y+z+1.\\)\n\nTherefore, the correct answer is E.",
      "hints": [
        "Group \\(y-z\\) as a single expression",
        "Rewrite the polynomial as \\(x^2-(y-z)^2+x+(y-z)\\)"
      ],
      "images": []
    }
  ],
