  "solutions": [
    {
      "id": "sol.amc-12b-2018-p7.live",
      "kind": "proof-sketch",
      "text": "The factors split into two telescoping chains. The odd-position factors form \\[ \\begin{gathered} \\log_3 7\\cdot\\log_7 11 \\\\ {}\\cdot\\log_{11} 15\\cdots\\log_{23} 27 \\\\ =\\log_3 27=3, \\end{gathered} \\] and the even-position factors form \\[ \\begin{gathered} \\log_5 9\\cdot\\log_9 13\\cdots\\log_{21} 25 \\\\ =\\log_5 25=2. \\end{gathered} \\]\n\nThe product is \\(3\\cdot2=6.\\)\n\nThus, the correct answer is C.",
      "hints": [
        "Apply the change-of-base formula \\(\\log_a b=\\dfrac{\\log b}{\\log a}\\)",
        "Separate into two telescoping chains: bases \\(3,7,11,\\dots\\) and bases \\(5,9,13,\\dots\\)"
      ],
      "images": []
    }
  ],
