  "statement": "What is the value of the following expression?\n\n\\[\\frac{2 + 4 + 6 + \\cdots + 34}{3 + 6 + 9 + \\cdots + 51}\\]",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{1}{3}\\)"
