    },
    {
      "label": "E",
      "text": "\\(24\\)"
    }
  ],
  "answer": {
    "letter": "b",
    "value": "21"
  },
  "solutions": [
    {
      "id": "sol.amc-12a-2024-p3.live",
      "kind": "proof-sketch",
      "text": "Each number is at most \\(99,\\) so \\(k\\) numbers sum to at most \\(99k.\\) Since \\(99\\cdot20=1980\\lt2024,\\) at least \\(21\\) numbers are required. With \\(21,\\) we can use twenty \\(99\\)s and one \\(44\\): \\(20\\cdot99+44=1980+44\\) \\(=2024.\\) Thus, the correct answer is B.",
      "hints": [
        "The largest two-digit number is \\(99,\\) so many numbers are needed",
        "\\(20\\cdot99=1980,\\) which falls short; can \\(21\\) numbers reach exactly \\(2024?\\)"
      ],
      "images": []
    }
  ],
