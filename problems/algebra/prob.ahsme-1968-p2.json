  "estimatedMinutes": 1,
  "statement": "The real value of \\(x\\) such that \\(64^{x-1}\\) divided by \\(4^{x-1}\\) equals \\(256^{2x}\\) is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(-\\dfrac23\\)"
    },
    {
      "label": "B",
      "text": "\\(-\\dfrac13\\)"
    },
    {
      "label": "C",
      "text": "\\(0\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac14\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac38\\)"
    }
  ],
  "answer": {
    "letter": "b",
    "value": "-1/3"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1968-p2.live",
      "kind": "proof-sketch",
      "text": "The left side is \\((\\frac{64}{4})^{x-1}=16^{x-1},\\) while \\(256^{2x}=(16^2)^{2x}=16^{4x}.\\) Hence \\(x-1=4x,\\) so \\(x=-\\frac{1}{3}.\\)\n\nTherefore, the correct answer is B.",
      "hints": [
        "Combine the quotient because its powers have the same exponent",
        "Write both sides as powers of \\(16\\)"
      ],
