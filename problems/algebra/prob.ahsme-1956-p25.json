  "estimatedMinutes": 1,
  "statement": "The sum of all numbers of the form \\(2k+1,\\) where \\(k\\) takes on integral values from \\(1\\) to \\(n\\) is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(n^2\\)"
    },
    {
      "label": "B",
      "text": "\\(n(n+1)\\)"
    },
    {
      "label": "C",
      "text": "\\(n(n+2)\\)"
    },
    {
      "label": "D",
      "text": "\\((n+1)^2\\)"
    },
    {
      "label": "E",
      "text": "\\((n+1)(n+2)\\)"
    }
  ],
  "answer": {
    "letter": "c",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1956-p25.live",
      "kind": "proof-sketch",
      "text": "We compute \\[ \\begin{aligned} \\sum_{k=1}^n(2k+1) &=2\\sum_{k=1}^n k+\\sum_{k=1}^n1\\\\ &=n(n+1)+n\\\\ &=n(n+2). \\end{aligned} \\]\n\nThus, the correct answer is C.",
      "hints": [
        "Separate \\(\\sum_{k=1}^n(2k+1)\\) into two sums",
        "Use \\(1+2+\\cdots+n=\\frac{n(n+1)}{2}\\)"
      ],
      "images": []
    }
  ],
