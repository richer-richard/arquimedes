  "estimatedMinutes": 1,
  "statement": "For the simultaneous equations\n\n\\[ \\begin{aligned} 2x-3y&=8,\\\\ 6y-4x&=9, \\end{aligned} \\]",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(x=4,\\) \\(y=0\\)"
    },
    {
      "label": "B",
      "text": "\\(x=0,\\) \\(y=\\dfrac32\\)"
    },
    {
      "label": "C",
      "text": "\\(x=0,\\) \\(y=0\\)"
    },
    {
      "label": "D",
      "text": "There is no solution"
    },
    {
      "label": "E",
      "text": "There are an infinite number of solutions"
    }
