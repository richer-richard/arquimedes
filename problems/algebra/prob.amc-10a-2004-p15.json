  "estimatedMinutes": 1,
  "statement": "Given that \\(-4 \\le x \\le -2\\) and \\(2 \\le y \\le 4,\\) what is the largest possible value of \\[\\dfrac{x + y}{x}?\\]",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(-1\\)"
    },
    {
      "label": "B",
      "text": "\\(-\\dfrac{1}{2}\\)"
    },
    {
      "label": "C",
      "text": "\\(0\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{1}{2}\\)"
    },
    {
      "label": "E",
      "text": "\\(1\\)"
    }
  ],
  "answer": {
