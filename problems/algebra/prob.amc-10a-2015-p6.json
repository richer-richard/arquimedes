  "estimatedMinutes": 1,
  "statement": "The sum of two positive numbers is \\(5\\) times their difference. What is the ratio of the larger number to the smaller number?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{5}{4}\\)"
    },
