      "label": "B",
      "text": "\\(\\dfrac{3}{2}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{9}{5}\\)"
    },
    {
      "label": "D",
      "text": "\\(2\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{5}{2}\\)"
    }
  ],
  "answer": {
    "letter": "b",
    "value": "3/2"
