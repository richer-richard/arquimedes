  "estimatedMinutes": 1,
  "statement": "Which one of the following points is not on the graph of \\(y=\\dfrac{x}{x+1}?\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\((0,0)\\)"
    },
    {
      "label": "B",
      "text": "\\(\\left(-\\dfrac12,-1\\right)\\)"
    },
    {
      "label": "C",
      "text": "\\(\\left(\\dfrac12,\\dfrac13\\right)\\)"
    },
    {
      "label": "D",
      "text": "\\((-1,1)\\)"
    },
    {
      "label": "E",
      "text": "\\((-2,2)\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": null
