  "solutions": [
    {
      "id": "sol.ahsme-1963-p1.live",
      "kind": "proof-sketch",
      "text": "The expression \\(\\frac{x}{x+1}\\) is undefined when \\(x=-1.\\) Therefore no point whose first coordinate is \\(-1\\) can lie on its graph.\n\nThus, the correct answer is D.",
      "hints": [
        "Check the domain before substituting coordinates",
        "The denominator vanishes at one of the listed \\(x\\)-coordinates"
      ],
