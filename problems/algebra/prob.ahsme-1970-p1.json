  "solutions": [
    {
      "id": "sol.ahsme-1970-p1.live",
      "kind": "proof-sketch",
      "text": "The innermost radical is \\(\\sqrt1=1,\\) so the given number is \\(\\sqrt{1+\\sqrt2}.\\) Its fourth power is \\[ \\begin{aligned} (1+\\sqrt2)^2&=1+2\\sqrt2+2\\\\ &=3+2\\sqrt2. \\end{aligned} \\]\n\nTherefore, the correct answer is E.",
      "hints": [
        "Simplify from the innermost radical outward",
        "After the innermost radical becomes \\(1,\\) square \\(\\sqrt{1+\\sqrt2}\\) twice"
      ],
