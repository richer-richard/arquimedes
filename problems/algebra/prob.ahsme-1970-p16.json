    "value": "7"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1970-p16.live",
      "kind": "proof-sketch",
      "text": "Applying the recurrence successively, \\[ \\begin{aligned} F(4)&=\\frac{1\\cdot1+1}{1}=2,\\\\ F(5)&=\\frac{2\\cdot1+1}{1}=3, \\end{aligned} \\] and \\[ F(6)=\\frac{3\\cdot2+1}{1}=7. \\]\n\nTherefore, the correct answer is C.",
      "hints": [
        "Compute the terms one at a time beginning with \\(F(4)\\)",
        "Use the recurrence successively for \\(n=3,4,5\\)"
      ],
