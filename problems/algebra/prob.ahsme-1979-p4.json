  "estimatedMinutes": 1,
  "statement": "For all real numbers \\(x,\\) \\(x[x\\{x(2-x)-4\\}+10]+1\\) equals",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(-x^4+2x^3+4x^2+10x+1\\)"
    },
    {
      "label": "B",
      "text": "\\(-x^4-2x^3+4x^2+10x+1\\)"
    },
    {
      "label": "C",
      "text": "\\(-x^4-2x^3-4x^2+10x+1\\)"
    },
    {
      "label": "D",
      "text": "\\(-x^4-2x^3-4x^2-10x+1\\)"
    },
    {
      "label": "E",
      "text": "\\(-x^4+2x^3-4x^2+10x+1\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1979-p4.live",
      "kind": "proof-sketch",
      "text": "Expanding from the inside gives \\[ \\begin{aligned} &x[x\\{x(2-x)-4\\}+10]+1\\\\ &\\quad=x[x(2x-x^2-4)+10]+1\\\\ &\\quad=-x^4+2x^3-4x^2\\\\ &\\qquad+10x+1. \\end{aligned} \\]\n\nTherefore, the correct answer is E.",
      "hints": [
        "Expand from the innermost parentheses outward",
        "Track the outer two factors of \\(x\\) separately"
      ],
      "images": []
    }
  ],
