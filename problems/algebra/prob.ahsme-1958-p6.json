  "estimatedMinutes": 1,
  "statement": "The arithmetic mean between \\(\\dfrac{x+a}{x}\\) and \\(\\dfrac{x-a}{x},\\) when \\(x\\ne0,\\) is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(2,\\) if \\(a\\ne0\\)"
    },
    {
      "label": "B",
      "text": "\\(1\\)"
    },
    {
      "label": "C",
      "text": "\\(1,\\) only if \\(a=0\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac ax\\)"
    },
    {
      "label": "E",
      "text": "\\(x\\)"
    }
  ],
  "answer": {
    "letter": "b",
    "value": "1"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1958-p6.live",
      "kind": "proof-sketch",
      "text": "The arithmetic mean is \\[ \\begin{aligned} &\\frac12\\left(\\frac{x+a}{x}+\\frac{x-a}{x}\\right)\\\\ &\\qquad=\\frac12\\left(\\frac{2x}{x}\\right)=1. \\end{aligned} \\]\n\nTherefore, the correct answer is B.",
      "hints": [
        "Add the two given expressions and divide by \\(2\\)",
        "The \\(a\\)-terms cancel in the numerator"
      ],
      "images": []
    }
  ],
