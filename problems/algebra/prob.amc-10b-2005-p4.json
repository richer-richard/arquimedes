  "solutions": [
    {
      "id": "sol.amc-10b-2005-p4.live",
      "kind": "proof-sketch",
      "text": "Each inner expression evaluates to \\[ 5 \\diamond 12 = \\sqrt{5^2 + 12^2} = 13 \\] and similarly \\((-12) \\diamond (-5)\\) \\(= \\sqrt{144 + 25} = 13.\\)\n\nThen \\[ 13 \\diamond 13 = \\sqrt{13^2 + 13^2} = 13\\sqrt{2}. \\]\n\nThus, D is the correct answer.",
      "hints": [
        "Evaluate the two inner operations first",
        "Both \\(5\\diamond12\\) and \\((-12)\\diamond(-5)\\) equal \\(13\\)"
      ],
