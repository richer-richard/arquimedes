  "estimatedMinutes": 2,
  "statement": "The inequality \\(y-x\\lt\\sqrt{x^2}\\) is satisfied if and only if",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(y\\lt0\\) or \\(y\\lt2x\\) (or both inequalities\nhold)"
    },
    {
      "label": "B",
      "text": "\\(y\\gt0\\) or \\(y\\lt2x\\) (or both inequalities hold)"
    },
    {
      "label": "C",
      "text": "\\(y^2\\lt2xy\\)"
    },
    {
      "label": "D",
      "text": "\\(y\\lt0\\)"
    },
    {
      "label": "E",
      "text": "\\(x\\gt0\\) and \\(y\\lt2x\\)"
    }
  ],
  "answer": {
    "letter": "a",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1979-p13.live",
      "kind": "proof-sketch",
      "text": "If \\(x\\ge0,\\) the inequality becomes \\(y-x\\lt x,\\) or \\(y\\lt2x.\\) If \\(x\\lt0,\\) it becomes \\(y-x\\lt-x,\\) or \\(y\\lt0.\\) Combining the two cases gives exactly \\(y\\lt0\\) or \\(y\\lt2x,\\) with overlap allowed.\n\nTherefore, the correct answer is A.",
      "hints": [
        "Replace \\(\\sqrt{x^2}\\) by \\(|x|\\)",
        "Separate the cases \\(x\\ge0\\) and \\(x\\lt0\\), then combine the resulting regions"
      ],
      "images": []
    }
  ],
