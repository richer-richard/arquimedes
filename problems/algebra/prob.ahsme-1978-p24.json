  "estimatedMinutes": 2,
  "statement": "If the distinct nonzero numbers \\(x(y-z),\\) \\(y(z-x),\\) \\(z(x-y)\\) form a geometric progression with common ratio \\(r,\\) then \\(r\\) satisfies the equation",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(r^2+r+1=0\\)"
    },
    {
      "label": "B",
      "text": "\\(r^2-r+1=0\\)"
    },
    {
      "label": "C",
      "text": "\\(r^4+r^2-1=0\\)"
    },
    {
      "label": "D",
      "text": "\\((r+1)^4+r=0\\)"
    },
    {
      "label": "E",
      "text": "\\((r-1)^4+r=0\\)"
    }
  ],
  "answer": {
    "letter": "a",
    "value": null
