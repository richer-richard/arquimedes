  "estimatedMinutes": 1,
  "statement": "In a given arithmetic sequence the first term is \\(2,\\) the last term is \\(29,\\) and the sum of all the terms is \\(155.\\) The common difference is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(3\\)"
    },
    {
      "label": "B",
      "text": "\\(2\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{27}{19}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{13}{9}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{23}{38}\\)"
    }
  ],
