  "solutions": [
    {
      "id": "sol.ahsme-1966-p18.live",
      "kind": "proof-sketch",
      "text": "The sum formula gives \\(155=\\frac{31n}{2},\\) so \\(n=10.\\) Therefore \\(29=2+9d,\\) and \\(d=3.\\)\n\nThus, the correct answer is A.",
      "hints": [
        "Use \\(155=\\frac{n(2+29)}{2}\\) to find the number of terms",
        "Then use \\(29=2+(n-1)d\\)"
      ],
