  "estimatedMinutes": 1,
  "statement": "If \\(a\\) and \\(b\\) are two unequal positive numbers, then:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{2ab}{a+b}\\gt\\sqrt{ab}\\gt\\dfrac{a+b}{2}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\sqrt{ab}\\gt\\dfrac{2ab}{a+b}\\gt\\dfrac{a+b}{2}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{2ab}{a+b}\\gt\\dfrac{a+b}{2}\\gt\\sqrt{ab}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{a+b}{2}\\gt\\dfrac{2ab}{a+b}\\gt\\sqrt{ab}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{a+b}{2}\\gt\\sqrt{ab}\\gt\\dfrac{2ab}{a+b}\\)"
    }
  ],
