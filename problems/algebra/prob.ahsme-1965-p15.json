  "solutions": [
    {
      "id": "sol.ahsme-1965-p15.live",
      "kind": "proof-sketch",
      "text": "In ordinary notation, \\(25_b=2b+5\\) and \\(52_b=5b+2.\\) Thus \\[5b+2=2(2b+5),\\] so \\(b=8.\\)\n\nTherefore, the correct answer is B.",
      "hints": [
        "Translate \\(25_b\\) as \\(2b+5\\) and \\(52_b\\) as \\(5b+2\\)",
        "Solve \\(5b+2=2(2b+5)\\)"
      ],
