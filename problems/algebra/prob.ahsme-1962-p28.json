  "estimatedMinutes": 1,
  "statement": "The set of \\(x\\)-values satisfying the equation \\[ x^{\\log_{10}x}=\\frac{x^3}{100} \\] consists of:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac1{10},\\) only"
    },
    {
      "label": "B",
      "text": "\\(10,\\) only"
    },
    {
      "label": "C",
      "text": "\\(100,\\) only"
    },
    {
      "label": "D",
      "text": "\\(10\\) or \\(100,\\) only"
    },
    {
      "label": "E",
      "text": "more than two real numbers"
    }
  ],
  "answer": {
    "letter": "d",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1962-p28.live",
      "kind": "proof-sketch",
      "text": "Set \\(y=\\log_{10}x,\\) so \\(x=10^y.\\) Taking base-\\(10\\) logarithms gives \\[ y^2=3y-2. \\] Hence \\((y-1)(y-2)=0,\\) so \\(x=10\\) or \\(x=100.\\)\n\nThus, the correct answer is D.",
      "hints": [
        "The logarithm requires \\(x\\gt0\\); set \\(y=\\log_{10}x\\)",
        "Take base-\\(10\\) logarithms to obtain a quadratic in \\(y\\)"
      ],
      "images": []
    }
  ],
