  "solutions": [
    {
      "id": "sol.ahsme-1959-p45.live",
      "kind": "proof-sketch",
      "text": "The logarithms telescope: \\[ \\begin{aligned} &(\\log_3x)(\\log_x2x)(\\log_{2x}y)\\\\ &\\qquad=\\log_3y. \\end{aligned} \\] Also \\(\\log_xx^2=2,\\) so \\(\\log_3y=2\\) and \\(y=3^2=9.\\)\n\nTherefore, the correct answer is B.",
      "hints": [
        "Use \\((\\log_a b)(\\log_b c)=\\log_a c\\) twice",
        "Simplify the entire left side to \\(\\log_3y\\)"
      ],
      "images": []
    }
