  "estimatedMinutes": 1,
  "statement": "If \\(x\\) men working \\(x\\) hours a day for \\(x\\) days produce \\(x\\) articles, then the number of articles (not necessarily an integer) produced by \\(y\\) men working \\(y\\) hours a day for \\(y\\) days is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{x^3}{y^2}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{y^3}{x^2}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{x^2}{y^3}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{y^2}{x^3}\\)"
    },
    {
      "label": "E",
      "text": "\\(y\\)"
    }
  ],
  "answer": {
    "letter": "b",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1961-p15.live",
      "kind": "proof-sketch",
      "text": "The first group uses \\(x^3\\) man-hours to make \\(x\\) articles, so the rate is \\(\\frac{1}{x^2}\\) article per man-hour. The second group supplies \\(y^3\\) man-hours and therefore makes \\(\\frac{y^3}{x^2}\\) articles.\n\nThus, the correct answer is B.",
      "hints": [
        "Compute the production per man-hour from the first situation",
        "The second situation uses \\(y^3\\) man-hours"
      ],
      "images": []
    }
  ],
