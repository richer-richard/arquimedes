  "estimatedMinutes": 1,
  "statement": "The set of \\(x\\)-values satisfying the inequality \\(2\\le|x-1|\\le5\\) is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(-4\\le x\\le-1\\) or \\(3\\le x\\le6\\)"
    },
    {
      "label": "B",
      "text": "\\(3\\le x\\le6\\) or \\(-6\\le x\\le-3\\)"
    },
    {
      "label": "C",
      "text": "\\(x\\le-1\\) or \\(x\\ge3\\)"
    },
    {
      "label": "D",
      "text": "\\(-1\\le x\\le3\\)"
    },
    {
      "label": "E",
      "text": "\\(-4\\le x\\le6\\)"
    }
  ],
  "answer": {
    "letter": "a",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1962-p33.live",
      "kind": "proof-sketch",
      "text": "For \\(x-1\\ge0,\\) the bounds give \\(3\\le x\\le6.\\) For \\(x-1\\le0,\\) they give \\(-4\\le x\\le-1.\\) The solution is the union of these two intervals.\n\nThus, the correct answer is A.",
      "hints": [
        "Interpret the inequality as distances from \\(1\\) between \\(2\\) and \\(5\\)",
        "Solve \\(2\\le x-1\\le5\\) and \\(-5\\le x-1\\le-2\\)"
      ],
