  "estimatedMinutes": 1,
  "statement": "If it is known that \\(\\log_2a+\\log_2b\\ge6,\\) then the least value that can be taken on by \\(a+b\\) is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(2\\sqrt6\\)"
    },
    {
      "label": "B",
      "text": "\\(6\\)"
    },
    {
      "label": "C",
      "text": "\\(8\\sqrt2\\)"
    },
    {
      "label": "D",
      "text": "\\(16\\)"
    },
    {
      "label": "E",
      "text": "none of these"
    }
  ],
  "answer": {
    "letter": "d",
    "value": "16"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1969-p25.live",
      "kind": "proof-sketch",
      "text": "The logarithm condition gives \\(\\log_2(ab)\\ge6,\\) so \\(ab\\ge64.\\) By AM-GM, \\[ a+b\\ge2\\sqrt{ab}\\ge2\\sqrt{64}=16. \\] Equality is attained at \\(a=b=8.\\)\n\nTherefore, the correct answer is D.",
      "hints": [
        "Combine the logarithms to bound \\(ab\\)",
        "Apply \\(a+b\\ge2\\sqrt{ab}\\)"
      ],
      "images": []
    }
  ],
