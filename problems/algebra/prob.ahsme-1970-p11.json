  "solutions": [
    {
      "id": "sol.ahsme-1970-p11.live",
      "kind": "proof-sketch",
      "text": "The factor theorem gives \\[ \\begin{aligned} -16+2h+k&=0,\\\\ 2-h+k&=0. \\end{aligned} \\] Subtracting the second equation from the first gives \\(3h=18,\\) so \\(h=6\\) and then \\(k=4.\\) Hence \\[ |2h-3k|=|12-12|=0. \\]\n\nTherefore, the correct answer is E.",
      "hints": [
        "Apply the factor theorem at \\(x=-2\\) and \\(x=1\\)",
        "Solve \\(-16+2h+k=0\\) and \\(2-h+k=0\\)"
      ],
