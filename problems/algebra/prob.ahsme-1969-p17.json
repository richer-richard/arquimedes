  "estimatedMinutes": 1,
  "statement": "The equation \\(2^{2x}-8\\cdot2^x+12=0\\) is satisfied by:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\log 3\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac12\\log 6\\)"
    },
    {
      "label": "C",
      "text": "\\(1+\\log\\dfrac34\\)"
    },
    {
      "label": "D",
      "text": "\\(1+\\dfrac{\\log3}{\\log2}\\)"
    },
    {
      "label": "E",
      "text": "none of these"
    }
  ],
  "answer": {
    "letter": "d",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1969-p17.live",
      "kind": "proof-sketch",
      "text": "Set \\(t=2^x.\\) Then \\[ \\begin{aligned} t^2-8t+12&=0,\\\\ (t-2)(t-6)&=0. \\end{aligned} \\] The root \\(t=6\\) gives \\[ \\begin{aligned} x&=\\log_2 6\\\\ &=1+\\log_2 3\\\\ &=1+\\frac{\\log3}{\\log2}. \\end{aligned} \\] (The equation is also satisfied by \\(x=1,\\) which is not a listed choice.)\n\nTherefore, the correct answer is D.",
      "hints": [
        "Let \\(t=2^x\\) and solve a quadratic in \\(t\\)",
        "One root is \\(t=6\\); take logarithms base \\(2\\)"
      ],
      "images": []
    }
  ],
