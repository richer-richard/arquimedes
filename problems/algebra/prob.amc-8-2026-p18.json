  "solutions": [
    {
      "id": "sol.amc-8-2026-p18.live",
      "kind": "proof-sketch",
      "text": "Suppose there are \\(k\\ge2\\) terms, starting with odd positive integer \\(a\\). The sum is \\(a+(a+2)+\\cdots+(a+2k-2)\\) \\(=k(a+k-1)\\) \\(=60\\). Testing divisors \\(k\\) of \\(60\\), the positive odd starts occur for \\(k=2\\), giving \\(29+31\\), and for \\(k=6\\), giving \\(5+7+9+11+13+15\\). Thus there are \\(2\\) ways.",
      "hints": [
        "Write the terms as \\(a,a+2,\\ldots,a+2(k-1)\\)",
        "Their sum is \\(k(a+k-1)\\), so \\(k\\) must divide \\(60\\)"
      ],
      "images": []
    }
  ],
