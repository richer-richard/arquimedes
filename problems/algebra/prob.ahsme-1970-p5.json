  "estimatedMinutes": 1,
  "statement": "If \\(f(x)=\\dfrac{x^4+x^2}{x+1},\\) then \\(f(i),\\) where \\(i=\\sqrt{-1},\\) is equal to:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(1+i\\)"
    },
    {
      "label": "B",
      "text": "\\(1\\)"
    },
    {
      "label": "C",
      "text": "\\(-1\\)"
    },
    {
      "label": "D",
      "text": "\\(0\\)"
    },
    {
      "label": "E",
      "text": "\\(-1-i\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": "0"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1970-p5.live",
      "kind": "proof-sketch",
      "text": "Because \\(i^2=-1\\) and \\(i^4=1,\\) \\[ f(i)=\\frac{i^4+i^2}{i+1}=\\frac{1-1}{i+1}=0. \\]\n\nTherefore, the correct answer is D.",
      "hints": [
        "Use \\(i^2=-1\\) and \\(i^4=1\\)",
        "The numerator vanishes while the denominator does not"
      ],
