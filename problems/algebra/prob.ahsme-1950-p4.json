  "estimatedMinutes": 1,
  "statement": "Reduced to lowest terms, \\[ \\frac{a^2-b^2}{ab}-\\frac{ab-b^2}{ab-a^2} \\] is equal to:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{a}{b}\\)"
