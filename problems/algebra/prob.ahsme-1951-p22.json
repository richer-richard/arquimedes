  "estimatedMinutes": 2,
  "statement": "The values of \\(a\\) in the equation \\(\\log_{10}(a^2-15a)=2\\) are:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{15\\pm\\sqrt{233}}{2}\\)"
    },
    {
      "label": "B",
      "text": "\\(20,\\) \\(-5\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{15\\pm\\sqrt{305}}{2}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\pm20\\)"
    },
    {
      "label": "E",
      "text": "None of these"
    }
  ],
  "answer": {
    "letter": "b",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1951-p22.live",
      "kind": "proof-sketch",
      "text": "The equation is equivalent to \\(a^2-15a=10^2=100,\\) so \\[ \\begin{aligned} &a^2-15a-100\\\\ &\\quad=(a-20)(a+5)\\\\ &\\quad=0. \\end{aligned} \\] Both \\(a=20\\) and \\(a=-5\\) make the logarithm’s argument \\(100,\\) so both are valid.\n\nThus, the correct answer is B.",
      "hints": [
        "Convert the logarithmic equation to exponential form",
        "Solve \\(a^2-15a=100\\)"
      ],
