  "estimatedMinutes": 1,
  "statement": "A carton contains milk that is \\(2\\%\\) fat, an amount that is \\(40\\%\\) less fat than the amount contained in a carton of whole milk. What is the percentage of fat in whole milk?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{12}{5}\\)"
    },
    {
      "label": "B",
      "text": "\\(3\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{10}{3}\\)"
    },
    {
      "label": "D",
      "text": "\\(38\\)"
    },
    {
      "label": "E",
      "text": "\\(42\\)"
    }
  ],
  "answer": {
    "letter": "c",
    "value": "10/3"
  },
  "solutions": [
    {
      "id": "sol.amc-10a-2009-p7.live",
      "kind": "proof-sketch",
      "text": "Let whole milk be \\(x\\%\\) fat. Since \\(2\\) is \\(40\\%\\) less than \\(x,\\) we have \\[0.6x = 2,\\] so \\[x = \\dfrac{2}{0.6} = \\dfrac{10}{3}.\\]\n\nThus, the correct answer is C.",
      "hints": [
        "\\(40\\%\\) less than \\(x\\) means \\(60\\%\\) of \\(x\\)",
        "Solve \\(0.6x = 2\\)"
      ],
      "images": []
    }
  ],
