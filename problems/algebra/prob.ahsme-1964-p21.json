  "estimatedMinutes": 1,
  "statement": "If \\(\\log_{b^2}x+\\log_{x^2}b=1,\\) where \\(b\\gt0,\\) \\(b\\ne1,\\) and \\(x\\ne1,\\) then \\(x\\) equals:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac1{b^2}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac1b\\)"
    },
    {
      "label": "C",
      "text": "\\(b^2\\)"
    },
    {
      "label": "D",
      "text": "\\(b\\)"
    },
    {
      "label": "E",
      "text": "\\(\\sqrt b\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1964-p21.live",
      "kind": "proof-sketch",
      "text": "Let \\(t=\\log_bx.\\) Then \\(\\log_{b^2}x=\\frac{t}{2}\\) and \\(\\log_{x^2}b=\\frac{1}{2t}.\\) Thus \\[t+\\frac1t=2,\\] so \\((t-1)^2=0\\) and \\(t=1.\\) Hence \\(x=b.\\)\n\nTherefore, the correct answer is D.",
      "hints": [
        "Let \\(t=\\log_bx\\)",
        "The equation becomes \\(\\frac t2+\\frac1{2t}=1\\)"
      ],
      "images": []
    }
  ],
