  "solutions": [
    {
      "id": "sol.ahsme-1952-p7.live",
      "kind": "proof-sketch",
      "text": "Combining the terms and then taking the reciprocal gives \\[ \\begin{aligned} \\left(\\frac1x+\\frac1y\\right)^{-1} &=\\left(\\frac{x+y}{xy}\\right)^{-1}\\\\ &=\\frac{xy}{x+y}. \\end{aligned} \\]\n\nThus, the correct answer is B.",
      "hints": [
        "First combine \\(\\frac{1}{x}+\\frac{1}{y}\\) into one fraction",
        "The exponent \\(-1\\) then takes the reciprocal"
      ],
