  "estimatedMinutes": 1,
  "statement": "Which statement is correct?",
  "answerChoices": [
    {
      "label": "A",
      "text": "If \\(x\\lt0,\\) then \\(x^2\\gt x.\\)"
    },
    {
      "label": "B",
      "text": "If \\(x^2\\gt0,\\) then \\(x\\gt0.\\)"
    },
    {
      "label": "C",
      "text": "If \\(x^2\\gt x,\\) then \\(x\\gt0.\\)"
    },
    {
      "label": "D",
      "text": "If \\(x^2\\gt x,\\) then \\(x\\lt0.\\)"
    },
    {
      "label": "E",
      "text": "If \\(x\\lt1,\\) then \\(x^2\\lt x.\\)"
    }
  ],
