      "label": "C",
      "text": "\\(24\\)"
    },
    {
      "label": "D",
      "text": "\\(30\\)"
    },
    {
      "label": "E",
      "text": "\\(36\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": "30"
