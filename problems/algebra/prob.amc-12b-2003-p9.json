  "estimatedMinutes": 1,
  "statement": "Let \\(f\\) be a linear function for which \\(f(6) - f(2) = 12.\\) What is \\(f(12) - f(2)?\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(12\\)"
    },
    {
      "label": "B",
      "text": "\\(18\\)"
    },
