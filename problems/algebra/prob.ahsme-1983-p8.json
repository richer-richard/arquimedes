  "estimatedMinutes": 1,
  "statement": "Let \\(f(x)=\\frac{x+1}{x-1}.\\) Then for \\(x^2\\ne1,\\) \\(f(-x)\\) is",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\frac1{f(x)}\\)"
    },
    {
      "label": "B",
      "text": "\\(-f(x)\\)"
    },
    {
      "label": "C",
      "text": "\\(\\frac1{f(-x)}\\)"
    },
    {
      "label": "D",
      "text": "\\(-f(-x)\\)"
    },
    {
      "label": "E",
      "text": "\\(f(x)\\)"
    }
  ],
  "answer": {
    "letter": "a",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1983-p8.live",
      "kind": "proof-sketch",
      "text": "We have \\[ \\begin{aligned} f(-x)&=\\frac{-x+1}{-x-1}\\\\ &=\\frac{x-1}{x+1}=\\frac1{f(x)}. \\end{aligned} \\] The restriction \\(x^2\\ne1\\) makes all displayed quantities defined.\n\nTherefore, the correct answer is A.",
      "hints": [
        "Substitute \\(-x\\) directly into the formula",
        "Multiply numerator and denominator of \\(f(-x)\\) by \\(-1\\)"
      ],
      "images": []
    }
  ],
