  "estimatedMinutes": 2,
  "statement": "A piece of string is cut in two at a point selected at random. The probability that the longer piece is at least \\(x\\) times as large as the shorter piece is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac12\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac2x\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac1{x+1}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac1x\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac2{x+1}\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1972-p17.live",
      "kind": "proof-sketch",
      "text": "Take the string to have length \\(1.\\) Near one endpoint, the condition is \\[ 1-t\\ge xt, \\] so \\(t\\le\\frac{1}{x+1}.\\) The same interval occurs at the other endpoint. Their total length, hence the probability, is \\[ \\frac2{x+1}. \\]\n\nTherefore, the correct answer is E.",
      "hints": [
        "Normalize the string length to \\(1\\) and let the cut be \\(t\\) units from one end",
        "Near either endpoint, solve \\(1-t\\ge xt\\)"
      ],
      "images": []
    }
  ],
