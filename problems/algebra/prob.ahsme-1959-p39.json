  "estimatedMinutes": 1,
  "statement": "Let \\(S\\) be the sum of the first nine terms of the sequence\n\n\\[ \\begin{gathered} x+a,\\quad x^2+2a,\\\\ x^3+3a,\\quad\\ldots. \\end{gathered} \\]\n\nThen \\(S\\) equals:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{50a+x+x^8}{x+1}\\)"
    },
    {
      "label": "B",
      "text": "\\(50a-\\dfrac{x+x^{10}}{x-1}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{x^9-1}{x+1}+45a\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{x^{10}-x}{x-1}+45a\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{x^{11}-x}{x-1}+45a\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1959-p39.live",
      "kind": "proof-sketch",
      "text": "Adding the first nine terms gives \\[ \\begin{aligned} S={}&(x+x^2+\\cdots+x^9)\\\\ &{}+(1+2+\\cdots+9)a. \\end{aligned} \\] Therefore \\[ S=\\frac{x^{10}-x}{x-1}+45a. \\] The expression is understood by continuity at \\(x=1,\\) where both forms equal \\(9+45a.\\)\n\nThus, the correct answer is D.",
      "hints": [
        "Separate the powers of \\(x\\) from the multiples of \\(a\\)",
        "Use the geometric-series sum for \\(x+x^2+\\cdots+x^9\\)"
      ],
      "images": []
    }
  ],
