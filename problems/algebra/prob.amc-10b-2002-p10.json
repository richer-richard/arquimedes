  "estimatedMinutes": 2,
  "statement": "Suppose that \\(a\\) and \\(b\\) are nonzero real numbers, and that the equation \\(x^2 + ax + b = 0\\) has solutions \\(a\\) and \\(b.\\) What is the pair \\((a, b)?\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\((-2, 1)\\)"
    },
    {
      "label": "B",
      "text": "\\((-1, 2)\\)"
    },
    {
      "label": "C",
      "text": "\\((1, -2)\\)"
    },
    {
      "label": "D",
      "text": "\\((2, -1)\\)"
    },
    {
      "label": "E",
      "text": "\\((4, 4)\\)"
    }
  ],
