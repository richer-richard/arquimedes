  "estimatedMinutes": 1,
  "statement": "If \\(y=a+\\dfrac bx,\\) where \\(a\\) and \\(b\\) are constants, and if \\(y=1\\) when \\(x=-1,\\) and \\(y=5\\) when \\(x=-5,\\) then \\(a+b\\) equals:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(-1\\)"
    },
    {
      "label": "B",
      "text": "\\(0\\)"
    },
    {
      "label": "C",
      "text": "\\(1\\)"
    },
    {
      "label": "D",
      "text": "\\(10\\)"
    },
    {
      "label": "E",
      "text": "\\(11\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": "11"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1959-p17.live",
      "kind": "proof-sketch",
      "text": "The two conditions give \\[ a-b=1,\\qquad a-\\frac b5=5. \\] Subtracting yields \\(\\frac{4b}{5}=4,\\) so \\(b=5\\) and \\(a=6.\\) Therefore \\(a+b=11.\\)\n\nThus, the correct answer is E.",
      "hints": [
        "Substitute the two given input-output pairs",
        "Solve \\(a-b=1\\) and \\(a-\\frac{b}{5}=5\\)"
      ],
