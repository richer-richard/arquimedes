  "estimatedMinutes": 1,
  "statement": "If \\(\\dfrac1x-\\dfrac1y=\\dfrac1z,\\) then \\(z\\) equals:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(y-x\\)"
    },
    {
      "label": "B",
      "text": "\\(x-y\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{y-x}{xy}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{xy}{y-x}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{xy}{x-y}\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1958-p2.live",
      "kind": "proof-sketch",
      "text": "Combining the fractions, \\[ \\frac1z=\\frac1x-\\frac1y =\\frac{y-x}{xy}. \\] Taking reciprocals gives \\[ z=\\frac{xy}{y-x}. \\]\n\nTherefore, the correct answer is D.",
      "hints": [
        "Combine \\(\\frac{1}{x}-\\frac{1}{y}\\) over a common denominator",
        "After finding \\(\\frac{1}{z},\\) take the reciprocal to obtain \\(z\\)"
      ],
