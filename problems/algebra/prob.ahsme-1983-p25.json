  "estimatedMinutes": 2,
  "statement": "If \\(60^a=3\\) and \\(60^b=5,\\) then \\(12^{\\frac{1-a-b}{2(1-b)}}\\) is",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\sqrt3\\)"
    },
