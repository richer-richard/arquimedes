  "solutions": [
    {
      "id": "sol.ahsme-1984-p20.live",
      "kind": "proof-sketch",
      "text": "If \\(x-|2x+1|=3,\\) then \\(|2x+1|=x-3,\\) which requires \\(x\\ge3\\) and yields no solution. If \\(x-|2x+1|=-3,\\) then \\(|2x+1|=x+3.\\) Its two linear cases give \\(x=2\\) and \\(x=-\\frac{4}{3},\\) both valid. Thus there are \\(2\\) distinct solutions.\n\nTherefore, the correct answer is C.",
      "hints": [
        "Split the outer absolute value into two equations",
        "For each equation, isolate \\(|2x+1|\\) before checking its two cases"
      ],
      "images": []
    }
  ],
