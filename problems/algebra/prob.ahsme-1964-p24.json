  "estimatedMinutes": 1,
  "statement": "Let \\(y=(x-a)^2+(x-b)^2,\\) \\(a,\\) \\(b\\) constants. For what value of \\(x\\) is \\(y\\) a minimum?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{a+b}{2}\\)"
    },
    {
      "label": "B",
      "text": "\\(a+b\\)"
    },
    {
      "label": "C",
      "text": "\\(\\sqrt{ab}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\sqrt{\\dfrac{a^2+b^2}{2}}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{a+b}{2ab}\\)"
    }
  ],
  "answer": {
    "letter": "a",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1964-p24.live",
      "kind": "proof-sketch",
      "text": "Expanding and completing the square gives \\[y=2\\left(x-\\frac{a+b}{2}\\right)^2+\\frac{(a-b)^2}{2}.\\] The squared term is minimized at \\(x=\\frac{a+b}{2}.\\)\n\nTherefore, the correct answer is A.",
      "hints": [
        "Expand and collect the terms in \\(x\\)",
        "Complete the square or use the vertex formula"
      ],
      "images": []
    }
  ],
