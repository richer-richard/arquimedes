  "estimatedMinutes": 1,
  "statement": "The number of ounces of water needed to reduce \\(9\\) ounces of shaving lotion containing \\(50\\%\\) alcohol to a lotion containing \\(30\\%\\) alcohol is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(3\\)"
    },
    {
      "label": "B",
      "text": "\\(4\\)"
    },
    {
      "label": "C",
      "text": "\\(5\\)"
    },
    {
      "label": "D",
      "text": "\\(6\\)"
    },
    {
      "label": "E",
      "text": "\\(7\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": "6"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1953-p9.live",
      "kind": "proof-sketch",
      "text": "The lotion initially contains \\(9(0.50)=4.5\\) ounces of alcohol. If \\(w\\) ounces of water are added, then \\[ \\frac{4.5}{9+w}=0.30. \\] Hence \\(9+w=15\\) and \\(w=6.\\)\n\nThus, the correct answer is D.",
      "hints": [
        "The amount of alcohol stays fixed when water is added",
        "Set \\(\\frac{4.5}{9+w}=0.30\\)"
      ],
      "images": []
    }
  ],
