  "solutions": [
    {
      "id": "sol.amc-10a-2006-p2.live",
      "kind": "proof-sketch",
      "text": "The inner operation gives \\(h \\otimes h = h^3 - h.\\) Then \\[ \\begin{aligned} h \\otimes (h^3 - h) &= h^3 - (h^3 - h) \\\\ &= h. \\end{aligned} \\]\n\nThus, the correct answer is C.",
      "hints": [
        "First evaluate the inner \\(h \\otimes h\\)",
        "\\(h \\otimes h = h^3 - h,\\) then apply the operation again"
      ],
