  "solutions": [
    {
      "id": "sol.ahsme-1950-p40.live",
      "kind": "proof-sketch",
      "text": "For \\(x\\ne1,\\) \\[ \\begin{aligned} \\frac{x^2-1}{x-1} &=\\frac{(x-1)(x+1)}{x-1}\\\\ &=x+1. \\end{aligned} \\] Therefore the limit as \\(x\\) approaches \\(1\\) is \\(1+1=2.\\)\n\nThus, the correct answer is D.",
      "hints": [
        "Factor the numerator as a difference of squares",
        "For \\(x\\ne1,\\) cancel the common factor \\(x-1\\)"
      ],
      "images": []
    }
  ],
