  "solutions": [
    {
      "id": "sol.ahsme-1986-p9.live",
      "kind": "proof-sketch",
      "text": "For each \\(n,\\) \\[ 1-\\frac1{n^2}=\\frac{n-1}{n}\\cdot\\frac{n+1}{n}. \\] Therefore the product telescopes: \\[ \\begin{aligned} \\prod_{n=2}^{10}\\left(1-\\frac1{n^2}\\right) &=\\left(\\frac12\\right) \\left(\\frac{11}{10}\\right)\\\\ &=\\frac{11}{20}. \\end{aligned} \\]\n\nThus the correct answer is C.",
      "hints": [
        "Factor \\(1-\\frac{1}{n^2}\\) as a difference of squares",
        "Separate the product into factors \\(\\frac{n-1}{n}\\) and \\(\\frac{n+1}{n}\\)"
      ],
      "images": []
    }
  ],
