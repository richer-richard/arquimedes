      "text": "\\(\\frac5{12}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\frac12\\)"
    },
    {
      "label": "C",
      "text": "\\(\\frac{11}{20}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\frac23\\)"
    },
    {
      "label": "E",
      "text": "\\(\\frac7{10}\\)"
    }
  ],
  "answer": {
