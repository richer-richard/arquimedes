  "estimatedMinutes": 2,
  "statement": "For how many positive integers \\(x\\) is \\(\\log_{10}(x - 40)\\) \\(+ \\log_{10}(60 - x) \\lt 2?\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(10\\)"
    },
    {
      "label": "B",
      "text": "\\(18\\)"
    },
