  "estimatedMinutes": 1,
  "statement": "If \\(x\\) is such that \\(\\dfrac1x\\lt2\\) and \\(\\dfrac1x\\gt-3,\\) then:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(-\\dfrac13\\lt x\\lt\\dfrac12\\)"
    },
    {
      "label": "B",
      "text": "\\(-\\dfrac12\\lt x\\lt3\\)"
    },
    {
      "label": "C",
      "text": "\\(x\\gt\\dfrac12\\)"
    },
    {
      "label": "D",
      "text": "\\(x\\gt\\dfrac12\\) or \\(-\\dfrac13\\lt x\\lt0\\)"
    },
    {
      "label": "E",
      "text": "\\(x\\gt\\dfrac12\\) or \\(x\\lt-\\dfrac13\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1968-p16.live",
      "kind": "proof-sketch",
      "text": "For \\(x\\gt0,\\) \\(\\frac{1}{x}\\lt2\\) gives \\(x\\gt\\frac{1}{2},\\) while the other inequality is automatic. For \\(x\\lt0,\\) \\(\\frac{1}{x}\\gt-3\\) gives \\(x\\lt-\\frac{1}{3},\\) while the first is automatic. Thus \\(x\\gt\\frac{1}{2}\\) or \\(x\\lt-\\frac{1}{3}.\\)\n\nTherefore, the correct answer is E.",
      "hints": [
        "Combine the conditions as \\(-3\\lt\\frac{1}{x}\\lt2\\)",
        "Treat positive and negative \\(x\\) separately when taking reciprocals"
      ],
      "images": []
    }
  ],
