  "solutions": [
    {
      "id": "sol.ahsme-1977-p7.live",
      "kind": "proof-sketch",
      "text": "Let \\(u=\\sqrt[4]{2}.\\) Since \\[ \\begin{aligned} &(1-u)\\bigl(-(1+u)(1+u^2)\\bigr)\\\\ &\\qquad=-(1-u^2)(1+u^2)\\\\ &\\qquad=u^4-1=1, \\end{aligned} \\] it follows that \\[ t=-(1+\\sqrt[4]{2})(1+\\sqrt2). \\]\n\nTherefore, the correct answer is E.",
      "hints": [
        "Let \\(u=\\sqrt[4]{2}\\) and use \\(u^4=2\\)",
        "Factor \\(u^4-1\\) into a linear factor, a second linear factor, and a quadratic factor"
      ],
      "images": []
    }
  ],
