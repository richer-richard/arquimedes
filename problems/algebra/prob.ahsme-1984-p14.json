  "estimatedMinutes": 1,
  "statement": "The product of all real roots of the equation \\(x^{\\log_{10}x}=10\\) is",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(1\\)"
    },
    {
      "label": "B",
      "text": "\\(-1\\)"
    },
    {
      "label": "C",
      "text": "\\(10\\)"
    },
    {
      "label": "D",
      "text": "\\(10^{-1}\\)"
    },
    {
      "label": "E",
      "text": "none of these"
    }
  ],
  "answer": {
    "letter": "a",
    "value": "1"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1984-p14.live",
      "kind": "proof-sketch",
      "text": "The logarithm requires \\(x\\gt0.\\) Taking base-\\(10\\) logarithms gives \\[ (\\log_{10}x)^2=1. \\] Thus \\(\\log_{10}x=\\pm1,\\) so the two roots are \\(10\\) and \\(10^{-1},\\) whose product is \\(1.\\)\n\nTherefore, the correct answer is A.",
      "hints": [
        "Take the base-\\(10\\) logarithm of both sides",
        "Let \\(t=\\log_{10}x\\) and solve the resulting equation in \\(t\\)"
      ],
      "images": []
    }
  ],
