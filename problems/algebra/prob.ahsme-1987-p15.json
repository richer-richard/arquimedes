  "solutions": [
    {
      "id": "sol.ahsme-1987-p15.live",
      "kind": "proof-sketch",
      "text": "The second equation becomes \\[ \\begin{aligned} xy(x+y)&+(x+y)\\\\ &=(xy+1)(x+y)\\\\ &=63. \\end{aligned} \\] Since \\(xy=6,\\) we get \\(x+y=9.\\) Therefore \\[ \\begin{aligned} x^2+y^2 &=(x+y)^2-2xy\\\\ &=81-12=69. \\end{aligned} \\]\n\nThus the correct answer is D.",
      "hints": [
        "Factor the second equation using \\(x+y\\)",
        "Use \\(x^2+y^2=(x+y)^2-2xy\\)"
      ],
