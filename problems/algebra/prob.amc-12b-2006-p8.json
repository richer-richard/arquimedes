  "estimatedMinutes": 1,
  "statement": "The lines \\[x = \\tfrac14 y + a, \\qquad y = \\tfrac14 x + b\\] intersect at the point \\((1, 2).\\) What is \\(a + b?\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(0\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{3}{4}\\)"
    },
    {
      "label": "C",
      "text": "\\(1\\)"
    },
    {
      "label": "D",
      "text": "\\(2\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{9}{4}\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": "9/4"
  },
  "solutions": [
    {
      "id": "sol.amc-12b-2006-p8.live",
      "kind": "proof-sketch",
      "text": "Substituting \\((1, 2)\\) gives \\[1 = \\frac{2}{4} + a \\quad\\Rightarrow\\quad a = \\frac{1}{2},\\] and \\[2 = \\frac{1}{4} + b \\quad\\Rightarrow\\quad b = \\frac{7}{4}.\\]\n\nTherefore \\[a + b = \\frac{1}{2} + \\frac{7}{4} = \\frac{9}{4}.\\]\n\nThus, the correct answer is E.",
      "hints": [
        "Substitute \\(x = 1\\) and \\(y = 2\\) into both equations",
        "Solve each equation for \\(a\\) and \\(b\\) separately, then add"
      ],
