  "estimatedMinutes": 1,
  "statement": "When the decimal point of a certain positive decimal number is moved four places to the right, the new number is four times the reciprocal of the original number. What is the original number?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(0.0002\\)"
    },
    {
      "label": "B",
      "text": "\\(0.002\\)"
