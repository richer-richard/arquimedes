    },
    {
      "label": "C",
      "text": "\\(2\\)"
    },
    {
      "label": "D",
      "text": "\\(\\sqrt{\\log_2 3} + \\sqrt{\\log_3 2}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\sqrt{\\log_2 6} + \\sqrt{\\log_3 6}\\)"
    }
