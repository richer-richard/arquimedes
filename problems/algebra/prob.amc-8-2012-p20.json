      "text": "\\( \\dfrac{5}{19} \\lt \\dfrac{9}{23} \\lt \\dfrac{7}{21}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{7}{21} \\lt \\dfrac{5}{19} \\lt \\dfrac{9}{23} \\)"
    }
