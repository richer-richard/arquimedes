  "estimatedMinutes": 1,
  "statement": "Define a sequence of real numbers \\(a_1,\\) \\(a_2,\\) \\(a_3,\\) \\(\\ldots\\) by \\(a_1 = 1\\) and \\(a_{n+1}^3 = 99 a_n^3\\) for all \\(n \\ge 1.\\) Then \\(a_{100}\\) equals",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(33^{33}\\)"
    },
    {
      "label": "B",
      "text": "\\(33^{99}\\)"
    },
    {
      "label": "C",
      "text": "\\(99^{33}\\)"
    },
    {
      "label": "D",
      "text": "\\(99^{99}\\)"
    },
    {
      "label": "E",
      "text": "none of these"
    }
  ],
