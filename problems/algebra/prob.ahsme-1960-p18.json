  "estimatedMinutes": 1,
  "statement": "The pair of equations \\(3^{x+y}=81\\) and \\(81^{x-y}=3\\) has:",
  "answerChoices": [
    {
      "label": "A",
      "text": "no common solution"
    },
    {
      "label": "B",
      "text": "the solution \\(x=2,\\) \\(y=2\\)"
    },
    {
      "label": "C",
      "text": "the solution \\(x=2\\dfrac12,\\) \\(y=1\\dfrac12\\)"
    },
    {
      "label": "D",
      "text": "a common solution in positive and negative integers"
    },
    {
      "label": "E",
      "text": "none of these"
    }
  ],
  "answer": {
    "letter": "e",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1960-p18.live",
      "kind": "proof-sketch",
      "text": "The first equation gives \\(x+y=4.\\) The second gives \\[ 3^{4(x-y)}=3, \\] so \\(x-y=\\frac{1}{4}.\\) Therefore \\(x=\\frac{17}{8}\\) and \\(y=\\frac{15}{8}.\\) This pair is not listed among the first four choices.\n\nThus, the correct answer is E.",
      "hints": [
        "Rewrite \\(81\\) as \\(3^4\\) in both equations",
        "Solve the resulting system for \\(x+y\\) and \\(x-y\\)"
      ],
      "images": []
    }
  ],
