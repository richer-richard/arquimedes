  "estimatedMinutes": 1,
  "statement": "If the points \\((1,y_1)\\) and \\((-1,y_2)\\) lie on the graph of \\(y=ax^2+bx+c,\\) and \\(y_1-y_2=-6,\\) then \\(b\\) equals:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(-3\\)"
    },
    {
      "label": "B",
      "text": "\\(0\\)"
    },
    {
      "label": "C",
      "text": "\\(3\\)"
    },
    {
      "label": "D",
      "text": "\\(\\sqrt{ac}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{a+c}{2}\\)"
    }
  ],
  "answer": {
    "letter": "a",
    "value": "-3"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1969-p7.live",
      "kind": "proof-sketch",
      "text": "We have \\(y_1=a+b+c\\) and \\(y_2=a-b+c.\\) Therefore \\(y_1-y_2=2b=-6,\\) so \\(b=-3.\\)\n\nTherefore, the correct answer is A.",
      "hints": [
        "Substitute \\(x=1\\) and \\(x=-1\\)",
        "Subtract the two resulting values; the \\(a\\) and \\(c\\) terms cancel"
      ],
      "images": []
    }
  ],
