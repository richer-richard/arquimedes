    {
      "id": "sol.ahsme-1957-p13.live",
      "kind": "proof-sketch",
      "text": "Since \\[ \\begin{gathered} \\sqrt2\\approx1.414<1.5,\\\\ 1.5<1.732\\approx\\sqrt3, \\end{gathered} \\] the rational number \\(1.5\\) lies between the two radicals.\n\nTherefore, the correct answer is C.",
      "hints": [
        "Compare the decimal choices with \\(\\sqrt2\\approx1.414\\) and \\(\\sqrt3\\approx1.732\\)",
        "The radical expressions in the first two choices are irrational"
      ],
