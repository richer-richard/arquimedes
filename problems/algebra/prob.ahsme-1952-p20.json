  "estimatedMinutes": 1,
  "statement": "If \\(\\dfrac xy=\\dfrac34,\\) then the incorrect expression in the following is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{x+y}{y}=\\dfrac74\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{y}{y-x}=\\dfrac41\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{x+2y}{x}=\\dfrac{11}3\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{x}{2y}=\\dfrac38\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{x-y}{y}=\\dfrac14\\)"
    }
  ],
