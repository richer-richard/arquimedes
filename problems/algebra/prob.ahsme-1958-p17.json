  "estimatedMinutes": 1,
  "statement": "If \\(x\\) is positive and \\(\\log x\\ge\\log2+\\dfrac12\\log x,\\) then:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(x\\) has no minimum or maximum value"
    },
    {
      "label": "B",
      "text": "the maximum value of \\(x\\) is \\(1\\)"
    },
    {
      "label": "C",
      "text": "the minimum value of \\(x\\) is \\(1\\)"
    },
    {
      "label": "D",
      "text": "the maximum value of \\(x\\) is \\(4\\)"
    },
    {
      "label": "E",
      "text": "the minimum value of \\(x\\) is \\(4\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": "4"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1958-p17.live",
      "kind": "proof-sketch",
      "text": "The inequality gives \\[ \\frac12\\log x\\ge\\log2, \\] so \\(\\log x\\ge2\\log2=\\log4.\\) Hence \\(x\\ge4,\\) and the minimum possible value of \\(x\\) is \\(4.\\)\n\nTherefore, the correct answer is E.",
      "hints": [
        "Subtract \\(\\tfrac12\\log x\\) from both sides",
        "Double the resulting inequality and combine \\(2\\log2\\)"
      ],
      "images": []
    }
  ],
