  "estimatedMinutes": 1,
  "statement": "If \\(x\\) and \\(\\log_{10}x\\) are real numbers and \\(\\log_{10}x\\lt0,\\) then:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(x\\lt0\\)"
    },
    {
      "label": "B",
      "text": "\\(-1\\lt x\\lt1\\)"
    },
    {
      "label": "C",
      "text": "\\(0\\lt x\\leq1\\)"
    },
    {
      "label": "D",
      "text": "\\(-1\\lt x\\lt0\\)"
    },
    {
      "label": "E",
      "text": "\\(0\\lt x\\lt1\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1963-p5.live",
      "kind": "proof-sketch",
      "text": "The logarithm is real only for \\(x\\gt0.\\) Since base \\(10\\) is greater than \\(1,\\) \\(\\log_{10}x\\lt0=\\log_{10}1\\) implies \\(x\\lt1.\\)\n\nThus, the correct answer is E.",
      "hints": [
        "A real logarithm requires a positive argument",
        "Compare \\(x\\) with \\(10^0\\)"
      ],
      "images": []
    }
  ],
