  "estimatedMinutes": 1,
  "statement": "If \\(10^{\\log_{10}9}=8x+5,\\) then \\(x\\) equals:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(0\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac12\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac58\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac98\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{2\\log_{10}3-5}{8}\\)"
    }
  ],
  "answer": {
    "letter": "b",
    "value": "1/2"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1965-p6.live",
      "kind": "proof-sketch",
      "text": "The exponential and logarithm cancel, so \\(10^{\\log_{10}9}=9.\\) Thus \\(8x+5=9,\\) giving \\(x=\\frac{1}{2}.\\)\n\nTherefore, the correct answer is B.",
      "hints": [
        "Use \\(10^{\\log_{10}9}=9\\)",
        "Solve the resulting linear equation \\(9=8x+5\\)"
      ],
