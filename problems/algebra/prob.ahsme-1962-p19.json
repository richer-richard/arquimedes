  "solutions": [
    {
      "id": "sol.ahsme-1962-p19.live",
      "kind": "proof-sketch",
      "text": "The point \\((0,5)\\) gives \\(c=5.\\) The other two points give \\[ a-b=7,\\qquad 4a+2b=-8. \\] Solving yields \\(a=1\\) and \\(b=-6.\\) Hence \\(a+b+c=1-6+5=0.\\)\n\nThus, the correct answer is C.",
      "hints": [
        "The requested sum is the value of the parabola at \\(x=1\\)",
        "Use the three given points to solve for \\(a,\\) \\(b,\\) and \\(c\\)"
      ],
