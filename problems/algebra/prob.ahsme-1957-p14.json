  "solutions": [
    {
      "id": "sol.ahsme-1957-p14.live",
      "kind": "proof-sketch",
      "text": "The two radicands are \\((x-1)^2\\) and \\((x+1)^2.\\) Hence \\[ \\begin{aligned} y&=\\sqrt{(x-1)^2}\\\\ &\\quad+\\sqrt{(x+1)^2}\\\\ &=|x-1|+|x+1|. \\end{aligned} \\]\n\nThus, the correct answer is D.",
      "hints": [
        "Factor each radicand as a perfect square",
        "For real \\(u,\\) \\(\\sqrt{u^2}=|u|\\)"
      ],
      "images": []
    }
  ],
