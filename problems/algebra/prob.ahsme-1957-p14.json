  "estimatedMinutes": 1,
  "statement": "If \\(y=\\sqrt{x^2-2x+1}\\) \\({}+\\sqrt{x^2+2x+1},\\) then \\(y\\) is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(2x\\)"
    },
    {
      "label": "B",
      "text": "\\(2(x+1)\\)"
    },
    {
      "label": "C",
      "text": "\\(0\\)"
    },
    {
      "label": "D",
      "text": "\\(|x-1|+|x+1|\\)"
    },
    {
      "label": "E",
      "text": "none of these"
    }
  ],
  "answer": {
    "letter": "d",
    "value": null
