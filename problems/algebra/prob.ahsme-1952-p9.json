  "solutions": [
    {
      "id": "sol.ahsme-1952-p9.live",
      "kind": "proof-sketch",
      "text": "Clearing the denominator gives \\[ m(a-b)=cab. \\] Hence \\(ma=b(m+ca)\\), so \\[ b=\\frac{ma}{m+ca}. \\]\n\nThus, the correct answer is D.",
      "hints": [
        "Clear the denominator before collecting the terms containing \\(b\\)",
        "The equation becomes \\(ma=b(m+ca)\\)"
      ],
