  "estimatedMinutes": 1,
  "statement": "If \\(m=\\dfrac{cab}{a-b},\\) then \\(b\\) equals:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{m(a-b)}{ca}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{cab-ma}{-m}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac1{1+c}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{ma}{m+ca}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{m+ca}{ma}\\)"
    }
  ],
  "answer": {
