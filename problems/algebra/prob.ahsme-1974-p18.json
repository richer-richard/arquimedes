  "estimatedMinutes": 2,
  "statement": "If \\(\\log_8 3=p\\) and \\(\\log_3 5=q,\\) then, in terms of \\(p\\) and \\(q,\\) \\(\\log_{10}5\\) equals",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(pq\\)"
    },
    {
      "label": "B",
      "text": "\\(\\frac{3p+q}{5}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\frac{1+3pq}{p+q}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\frac{3pq}{1+3pq}\\)"
    },
    {
      "label": "E",
      "text": "\\(p^2+q^2\\)"
    }
  ],
