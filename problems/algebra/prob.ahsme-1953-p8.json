  "estimatedMinutes": 1,
  "statement": "The value of \\(x\\) at the intersection of \\(y=\\dfrac8{x^2+4}\\) and \\(x+y=2\\) is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(-2+\\sqrt5\\)"
