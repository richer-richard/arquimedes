  "solutions": [
    {
      "id": "sol.ahsme-1953-p8.live",
      "kind": "proof-sketch",
      "text": "Substitution gives \\[ (2-x)(x^2+4)=8. \\] Expanding and simplifying, \\[ x(x^2-2x+4)=0. \\] The quadratic factor has negative discriminant, so the real intersection has \\(x=0.\\)\n\nThus, the correct answer is C.",
      "hints": [
        "Substitute \\(y=2-x\\) into the rational equation",
        "After clearing the denominator, factor out \\(x\\)"
      ],
