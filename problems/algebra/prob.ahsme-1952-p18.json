  "estimatedMinutes": 1,
  "statement": "\\(\\log p+\\log q=\\log(p+q)\\) only if:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(p=q=0\\)"
    },
    {
      "label": "B",
      "text": "\\(p=\\dfrac{q^2}{1-q}\\)"
    },
    {
      "label": "C",
      "text": "\\(p=q=1\\)"
    },
    {
      "label": "D",
      "text": "\\(p=\\dfrac q{q-1}\\)"
    },
    {
      "label": "E",
      "text": "\\(p=\\dfrac q{q+1}\\)"
    }
  ],
