  "solutions": [
    {
      "id": "sol.ahsme-1970-p3.live",
      "kind": "proof-sketch",
      "text": "From \\(x=1+2^p\\) we get \\(2^p=x-1,\\) so \\[ \\begin{aligned} y&=1+2^{-p}\\\\ &=1+\\frac1{x-1}=\\frac{x}{x-1}. \\end{aligned} \\]\n\nTherefore, the correct answer is C.",
      "hints": [
        "Solve the first equation for \\(2^p\\)",
        "Use \\(2^{-p}=\\frac{1}{2^p}\\) and simplify \\(1+\\frac{1}{x-1}\\)"
      ],
      "images": []
    }
  ],
