  "estimatedMinutes": 1,
  "statement": "If \\(x=1+2^p\\) and \\(y=1+2^{-p},\\) then \\(y\\) in terms of \\(x\\) is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{x+1}{x-1}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{x+2}{x-1}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{x}{x-1}\\)"
    },
    {
      "label": "D",
      "text": "\\(2-x\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{x-1}{x}\\)"
    }
  ],
  "answer": {
    "letter": "c",
    "value": null
