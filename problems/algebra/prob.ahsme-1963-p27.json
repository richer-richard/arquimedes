  "estimatedMinutes": 1,
  "statement": "Six straight lines are drawn in a plane with no two parallel and no three concurrent. The number of regions into which they divide the plane is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(16\\)"
    },
