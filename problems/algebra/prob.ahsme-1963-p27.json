  "solutions": [
    {
      "id": "sol.ahsme-1963-p27.live",
      "kind": "proof-sketch",
      "text": "Successive lines create \\(1,2,\\ldots,6\\) new regions. Thus the total is \\[ 1+\\sum_{k=1}^{6}k=1+21=22. \\]\n\nTherefore, the correct answer is C.",
      "hints": [
        "The \\(k\\)th line is cut into \\(k\\) pieces by the previous lines",
        "Start with one region and add \\(1+2+\\cdots+6\\)"
      ],
