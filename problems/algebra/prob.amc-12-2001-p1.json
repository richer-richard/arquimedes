  "estimatedMinutes": 1,
  "statement": "The sum of two numbers is \\(S.\\) Suppose \\(3\\) is added to each number and then each of the resulting numbers is doubled. What is the sum of the final two numbers?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(2S + 3\\)"
    },
    {
      "label": "B",
      "text": "\\(3S + 2\\)"
    },
    {
      "label": "C",
      "text": "\\(3S + 6\\)"
    },
    {
      "label": "D",
      "text": "\\(2S + 6\\)"
    },
    {
      "label": "E",
      "text": "\\(2S + 12\\)"
    }
  ],
