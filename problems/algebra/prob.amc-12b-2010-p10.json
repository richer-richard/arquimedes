  "solutions": [
    {
      "id": "sol.amc-12b-2010-p10.live",
      "kind": "proof-sketch",
      "text": "The numbers \\(1\\) through \\(99\\) sum to \\(\\dfrac{99\\cdot100}{2}=4950.\\)\n\nThe average condition is \\[ \\frac{4950+x}{100}=100x, \\] so \\(4950+x=10000x\\) and \\(9999x=4950.\\)\n\nThus \\(x=\\dfrac{4950}{9999}=\\dfrac{50}{101}.\\)\n\nThus, the correct answer is B.",
      "hints": [
        "The sum \\(1+2+\\cdots+99\\) equals \\(4950\\)",
        "\\(\\dfrac{4950+x}{100}=100x\\)"
      ],
