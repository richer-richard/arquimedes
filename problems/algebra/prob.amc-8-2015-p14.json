  "solutions": [
    {
      "id": "sol.amc-8-2015-p14.live",
      "kind": "proof-sketch",
      "text": "Let the four consecutive odd integers be \\(2k+1,\\) \\(2k+3,\\) \\(2k+5,\\) and \\(2k+7.\\) Their sum is \\[8k+16=8(k+2).\\]\n\nSo any such sum must be a multiple of \\(8.\\) The only answer choice that is not divisible by \\(8\\) is \\(100.\\)\n\nThus, D is the correct answer.",
      "hints": [
        "Write the four consecutive odd integers algebraically.",
        "Their sum is always a multiple of \\(8.\\)"
      ],
