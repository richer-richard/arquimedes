  "estimatedMinutes": 1,
  "statement": "The factors of the expression \\(x^2+y^2\\) are:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\((x+y)(x-y)\\)"
    },
    {
      "label": "B",
      "text": "\\((x+y)^2\\)"
    },
    {
      "label": "C",
      "text": "\\((x^{\\frac{2}{3}}+y^{\\frac{2}{3}})(x^{\\frac{4}{3}}+y^{\\frac{4}{3}})\\)"
    },
    {
      "label": "D",
      "text": "\\((x+iy)(x-iy)\\)"
    },
    {
      "label": "E",
      "text": "none of these"
    }
  ],
  "answer": {
    "letter": "d",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1953-p3.live",
      "kind": "proof-sketch",
      "text": "Because \\(i^2=-1,\\) \\[ \\begin{aligned} (x+iy)(x-iy)&=x^2-(iy)^2\\\\ &=x^2+y^2. \\end{aligned} \\]\n\nThus, the correct answer is D.",
      "hints": [
        "Over the complex numbers, \\(i^2=-1\\)",
        "Rewrite \\(y^2\\) as \\(-(iy)^2\\) and use a difference of squares"
      ],
      "images": []
    }
