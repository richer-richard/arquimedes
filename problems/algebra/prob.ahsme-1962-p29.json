  "estimatedMinutes": 1,
  "statement": "Which of the following sets of \\(x\\)-values satisfy the inequality \\(2x^2+x\\lt6?\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(-2\\lt x\\lt\\dfrac32\\)"
    },
    {
      "label": "B",
      "text": "\\(x\\gt\\dfrac32\\) or \\(x\\lt-2\\)"
    },
    {
      "label": "C",
      "text": "\\(x\\lt\\dfrac32\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac32\\lt x\\lt2\\)"
    },
    {
      "label": "E",
      "text": "\\(x\\lt-2\\)"
    }
  ],
  "answer": {
    "letter": "a",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1962-p29.live",
      "kind": "proof-sketch",
      "text": "The inequality is \\(2x^2+x-6\\lt0.\\) Factoring gives \\((2x-3)(x+2)\\lt0.\\) The product is negative between its roots, so \\(-2\\lt x\\lt\\frac{3}{2}.\\)\n\nThus, the correct answer is A.",
      "hints": [
        "Move all terms to one side and factor the quadratic",
        "A product of two linear factors is negative between its roots"
      ],
      "images": []
    }
  ],
