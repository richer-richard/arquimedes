  "solutions": [
    {
      "id": "sol.ahsme-1977-p18.live",
      "kind": "proof-sketch",
      "text": "By change of base, \\[ \\begin{aligned} y&=\\frac{\\log 3}{\\log2}\\cdot \\frac{\\log4}{\\log3}\\cdots \\frac{\\log32}{\\log31}\\\\ &=\\frac{\\log32}{\\log2}\\\\ &=\\log_2 32=5. \\end{aligned} \\]\n\nTherefore, the correct answer is B.",
      "hints": [
        "Rewrite every logarithm using the same base",
        "Adjacent numerators and denominators cancel in the product"
      ],
