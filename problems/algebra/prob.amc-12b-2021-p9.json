  "estimatedMinutes": 2,
  "statement": "What is the value of the following expression? \\[\\dfrac{\\log_2 80}{\\log_{40}2}-\\dfrac{\\log_2 160}{\\log_{20}2}\\]",
  "answerChoices": [
