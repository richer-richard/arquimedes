  "estimatedMinutes": 2,
  "statement": "If \\(a^x=c^q=b\\) and \\(c^y=a^z=d,\\) then:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(xy=qz\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{x}{y}=\\dfrac{q}{z}\\)"
    },
    {
      "label": "C",
      "text": "\\(x+y=q+z\\)"
    },
    {
      "label": "D",
      "text": "\\(x-y=q-z\\)"
    },
    {
      "label": "E",
      "text": "\\(x^y=q^z\\)"
    }
  ],
