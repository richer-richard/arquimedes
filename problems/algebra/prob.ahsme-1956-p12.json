  "estimatedMinutes": 1,
  "statement": "If \\(x^{-1}-1\\) is divided by \\(x-1\\) the quotient is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(1\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac1{x-1}\\)"
    },
    {
      "label": "C",
      "text": "\\(-\\dfrac1{x-1}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac1x\\)"
    },
    {
      "label": "E",
      "text": "\\(-\\dfrac1x\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1956-p12.live",
      "kind": "proof-sketch",
      "text": "Where the quotient is defined, \\[ \\begin{aligned} \\frac{x^{-1}-1}{x-1} &=\\frac{\\frac{1-x}{x}}{x-1}\\\\ &=\\frac{-(x-1)}{x(x-1)}\\\\ &=-\\frac1x. \\end{aligned} \\]\n\nThus, the correct answer is E.",
      "hints": [
        "Rewrite \\(x^{-1}-1\\) as \\(\\frac{1}{x}-1\\)",
        "Factor \\(1-x=-(x-1)\\)"
      ],
      "images": []
    }
  ],
