  "solutions": [
    {
      "id": "sol.amc-10a-2002-p2.live",
      "kind": "proof-sketch",
      "text": "\\[ \\begin{aligned} (2,12,9) &= \\dfrac{2}{12}+\\dfrac{12}{9}+\\dfrac{9}{2} \\\\ &= \\dfrac{1}{6}+\\dfrac{4}{3}+\\dfrac{9}{2}. \\end{aligned} \\] Over a denominator of \\(6,\\) this is \\(\\dfrac{1+8+27}{6}=\\dfrac{36}{6}=6.\\)\n\nThus, the correct answer is C.",
      "hints": [
        "Substitute \\(a=2,\\) \\(b=12,\\) \\(c=9\\)",
        "Add \\(\\dfrac{2}{12}+\\dfrac{12}{9}+\\dfrac{9}{2}\\) over a common denominator"
