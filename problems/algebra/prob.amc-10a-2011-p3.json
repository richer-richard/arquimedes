  "estimatedMinutes": 1,
  "statement": "Suppose \\([a\\ b]\\) denotes the average of \\(a\\) and \\(b,\\) and \\(\\{a\\ b\\ c\\}\\) denotes the average of \\(a,\\) \\(b,\\) and \\(c.\\) What is the value of the following expression? \\[\\{\\{1 \\ 1 \\ 0\\} \\ [0 \\ 1] \\ 0\\}\\]",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{2}{9}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{5}{18}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{1}{3}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{7}{18}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{2}{3}\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": "7/18"
  },
  "solutions": [
    {
      "id": "sol.amc-10a-2011-p3.live",
      "kind": "proof-sketch",
      "text": "We have that \\[ \\{1 \\ 1 \\ 0\\} = \\dfrac{1 + 1 + 0}{3} = \\dfrac{2}{3}. \\]\n\nWe also get that \\[ [0 \\ 1] = \\dfrac{1 + 0}{2} = \\dfrac{1}{2}. \\]\n\nFinally, \\[ \\left\\{\\dfrac{2}{3} \\ \\dfrac{1}{2} \\ 0\\right\\} = \\dfrac{\\dfrac{2}{3} + \\dfrac{1}{2} + 0}{3} = \\dfrac{7}{18}.\\]\n\nThus, D is the correct answer.",
      "hints": [
        "Evaluate the inner averages first",
        "Use \\(\\{1\\ 1\\ 0\\}=\\dfrac23\\) and \\([0\\ 1]=\\dfrac12\\)"
      ],
      "images": []
    }
  ],
