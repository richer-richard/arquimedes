    {
      "id": "sol.hmmt-feb-calculus-2010-p8.hmmt",
      "kind": "proof-sketch",
      "text": "\\(3-e\\)\n\n\\[\\begin{aligned}\n\\sum_{n=2}^{\\infty} f(n) & =\\sum_{k=2}^{\\infty} \\sum_{n=2}^{\\infty} \\frac{1}{k^{n} \\cdot k!} \\\\\n& =\\sum_{k=2}^{\\infty} \\frac{1}{k!} \\sum_{n=2}^{\\infty} \\frac{1}{k^{n}} \\\\\n& =\\sum_{k=2}^{\\infty} \\frac{1}{k!} \\cdot \\frac{1}{k(k-1)} \\\\\n& =\\sum_{k=2}^{\\infty} \\frac{1}{(k-1)!} \\cdot \\frac{1}{k^{2}(k-1)}\n\\end{aligned}\\]\n\n\\[\\begin{aligned}\n& =\\sum_{k=2}^{\\infty} \\frac{1}{(k-1)!}\\left(\\frac{1}{k-1}-\\frac{1}{k^{2}}-\\frac{1}{k}\\right) \\\\\n& =\\sum_{k=2}^{\\infty}\\left(\\frac{1}{(k-1)(k-1)!}-\\frac{1}{k \\cdot k!}-\\frac{1}{k!}\\right) \\\\\n& =\\sum_{k=2}^{\\infty}\\left(\\frac{1}{(k-1)(k-1)!}-\\frac{1}{k \\cdot k!}\\right)-\\sum_{k=2}^{\\infty} \\frac{1}{k!} \\\\\n& =\\frac{1}{1 \\cdot 1!}-\\left(e-\\frac{1}{0!}-\\frac{1}{1!}\\right) \\\\\n& =3-e\n\\end{aligned}\\]",
      "hints": [],
      "images": []
    }
  ],
