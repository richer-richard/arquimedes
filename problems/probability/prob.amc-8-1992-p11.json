  "solutions": [
    {
      "id": "sol.amc-8-1992-p11.live",
      "kind": "proof-sketch",
      "text": "The total number surveyed is \\(50 + 60 + 40 + 60 + 40 = 250.\\)\n\nThe percent preferring blue is \\(\\dfrac{60}{250} = 24\\%.\\)\n\nThus, the correct answer is B .",
      "hints": [
        "Add the five counts to get the total number of people surveyed",
        "The percent preferring blue is (blue count) divided by (total), converted to a percent"
      ],
