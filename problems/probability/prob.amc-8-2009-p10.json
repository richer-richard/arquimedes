  "estimatedMinutes": 1,
  "statement": "On a checkerboard composed of \\(64\\) unit squares, what is the probability that a randomly chosen unit square does not touch the outer edge of the board?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{1}{16}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{7}{16}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{1}{2}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{9}{16}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{49}{64}\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": "9/16"
  },
  "solutions": [
    {
      "id": "sol.amc-8-2009-p10.live",
      "kind": "proof-sketch",
      "text": "There are \\[(8 - 2)^2 = 6^2 = 36\\] squares on the interior.\n\nThis means that the probability of choosing one of these squares is \\[ \\dfrac{36}{64} = \\dfrac{9}{16}. \\]\n\nThus, D is the correct answer.",
      "hints": [
        "Only the squares strictly inside the border do not touch the edge.",
        "An \\(8\\times8\\) board has a \\(6\\times6\\) interior."
      ],
