  "estimatedMinutes": 1,
  "statement": "Mary’s top book shelf holds five books with the following widths, in centimeters: \\(6,\\) \\(\\dfrac{1}{2},\\) \\(1,\\) \\(2.5,\\) and \\(10.\\)\n\nWhat is the average book width, in centimeters?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(1\\)"
    },
    {
      "label": "B",
      "text": "\\(2\\)"
    },
    {
      "label": "C",
      "text": "\\(3\\)"
    },
    {
      "label": "D",
      "text": "\\(4\\)"
    },
    {
      "label": "E",
      "text": "\\(5\\)"
    }
  ],
  "answer": {
    "letter": "d",
    "value": "4"
  },
  "solutions": [
    {
      "id": "sol.amc-10a-2010-p1.live",
      "kind": "proof-sketch",
      "text": "Adding the five widths gives \\(6+\\dfrac12+1+2.5+10=20.\\) The average is \\(20\\div5=4.\\)\n\nThus, D is the correct answer.",
      "hints": [
        "Add the widths before dividing by the number of books",
        "Compute \\(\\left(6+\\dfrac12+1+2.5+10\\right)\\div5\\)"
      ],
