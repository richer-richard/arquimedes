  "solutions": [
    {
      "id": "sol.amc-8-2008-p8.live",
      "kind": "proof-sketch",
      "text": "The four monthly sales are \\(100,\\) \\(60,\\) \\(40,\\) and \\(120\\) dollars.\n\nTheir average is \\(\\dfrac{100+60+40+120}{4}\\) \\(=\\dfrac{320}{4}\\) \\(=80\\) dollars.\n\nThus, D is the correct answer.",
      "hints": [
        "Read the four monthly bar heights from the chart.",
        "Average means total sales divided by \\(4\\) months."
      ],
