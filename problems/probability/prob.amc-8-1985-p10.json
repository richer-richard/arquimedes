  "estimatedMinutes": 1,
  "statement": "What fraction lies halfway between \\(\\dfrac15\\) and \\(\\dfrac13\\) on the number line?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{1}{4}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{2}{15}\\)"
    },
    {
