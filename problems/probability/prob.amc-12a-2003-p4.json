  "estimatedMinutes": 1,
  "statement": "It takes Mary \\(30\\) minutes to walk uphill \\(1\\) km from her home to school, but it takes her only \\(10\\) minutes to walk from school to home along the same route. What is her average speed, in km/hr, for the round trip?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(3\\)"
    },
    {
      "label": "B",
      "text": "\\(3.125\\)"
    },
    {
      "label": "C",
      "text": "\\(3.5\\)"
    },
    {
      "label": "D",
      "text": "\\(4\\)"
    },
    {
      "label": "E",
      "text": "\\(4.5\\)"
    }
  ],
  "answer": {
    "letter": "a",
    "value": "3"
  },
  "solutions": [
    {
      "id": "sol.amc-12a-2003-p4.live",
      "kind": "proof-sketch",
      "text": "Mary walks a total of \\(2\\) km in \\(30+10=40\\) minutes, which is \\(\\dfrac23\\) hour.\n\nHer average speed is \\(2 \\div \\dfrac23 = 3\\) km/hr.\n\nThus, the correct answer is A.",
      "hints": [
        "Average speed is total distance divided by total time",
        "The total time is \\(30+10=40\\) minutes \\(=\\dfrac23\\) hour"
      ],
      "images": []
    }
