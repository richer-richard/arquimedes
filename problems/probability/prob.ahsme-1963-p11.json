  "solutions": [
    {
      "id": "sol.ahsme-1963-p11.live",
      "kind": "proof-sketch",
      "text": "The original sum is \\(50\\cdot38=1900.\\) After removing \\(45+55=100,\\) the remaining sum is \\(1800,\\) so the new mean is \\(\\frac{1800}{48}=37.5.\\)\n\nThus, the correct answer is B.",
      "hints": [
        "Recover the original sum from the mean",
        "Subtract \\(45+55\\) and divide by \\(48\\)"
