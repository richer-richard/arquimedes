  "solutions": [
    {
      "id": "sol.amc-8-2013-p8.live",
      "kind": "proof-sketch",
      "text": "The outcomes with at least two consecutive heads are \\(HHT\\), \\(THH\\), and \\(HHH\\). There are \\(2^3=8\\) equally likely outcomes from three fair coin tosses, so the probability is \\(\\dfrac{3}{8}\\).\n\nThus, C is the correct answer.",
      "hints": [
        "List the \\(8\\) possible outcomes of three coin tosses.",
        "Count only outcomes containing \\(HH\\)."
      ],
