  "solutions": [
    {
      "id": "sol.ahsme-1954-p7.live",
      "kind": "proof-sketch",
      "text": "The original price was \\(\\$27.50.\\) The fraction saved was \\[ \\frac{2.50}{27.50}=\\frac1{11}\\approx0.0909, \\] or about \\(9\\%.\\)\n\nThus, the correct answer is B.",
      "hints": [
        "Add the savings to the sale price to recover the original price",
        "Compute \\(\\frac{2.50}{27.50}\\) as a percentage"
      ],
