  "estimatedMinutes": 1,
  "statement": "A housewife saved \\(\\$2.50\\) in buying a dress on sale. If she spent \\(\\$25\\) for the dress, she saved about:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(8\\%\\)"
    },
