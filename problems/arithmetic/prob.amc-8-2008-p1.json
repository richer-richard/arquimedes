  "solutions": [
    {
      "id": "sol.amc-8-2008-p1.live",
      "kind": "proof-sketch",
      "text": "Susan spent \\(2\\cdot 12=24\\) dollars on rides, so she spent \\(12+24=36\\) dollars total.\n\nShe had \\(50-36=14\\) dollars left.\n\nThus, B is the correct answer.",
      "hints": [
        "Find how much Susan spent on rides before subtracting from \\(50.\\)",
