  "estimatedMinutes": 1,
  "statement": "Which triplet of numbers has a sum NOT equal to \\(1?\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\((\\frac12,\\frac13,\\frac16)\\)"
    },
    {
