  "solutions": [
    {
      "id": "sol.amc-8-2014-p5.live",
      "kind": "proof-sketch",
      "text": "With \\(\\$20\\), Margie can buy \\(\\frac{20}{4}=5\\) gallons of gas.\n\nAt \\(32\\) miles per gallon, she can drive \\(5\\cdot32=160\\) miles.\n\nThus, C is the correct answer.",
      "hints": [
        "First find how many gallons \\(\\$20\\) buys.",
        "Multiply the gallons by \\(32\\) miles per gallon."
