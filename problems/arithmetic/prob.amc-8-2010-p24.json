  "estimatedMinutes": 2,
  "statement": "What is the correct ordering of the three numbers, \\(10^8,\\) \\(5^{12},\\) and \\(2^{24}?\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(2^{24} < 10^8 < 5^{12}\\)"
    },
    {
      "label": "B",
      "text": "\\( 2^{24} < 5^{12} < 10^8 \\)"
    },
    {
      "label": "C",
      "text": "\\( 5^{12} < 2^{24} < 10^8 \\)"
    },
    {
      "label": "D",
      "text": "\\( 10^8 < 5^{12} < 2^{24} \\)"
    },
    {
      "label": "E",
      "text": "\\( 10^8 < 2^{24} < 5^{12} \\)"
    }
  ],
