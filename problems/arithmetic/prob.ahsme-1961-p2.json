  "estimatedMinutes": 1,
  "statement": "An automobile travels \\(\\frac{a}{6}\\) feet in \\(r\\) seconds. If this rate is maintained for \\(3\\) minutes, how many yards does it travel in the \\(3\\) minutes?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{a}{1080r}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{30r}{a}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{30a}{r}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{10r}{a}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{10a}{r}\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1961-p2.live",
      "kind": "proof-sketch",
      "text": "The speed is \\(\\frac{a}{6r}\\) feet per second. In \\(180\\) seconds the automobile travels \\[ 180\\cdot\\frac{a}{6r}=\\frac{30a}{r} \\] feet, or \\(\\frac{10a}{r}\\) yards.\n\nThus, the correct answer is E.",
      "hints": [
        "Convert \\(3\\) minutes to seconds",
        "After finding the distance in feet, divide by \\(3\\) to convert to yards"
      ],
