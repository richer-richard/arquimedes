    "value": "11"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1971-p4.live",
      "kind": "proof-sketch",
      "text": "If \\(P\\) is the principal, then \\[ \\begin{aligned} 255.31&=P\\left(1+\\frac{0.05}{6}\\right)\\\\ &=P\\frac{121}{120}. \\end{aligned} \\] Hence \\(P=253.20,\\) so the interest is \\(\\$2.11\\) and its cents part is \\(11.\\)\n\nTherefore, the correct answer is A.",
      "hints": [
        "Two months is one-sixth of a year",
        "If \\(P\\) is the principal, solve \\(255.31=P(1+\\frac{0.05}{6})\\)"
      ],
      "images": []
    }
