  "estimatedMinutes": 1,
  "statement": "Estimate the time it takes to send \\(60\\) blocks of data over a communications channel if each block consists of \\(512\\) “chunks” and the channel can transmit \\(120\\) chunks per second.",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(0.04\\) seconds"
    },
    {
      "label": "B",
      "text": "\\(0.4\\) seconds"
    },
    {
      "label": "C",
      "text": "\\(4\\) seconds"
    },
    {
      "label": "D",
      "text": "\\(4\\) minutes"
    },
    {
      "label": "E",
      "text": "\\(4\\) hours"
    }
  ],
  "answer": {
    "letter": "d",
    "value": "4"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1988-p7.live",
      "kind": "proof-sketch",
      "text": "The transmission takes \\(\\frac{60\\cdot512}{120}=256\\) seconds, which is a little over \\(4\\) minutes.\n\nThus the correct answer is D.",
      "hints": [
        "Compute the total number of chunks first",
        "Convert the resulting number of seconds to minutes"
      ],
