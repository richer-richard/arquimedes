  "estimatedMinutes": 2,
  "statement": "Mr. Green receives a \\(10\\%\\) raise every year. His salary after four such raises has gone up by what percent?",
  "answerChoices": [
    {
      "label": "A",
      "text": "less than \\(40\\%\\)"
    },
    {
      "label": "B",
      "text": "\\(40\\%\\)"
    },
    {
      "label": "C",
      "text": "\\(44\\%\\)"
    },
    {
      "label": "D",
      "text": "\\(45\\%\\)"
    },
    {
      "label": "E",
      "text": "more than \\(45\\%\\)"
    }
  ],
  "answer": {
    "letter": "e",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.amc-8-1985-p21.live",
      "kind": "proof-sketch",
      "text": "After four raises the salary is multiplied by \\(1.1^4 = 1.4641.\\)\n\nThat is an increase of \\(46.41\\%,\\) which is more than \\(45\\%.\\)\n\nThus, the correct answer is E .",
      "hints": [
        "Applying a \\(10\\%\\) raise multiplies the salary by \\(1.1\\)",
        "After four raises the salary is multiplied by \\(1.1^4;\\) compare that to \\(1.45\\)"
      ],
