    {
      "id": "sol.amc-12-2000-p2.live",
      "kind": "proof-sketch",
      "text": "Writing \\(2000 = 2000^1,\\) we get \\[ \\begin{gathered} 2000^1 \\cdot 2000^{2000} \\\\ = 2000^{1 + 2000} \\\\ = 2000^{2001}. \\end{gathered} \\]\n\nAll of the other options are larger than this.\n\nThus, the correct answer is A.",
      "hints": [
        "Write the leading factor as \\(2000^1\\)",
        "Multiplying powers of the same base adds the exponents"
      ],
