      "text": "dividing by \\(\\dfrac{9}{20}\\)"
    },
    {
      "label": "C",
      "text": "multiplying by \\(\\dfrac{9}{20}\\)"
    },
    {
      "label": "D",
      "text": "dividing by \\(\\dfrac54\\)"
    },
    {
      "label": "E",
      "text": "multiplying by \\(\\dfrac54\\)"
    }
  ],
  "answer": {
