  "solutions": [
    {
      "id": "sol.amc-8-1995-p3.live",
      "kind": "proof-sketch",
      "text": "Dividing by \\(\\dfrac35\\) is the same as multiplying by \\(\\dfrac53,\\) so the two operations together multiply by\n\n\\[\\dfrac34 \\times \\dfrac53 = \\dfrac54.\\]\n\nSo the combined effect is multiplying by \\(\\dfrac54\\).\n\nThus, the correct answer is E .",
      "hints": [
        "Dividing by \\(\\dfrac35\\) is the same as multiplying by \\(\\dfrac53\\)",
        "Combine \\(\\dfrac34 \\times \\dfrac53\\) into a single fraction"
      ],
