  "solutions": [
    {
      "id": "sol.amc-10a-2004-p1.live",
      "kind": "proof-sketch",
      "text": "Including you, there are \\(6\\) people sharing the fundraising equally. Each must raise \\[ \\dfrac{1500}{6} = 250 \\] dollars.\n\nThus, the correct answer is A.",
      "hints": [
        "Including you, count the total number of people sharing the work",
        "Divide $\\(1500\\) evenly among the \\(6\\) people"
