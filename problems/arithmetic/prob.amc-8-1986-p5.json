  "solutions": [
    {
      "id": "sol.amc-8-1986-p5.live",
      "kind": "proof-sketch",
      "text": "Since \\(1000\\) minutes \\(= \\dfrac{1000}{60}\\) hours \\(= 16\\dfrac23\\) hours \\(= 16\\) hours \\(40\\) minutes, the contest ended \\(16\\) hours \\(40\\) minutes past noon, which is \\(4\\!:\\!40\\) a.m.\n\nThus, the correct answer is D .",
      "hints": [
        "Convert \\(1000\\) minutes into hours and minutes by dividing by \\(60\\)",
        "\\(1000\\) minutes is \\(16\\) hours and \\(40\\) minutes; add that to noon"
      ],
