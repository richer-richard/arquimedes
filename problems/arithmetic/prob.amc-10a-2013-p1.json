    {
      "id": "sol.amc-10a-2013-p1.live",
      "kind": "proof-sketch",
      "text": "The mileage charge is \\(\\$0.25\\cdot 5=\\$1.25\\).\n\nAdding the fixed charge gives \\(\\$1.50+\\$1.25=\\$2.75\\).\n\nThus, C is the correct answer.",
