  "estimatedMinutes": 1,
  "statement": "Martians measure angles in clerts. There are \\(500\\) clerts in a full circle. How many clerts are there in a right angle?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(90\\)"
    },
    {
      "label": "B",
      "text": "\\(100\\)"
    },
    {
      "label": "C",
      "text": "\\(125\\)"
    },
    {
      "label": "D",
      "text": "\\(180\\)"
    },
    {
      "label": "E",
      "text": "\\(250\\)"
    }
  ],
  "answer": {
    "letter": "c",
    "value": "125"
  },
  "solutions": [
    {
      "id": "sol.amc-8-1987-p4.live",
      "kind": "proof-sketch",
      "text": "A right angle is a quarter of a full circle, so it contains \\(\\dfrac14 \\times 500 = 125\\) clerts.\n\nThus, the correct answer is C .",
      "hints": [
        "A right angle is \\(\\dfrac14\\) of a full circle",
        "Take \\(\\dfrac14\\) of \\(500\\) clerts"
      ],
