  "solutions": [
    {
      "id": "sol.amc-8-2003-p3.live",
      "kind": "proof-sketch",
      "text": "We get that \\(120 - 30 = 90\\) grams are not filler. The percentage is therefore \\[ 100 \\cdot \\dfrac{90}{120} = 100 \\cdot \\dfrac{3}{4} = 75 \\%. \\]\n\nThus, D is the correct answer.",
      "hints": [
        "First find how many grams are not filler.",
        "Compare the non-filler grams to \\(120.\\)"
