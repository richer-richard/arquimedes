  "estimatedMinutes": 1,
  "statement": "A burger at Ricky C’s weighs \\(120\\) grams, of which \\(30\\) grams are filler. What percent of the burger is not filler?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(60 \\%\\)"
    },
    {
      "label": "B",
      "text": "\\(65 \\%\\)"
    },
    {
      "label": "C",
      "text": "\\(70 \\%\\)"
    },
    {
      "label": "D",
      "text": "\\(75 \\%\\)"
    },
    {
      "label": "E",
      "text": "\\(90 \\%\\)"
    }
  ],
