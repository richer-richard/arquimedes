  "solutions": [
    {
      "id": "sol.amc-12a-2004-p1.live",
      "kind": "proof-sketch",
      "text": "Since \\(\\$20\\) is \\(2000\\) cents, the tax is \\[ 0.0145 \\times 2000 = 29 \\] cents per hour.\n\nThus, the correct answer is E.",
      "hints": [
        "Convert \\(\\$20\\) into cents before taking the percentage",
        "\\(\\$20 = 2000\\) cents, and \\(1.45\\%\\) of that is the tax"
