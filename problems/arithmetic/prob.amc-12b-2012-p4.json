    "value": "4"
  },
  "solutions": [
    {
      "id": "sol.amc-12b-2012-p4.live",
      "kind": "proof-sketch",
      "text": "Étienne’s money is worth \\(400\\cdot1.30=520\\) dollars, while Diana has \\(500\\) dollars.\n\nThe percent by which Étienne’s value exceeds Diana’s is \\[\\frac{520-500}{500}\\cdot100\\%=4\\%.\\]\n\nThus, the correct answer is B.",
      "hints": [
        "Convert Étienne’s euros to dollars first",
        "The percent increase is \\(\\dfrac{\\text{Étienne} - \\text{Diana}}{\\text{Diana}}\\cdot100\\%\\)"
      ],
