    {
      "id": "sol.amc-10a-2006-p1.live",
      "kind": "proof-sketch",
      "text": "Five sandwiches cost \\(5 \\cdot 3 = 15\\) dollars and eight sodas cost \\(8 \\cdot 2 = 16\\) dollars. Together they cost \\(15 + 16 = 31\\) dollars.\n\nThus, the correct answer is A.",
      "hints": [
        "Find the sandwich total and the soda total separately",
        "Compute \\(5 \\cdot 3 + 8 \\cdot 2\\)"
