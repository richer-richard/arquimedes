  "solutions": [
    {
      "id": "sol.amc-10a-2018-p1.live",
      "kind": "proof-sketch",
      "text": "We can simplify this as follows. \\[ \\begin{aligned} &\\left(\\left((2+1)^{-1}+1\\right)^{-1}+1\\right)^{-1}+1 \\\\ &=\\left(\\left(\\dfrac{1}{3}+1\\right)^{-1}+1\\right)^{-1}+1 \\\\ &=\\left(\\dfrac{3}{4}+1\\right)^{-1}+1 \\\\ &=\\dfrac{4}{7} + 1 \\\\ &=\\dfrac{11}{7} \\end{aligned} \\]\n\nThus, B is the correct answer.",
      "hints": [
        "Work from the innermost reciprocal outward",
        "After each reciprocal step, simplify before adding the next \\(1\\)"
      ],
