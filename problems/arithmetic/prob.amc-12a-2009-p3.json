  "solutions": [
    {
      "id": "sol.amc-12a-2009-p3.live",
      "kind": "proof-sketch",
      "text": "The gap is \\(\\dfrac{3}{4} - \\dfrac{1}{4} = \\dfrac{1}{2}.\\) One third of the way adds \\(\\dfrac{1}{3} \\cdot \\dfrac{1}{2} = \\dfrac{1}{6}.\\)\n\nSo the number is \\(\\dfrac{1}{4} + \\dfrac{1}{6} = \\dfrac{3}{12} + \\dfrac{2}{12} = \\dfrac{5}{12}.\\)\n\nThus, the correct answer is B.",
      "hints": [
        "The distance from \\(\\dfrac{1}{4}\\) to \\(\\dfrac{3}{4}\\) is \\(\\dfrac{1}{2}\\)",
        "Add one third of that distance to \\(\\dfrac{1}{4}\\)"
      ],
      "images": []
    }
  ],
