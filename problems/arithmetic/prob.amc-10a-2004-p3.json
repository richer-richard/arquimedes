  "solutions": [
    {
      "id": "sol.amc-10a-2004-p3.live",
      "kind": "proof-sketch",
      "text": "Since $\\(20\\) equals \\(2000\\) cents, the local tax is \\[ 0.0145 \\times 2000 = 29 \\] cents per hour.\n\nThus, the correct answer is E.",
