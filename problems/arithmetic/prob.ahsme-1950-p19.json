    {
      "id": "sol.ahsme-1950-p19.live",
      "kind": "proof-sketch",
      "text": "The job requires \\(m\\cdot d=md\\) man-days. With \\(m+r\\) men working at the same individual rate, the required number of days is \\[ \\frac{md}{m+r}. \\]\n\nThus, the correct answer is C.",
      "hints": [
        "Measure the total job in man-days",
        "The original crew performs \\(md\\) man-days of work"
      ],
