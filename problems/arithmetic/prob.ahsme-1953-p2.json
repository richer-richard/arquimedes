  "estimatedMinutes": 1,
  "statement": "A refrigerator is offered for sale at \\(\\$250.00\\) less successive discounts of \\(20\\%\\) and \\(15\\%.\\) The sale price of the refrigerator is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(35\\%\\) less than \\(\\$250.00\\)"
    },
    {
      "label": "B",
      "text": "\\(65\\%\\) of \\(\\$250.00\\)"
    },
    {
      "label": "C",
      "text": "\\(77\\%\\) of \\(\\$250.00\\)"
    },
    {
      "label": "D",
      "text": "\\(68\\%\\) of \\(\\$250.00\\)"
    },
    {
      "label": "E",
      "text": "none of these"
    }
  ],
  "answer": {
    "letter": "d",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.ahsme-1953-p2.live",
      "kind": "proof-sketch",
      "text": "The two discounts leave \\[ (0.80)(0.85)=0.68 \\] of the original price. The sale price is therefore \\(68\\%\\) of \\(\\$250.00,\\) or \\(\\$170.00.\\)\n\nThus, the correct answer is D.",
      "hints": [
        "Apply each discount to the price remaining after the preceding discount",
        "Multiply the original price by \\((1-0.20)(1-0.15)\\)"
      ],
