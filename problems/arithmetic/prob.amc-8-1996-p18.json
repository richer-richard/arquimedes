  "solutions": [
    {
      "id": "sol.amc-8-1996-p18.live",
      "kind": "proof-sketch",
      "text": "After the raise, the salary is \\(2000 \\cdot 1.2 = 2400.\\)\n\nAfter the cut, it is \\(2400 \\cdot 0.8 = 1920.\\)\n\nThus, the correct answer is A .",
      "hints": [
        "A \\(20\\%\\) raise multiplies by \\(1.2;\\) a \\(20\\%\\) cut multiplies by \\(0.8\\)",
        "Apply both factors in turn: \\(2000 \\cdot 1.2 \\cdot 0.8\\)"
      ],
