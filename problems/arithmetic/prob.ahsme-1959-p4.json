  "solutions": [
    {
      "id": "sol.ahsme-1959-p4.live",
      "kind": "proof-sketch",
      "text": "Let the parts be \\(x,\\frac{x}{3},\\) and \\(\\frac{x}{6}.\\) Then \\[ x+\\frac x3+\\frac x6=\\frac32x=78, \\] so \\(x=52.\\) The middle part is \\[ \\frac{x}{3}=\\frac{52}{3}=17\\frac13. \\]\n\nThus, the correct answer is C.",
      "hints": [
        "Write the three parts as \\(x,\\frac{x}{3},\\frac{x}{6}\\)",
        "Their sum is \\(78\\)"
      ],
