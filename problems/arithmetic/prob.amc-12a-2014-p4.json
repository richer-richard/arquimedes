  "estimatedMinutes": 1,
  "statement": "Suppose that \\(a\\) cows give \\(b\\) gallons of milk in \\(c\\) days. At this rate, how many gallons of milk will \\(d\\) cows give in \\(e\\) days?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{bde}{ac}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{ac}{bde}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{abde}{c}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{bcde}{a}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{abc}{de}\\)"
    }
  ],
  "answer": {
    "letter": "a",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.amc-12a-2014-p4.live",
      "kind": "proof-sketch",
      "text": "The rate is \\(\\dfrac{b}{ac}\\) gallons per cow per day.\n\nSo \\(d\\) cows over \\(e\\) days produce \\(\\dfrac{b}{ac}\\cdot d\\cdot e=\\dfrac{bde}{ac}\\) gallons.\n\nThus, the correct answer is A.",
      "hints": [
        "Find how much milk one cow gives in one day",
        "One cow gives \\(\\dfrac{b}{ac}\\) gallons per day; scale by \\(d\\) cows and \\(e\\) days"
      ],
