  "estimatedMinutes": 1,
  "statement": "Each third-grade classroom at Pearl Creek Elementary has \\(18\\) students and \\(2\\) pet rabbits. How many more students than rabbits are there in all \\(4\\) of the third-grade classrooms?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(48\\)"
    },
    {
      "label": "B",
      "text": "\\(56\\)"
    },
    {
      "label": "C",
      "text": "\\(64\\)"
    },
    {
      "label": "D",
      "text": "\\(72\\)"
    },
    {
      "label": "E",
      "text": "\\(80\\)"
    }
  ],
  "answer": {
    "letter": "c",
    "value": "64"
  },
  "solutions": [
    {
      "id": "sol.amc-12b-2012-p1.live",
      "kind": "proof-sketch",
      "text": "Each classroom has \\(18-2=16\\) more students than rabbits.\n\nAcross all \\(4\\) classrooms there are \\(4\\cdot16=64\\) more students than rabbits.\n\nThus, the correct answer is C.",
      "hints": [
        "Each classroom has \\(18-2\\) more students than rabbits",
        "Multiply the per-classroom difference by \\(4\\)"
