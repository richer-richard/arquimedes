  "solutions": [
    {
      "id": "sol.amc-10-2000-p2.live",
      "kind": "proof-sketch",
      "text": "Write the factor \\(2000\\) as \\(2000^1.\\) Then \\[ \\begin{aligned} 2000^1 \\cdot 2000^{2000} &= 2000^{1 + 2000} \\\\ &= 2000^{2001}. \\end{aligned} \\]\n\nEach of the other options is larger than \\(2000^{2001}.\\)\n\nThus, the correct answer is A.",
      "hints": [
        "Write the leading \\(2000\\) as \\(2000^1\\)",
        "Multiplying powers with the same base adds the exponents"
      ],
