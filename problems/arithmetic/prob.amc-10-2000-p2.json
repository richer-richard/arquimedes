  "estimatedMinutes": 1,
  "statement": "Which of the following is equal to \\(2000 \\cdot 2000^{2000}?\\)",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(2000^{2001}\\)"
    },
    {
      "label": "B",
      "text": "\\(4000^{2000}\\)"
    },
    {
      "label": "C",
      "text": "\\(2000^{4000}\\)"
    },
    {
      "label": "D",
      "text": "\\(4{,}000{,}000^{2000}\\)"
    },
    {
      "label": "E",
      "text": "\\(2000^{4{,}000{,}000}\\)"
    }
  ],
