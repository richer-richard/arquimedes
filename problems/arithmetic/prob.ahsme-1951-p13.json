  "estimatedMinutes": 1,
  "statement": "\\(A\\) can do a piece of work in \\(9\\) days. \\(B\\) is \\(50\\%\\) more efficient than \\(A.\\) The number of days it takes \\(B\\) to do the same piece of work is:",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(13\\dfrac12\\)"
    },
    {
      "label": "B",
      "text": "\\(4\\dfrac12\\)"
    },
    {
      "label": "C",
      "text": "\\(6\\)"
    },
    {
      "label": "D",
      "text": "\\(3\\)"
    },
    {
      "label": "E",
      "text": "None of these answers"
    }
  ],
  "answer": {
    "letter": "c",
    "value": "6"
  },
  "solutions": [
    {
      "id": "sol.ahsme-1951-p13.live",
      "kind": "proof-sketch",
      "text": "\\(A\\)’s rate is \\(\\frac{1}{9}\\) job per day. Thus \\(B\\)’s rate is \\[ \\frac32\\cdot\\frac19=\\frac16 \\] job per day, so \\(B\\) needs \\(6\\) days.\n\nThus, the correct answer is C.",
      "hints": [
        "Translate days per job into jobs per day",
        "Multiply \\(A\\)’s rate \\(\\frac{1}{9}\\) by \\(1.5\\)"
      ],
