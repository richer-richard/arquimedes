  "solutions": [
    {
      "id": "sol.ahsme-1955-p10.live",
      "kind": "proof-sketch",
      "text": "The train moves for \\(\\frac{a}{40}\\) hours and is stopped for \\(\\frac{mn}{60}\\) hours. Hence the total time is \\[ \\frac a{40}+\\frac{mn}{60} =\\frac{3a+2mn}{120}. \\]\n\nThus, the correct answer is A.",
      "hints": [
        "The moving time is \\(\\frac{a}{40}\\) hours",
        "Convert the total stopping time \\(mn\\) from minutes to hours before adding"
      ],
