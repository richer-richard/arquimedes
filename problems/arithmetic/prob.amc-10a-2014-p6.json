  "estimatedMinutes": 1,
  "statement": "Suppose that \\(a\\) cows give \\(b\\) gallons of milk in \\(c\\) days. At this rate, how many gallons of milk will \\(d\\) cows give in \\(e\\) days?",
  "answerChoices": [
    {
      "label": "A",
      "text": "\\(\\dfrac{bde}{ac}\\)"
    },
    {
      "label": "B",
      "text": "\\(\\dfrac{ac}{bde}\\)"
    },
    {
      "label": "C",
      "text": "\\(\\dfrac{abde}{c}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\dfrac{bcde}{a}\\)"
    },
    {
      "label": "E",
      "text": "\\(\\dfrac{abc}{de}\\)"
    }
  ],
  "answer": {
    "letter": "a",
    "value": null
  },
  "solutions": [
    {
      "id": "sol.amc-10a-2014-p6.live",
      "kind": "proof-sketch",
      "text": "We have to multiply \\(b\\) by \\(\\dfrac{d}{a}\\) to account for the new number of cows.\n\nWe then have to multiply by \\(\\dfrac{e}{c}\\) to account for the new time that we have.\n\nThis gives us a final answer of \\[ b \\cdot \\dfrac{d}{a} \\cdot \\dfrac{e}{c} = \\dfrac{bde}{ac}. \\]\n\nThus, A is the correct answer.",
      "hints": [
        "Find the production rate per cow per day",
        "Scale by \\(d\\) cows and \\(e\\) days"
      ],
      "images": []
    }
  ],
